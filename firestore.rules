/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based and ownership-based security model for the MUBAS Community Hub.
 *
 * Data Structure:
 * - `/users/{userId}`: User profiles, accessible only to the user and admins.
 * - `/questions/{questionId}`: Community forum questions, readable by all, but updateable/deletable only by the author or an admin.
 * - `/questions/{questionId}/answers/{answerId}`: Answers to questions, readable by all, but updateable/deletable only by the author or an admin.
 * - `/knowledge_base_articles/{articleId}`: Knowledge base articles, readable by all, but createable/updateable/deletable only by admins.
 * - `/tags/{tagId}`: Tags for questions and articles, readable by all, but createable/updateable/deletable only by admins.
 * - `/users/{userId}/notifications/{notificationId}`: Notifications for users, accessible only to the user and admins.
 * - `/roles_admin/{uid}`: Indicates admin status. Document existence grants admin privileges.
 *
 * Key Security Decisions:
 * - Public Read Access: Questions, Answers, Knowledge Base Articles, and Tags are publicly readable.
 * - Admin Roles: Admin privileges are granted based on the existence of a document in the `/roles_admin/{uid}` collection.
 * - Ownership: Users can only modify their own profiles, questions, and answers.
 * - No User Listing: Listing of all users is not permitted for privacy reasons.
 *
 * Denormalization for Authorization:
 * - The `authorId` field is denormalized in `questions` and `answers` documents to simplify ownership checks without requiring additional reads.
 *
 * Structural Segregation:
 * - Private user data is stored under `/users/{userId}`, separate from public data like questions and articles.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requesting user is the owner of the document.
     * @param {string} userId - The user ID to compare against the request's auth UID.
     * @return {bool} True if the user is the owner, false otherwise.
     * @example isOwner("someUserId")
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the requesting user is an existing owner of the document.
     * @param {string} userId - The user ID to compare against the request's auth UID.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user has admin privileges by verifying the existence of a document in /roles_admin/{uid}.
     * @return {bool} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) If the user is creating their own profile (request.auth.uid == userId).
     * @allow (get, update, delete) If the user is the owner of the profile or an admin.
     * @deny (create) If the user is trying to create a profile for someone else.
     * @deny (update, delete) If the user is not the owner or an admin.
     * @principle Enforces user-ownership for profile management and admin override.
     */
    match /users/{userId} {
      // Anyone can read any user document.
      allow get: if true;

      // Only the user themselves can create their profile.
      allow create: if isOwner(userId);

      // Only the user themselves or an admin can update their profile.
      allow update: if isExistingOwner(userId) || isAdmin();

      // Only the user themselves or an admin can delete their profile.
      allow delete: if isExistingOwner(userId) || isAdmin();

      // No listing of all users.
      allow list: if false;
    }

    /**
     * @description Rules for /questions/{questionId} collection.
     * @path /questions/{questionId}
     * @allow (get, list) Anyone can read any question.
     * @allow (create) Any signed-in user can create a question, and authorId must match the request.auth.uid.
     * @allow (update, delete) Only the author of the question or an admin can modify or delete it.
     * @deny (update, delete) If the user is not the owner or an admin.
     * @principle Public read access with owner-only or admin-only writes.
     */
    match /questions/{questionId} {
      // Anyone can read any question.
      allow get, list: if true;

      // Any signed-in user can create a question.
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;

      // Only the author of the question or an admin can update it.
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();

      // Only the author of the question or an admin can delete it.
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Rules for /questions/{questionId}/answers/{answerId} subcollection.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) Anyone can read any answer to a question.
     * @allow (create) Any signed-in user can create an answer, and authorId must match the request.auth.uid.
     * @allow (update, delete) Only the author of the answer or an admin can modify or delete it.
     * @deny (update, delete) If the user is not the owner or an admin.
     * @principle Public read access with owner-only or admin-only writes, inheritance from parent.
     */
    match /questions/{questionId}/answers/{answerId} {
      // Anyone can read any answer to a question.
      allow get, list: if true;

      // Any signed-in user can create an answer.
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;

      // Only the author of the answer or an admin can update it.
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();

      // Only the author of the answer or an admin can delete it.
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Rules for /knowledge_base_articles/{articleId} collection.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) Anyone can read any article.
     * @allow (create, update, delete) Only admins can create, update, or delete articles.
     * @deny (create, update, delete) If the user is not an admin.
     * @principle Public read access with admin-only writes.
     */
    match /knowledge_base_articles/{articleId} {
      // Anyone can read any article.
      allow get, list: if true;

      // Only admins can create, update, or delete articles.
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for /tags/{tagId} collection.
     * @path /tags/{tagId}
     * @allow (get, list) Anyone can read any tag.
     * @allow (create, update, delete) Only admins can create, update, or delete tags.
     * @deny (create, update, delete) If the user is not an admin.
     * @principle Public read access with admin-only writes.
     */
    match /tags/{tagId} {
      // Anyone can read any tag.
      allow get, list: if true;

      // Only admins can create, update, or delete tags.
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for /users/{userId}/notifications/{notificationId} subcollection.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list) Only the user and admins can access these notifications.
     * @allow (create, update, delete) Only the user and admins can modify their own notifications.
     * @deny (create, update, delete) If the user is not the owner or an admin.
     * @principle Enforces user-ownership for notifications with admin override.
     */
    match /users/{userId}/notifications/{notificationId} {
      // Only the user and admins can access these notifications.
      allow get, list: if isOwner(userId) || isAdmin();

      // Only the user and admins can create, update, or delete their own notifications.
      allow create, update, delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for /roles_admin/{uid} collection.
     * @path /roles_admin/{uid}
     * @allow (get) Only admins can get roles.
     * @allow (create, update, delete) Only admins can create, update, or delete roles.
     * @deny (create, update, delete) If the user is not an admin.
     * @principle DBAC: Authorization based on document existence rather than content.
     */
    match /roles_admin/{uid} {
        allow get: if isAdmin();
        allow create, update, delete: if isAdmin();
        allow list: if false;
    }
  }
}