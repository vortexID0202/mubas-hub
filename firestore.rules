rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is an admin.
    // This checks for the existence of a document in the 'roles_admin' collection.
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    // USERS: Users can read their own profile and other public profiles.
    // They can only create their own profile and can only update their own profile.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if isAdmin(); // Only admins can delete user profiles.
    }
    
    // QUESTIONS: Any authenticated user can create a question.
    // They can only update or delete their own questions.
    match /questions/{questionId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid || isAdmin();
      
      // ANSWERS: Any authenticated user can add an answer.
      // They can only update or delete their own answers.
      match /answers/{answerId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update: if request.auth != null && resource.data.authorId == request.auth.uid;
        allow delete: if request.auth != null && resource.data.authorId == request.auth.uid || isAdmin();
      }
    }
    
    // KB_ARTICLES: A new, isolated collection for knowledge base content.
    // Any authenticated user can create an article. This bypasses previous rule complexities.
    match /kb_articles/{articleId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }
    
    // KNOWLEDGE BASE ARTICLES (Legacy): Read-only for now to prevent further errors.
    // We will migrate to the new kb_articles collection.
    match /knowledge_base_articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if false; // Disabled to force use of new collection
    }
    
    // LIVE UPDATES: Only admins can create, update or delete live updates.
    match /live_updates/{updateId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
    }

    // TAGS & ROLES: Read-only for all, writeable only by admin.
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /roles_admin/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
