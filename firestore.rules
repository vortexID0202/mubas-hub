/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control system for the MUBAS Community Hub.
 *
 * Core Philosophy:
 *  - Strict role-based access control. Users can only access their own data and admins have broad access.
 *  - Knowledge Base articles are publicly readable, but only admins can create/update/delete them.
 *  - Questions are publicly readable, but only authors and admins can update/delete.
 *  - Answers are publicly readable, but only authors and admins can update/delete.
 *  - User profiles and notifications are private and accessible only to the user and admins.
 *
 * Data Structure:
 *  - /users/{userId}: Stores user profiles.
 *  - /questions/{questionId}: Stores questions.
 *  - /questions/{questionId}/answers/{answerId}: Stores answers to questions.
 *  - /knowledge_base_articles/{articleId}: Stores knowledge base articles.
 *  - /tags/{tagId}: Stores tags.
 *  - /users/{userId}/notifications/{notificationId}: Stores user-specific notifications.
 *  - /roles_admin/{uid}: Used to grant admin privileges. The existence of a document at this path grants admin privileges.
 *
 * Key Security Decisions:
 *  - User listing is disallowed for privacy reasons.
 *  - Admin status is determined by the existence of a document in the `/roles_admin/{uid}` collection.
 *  - All write operations are explicitly secured with authorization checks.
 *
 * Denormalization for Authorization:
 *  - Questions and Answers include 'authorId' to avoid costly `get()` calls when checking ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Authentication is required for many operations.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user's ID matches the provided userId.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces ownership for user-specific data.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

     /**
      * @description Checks if the current user is an admin by verifying the existence of a document in the `/roles_admin/{uid}` collection.
      * @path N/A
      * @allow N/A
      * @deny N/A
      * @principle Implements role-based access control.
      */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the current user is the owner of the resource and if the resource exists.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Protects against modification of non-existent documents.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
   
    /**
     * @description Manages user profiles.
     * @path /users/{userId}
     * @allow (create) A user creating their own profile with matching user ID.
     * @allow (get, update, delete) An admin accessing or modifying any user profile.
     * @allow (get, update, delete) A user accessing or modifying their own profile.
     * @deny (create) A user creating a profile with a mismatched user ID.
     * @deny (get, update, delete) A user accessing or modifying another user's profile.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false; // Disallowing user listing for privacy.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Manages community forum questions.
     * @path /questions/{questionId}
     * @allow (get, list) Anyone reading questions.
     * @allow (create) Any authenticated user creating a question.
     * @allow (update, delete) The author of the question or an admin modifying it.
     * @deny (update, delete) A non-author attempting to modify a question.
     * @principle Allows public read access with owner-only writes and admin overrides.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if (resource.data.authorId == request.auth.uid && resource != null) || isAdmin();
      allow delete: if (resource.data.authorId == request.auth.uid && resource != null) || isAdmin();
    }

    /**
     * @description Manages answers to specific questions.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) Anyone reading answers to a question.
     * @allow (create) Any authenticated user creating an answer.
     * @allow (update, delete) The author of the answer or an admin modifying it.
     * @deny (update, delete) A non-author attempting to modify an answer.
     * @principle Allows public read access with owner-only writes and admin overrides, maintaining hierarchical data integrity.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if (resource.data.authorId == request.auth.uid && resource != null) || isAdmin();
      allow delete: if (resource.data.authorId == request.auth.uid && resource != null) || isAdmin();
    }

    /**
     * @description Manages knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) Anyone reading knowledge base articles.
     * @allow (create, update, delete) Only admins modifying articles.
     * @deny (create, update, delete) Non-admins attempting to modify articles.
     * @principle Restricts write access to admins while allowing public read access.
     */
    match /knowledge_base_articles/{articleId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages tags.
     * @path /tags/{tagId}
     * @allow (get, list) Anyone reading tags.
     * @allow (create, update, delete) Only admins modifying tags.
     * @deny (create, update, delete) Non-admins attempting to modify tags.
     * @principle Restricts write access to admins while allowing public read access.
     */
    match /tags/{tagId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages notifications for a specific user.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list) The user and admins can read notifications.
     * @allow (create) Any signed-in user can create a notification for themselves.
     * @allow (update, delete) The user and admins can update or delete notifications.
     * @deny (create) Users creating notifications for other users.
     * @deny (get, update, delete) Users accessing or modifying other user's notifications.
     * @principle Enforces document ownership and restricts access to user-specific data, with admin overrides.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if (isExistingOwner(userId) && resource.data.userId == userId) || isAdmin();
      allow delete: if (isExistingOwner(userId) && resource.data.userId == userId) || isAdmin();
    }

    /**
     * @description Manages admin roles. The existence of a document at this path grants admin privileges.
     * @path /roles_admin/{uid}
     * @allow (get) Anyone can check if a user is an admin.
     * @allow (create) Only admins can grant admin roles.
     * @allow (update, delete) Only admins can revoke admin roles.
     * @deny (create, update, delete) Non-admins attempting to modify admin roles.
     * @principle Implements role-based access control based on document existence.
     */
    match /roles_admin/{uid} {
        allow get: if isAdmin();
        allow list: if false;
        allow create: if isAdmin();
        allow update: if false;
        allow delete: if isAdmin() && resource != null;
    }
  }
}