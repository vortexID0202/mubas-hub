rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Function to check if a user is an administrator.
    // It verifies the existence of a document in the 'roles_admin' collection
    // where the document ID matches the user's UID.
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    // Users can read and write to their own profile.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Any authenticated user can create a question.
    // Only the author can update or delete their own question.
    // Any authenticated user can increment votes, views, or add to the upvotedBy array.
    match /questions/{questionId} {
      allow read;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
      allow update: if request.auth != null &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['votes', 'views', 'upvotedBy', 'answersCount']) &&
                      request.resource.data.votes == resource.data.votes + 1 &&
                      !((request.auth.uid) in resource.data.upvotedBy);
      allow update: if request.auth != null &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['views']) &&
                      request.resource.data.views == resource.data.views + 1;
    }
    
    // Rules for answers nested under questions.
    match /questions/{questionId}/answers/{answerId} {
      allow read;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
      allow update: if request.auth != null &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['votes', 'upvotedBy']) &&
                      request.resource.data.votes == resource.data.votes + 1 &&
                      !((request.auth.uid) in resource.data.upvotedBy);
    }
    
    // Only administrators can write to the knowledge base.
    // Anyone can read the articles.
    match /knowledge_base_articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Only administrators can write to live updates.
    // Anyone can read them.
    match /live_updates/{updateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admins can manage tags. Anyone can read them.
    match /tags/{tagId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Admin roles can only be managed from the server (or console).
    // No client should be able to write here.
    match /roles_admin/{userId} {
        allow read: if isAdmin();
        allow write: if false;
    }
  }
}
