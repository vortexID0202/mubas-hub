rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Correctly check for the user's UID in the roles_admin collection.
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth.uid == userId; // Users can only write to their own profile
    }

    match /questions/{questionId} {
      allow read: if true;
      // Users can create questions if they are logged in and are the author.
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      // Users can update their own questions.
      // Any authenticated user can increment views, or increment votes if they haven't voted before.
      allow update: if (request.auth.uid == resource.data.authorId) ||
                       (request.auth != null &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'votes', 'upvotedBy']) &&
                        (request.resource.data.views == resource.data.views + 1 ||
                         (request.resource.data.votes == resource.data.votes + 1 && !(request.auth.uid in resource.data.upvotedBy)))
                       );
      // Users can delete their own questions.
      allow delete: if request.auth.uid == resource.data.authorId;

      match /answers/{answerId} {
        allow read: if true;
        // Users can create answers if they are logged in and are the author.
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        // Users can update their own answers, or anyone can upvote.
        allow update: if request.auth.uid == resource.data.authorId ||
                         (request.auth != null &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'upvotedBy']) &&
                          request.resource.data.votes == resource.data.votes + 1 && !(request.auth.uid in resource.data.upvotedBy));
        // Users can delete their own answers.
        allow delete: if request.auth.uid == resource.data.authorId;
      }
    }

    // Admins have full write access to knowledge base articles.
    match /knowledge_base_articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins have full write access to live updates.
    match /live_updates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tags can be read by anyone, but only managed by admins.
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Admin roles can only be managed by other admins. This prevents users from making themselves admins.
    match /roles_admin/{userId} {
       allow read, write: if isAdmin();
    }
  }
}
