/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for personal data,
 *              allows public read access to forum content and knowledge base articles,
 *              and restricts administrative functions to authorized users.
 *
 * @data_structure
 *  - /users/{userId}: User profiles, accessible only to the user and admins.
 *  - /questions/{questionId}: Community forum questions, publicly readable but owner-editable.
 *  - /questions/{questionId}/answers/{answerId}: Answers to questions, publicly readable but owner-editable.
 *  - /knowledge_base_articles/{articleId}: Knowledge base articles, publicly readable, admin-editable.
 *  - /tags/{tagId}: Tags for questions and articles, admin-managed, publicly readable.
 *  - /users/{userId}/notifications/{notificationId}: User-specific notifications, accessible only to the user and admins.
 *  - /live_updates/{updateId}: Live updates and announcements, publicly readable, admin-editable.
 *
 * @key_security_decisions
 *  - User listing is disallowed.
 *  - Read-only access is granted to public collections like questions, answers, knowledge base articles, live updates, and tags.
 *  - Admin status is determined via custom claims.
 *  - Default security posture for ambiguous relationships is strict owner-only access.
 *
 * @denormalization_for_authorization
 *  - Questions and Answers include denormalized `authorId` to avoid expensive `get()` calls when checking ownership.
 *
 * @structural_segregation
 *  - User-specific notifications are stored in a private subcollection (`/users/{userId}/notifications/{notificationId}`) to ensure only the user and admins can access them.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profiles, allowing only the owner to read and write.
     * @path /users/{userId}
     * @allow (create, get, update, delete, list) if the request is made by the user with matching {userId}.
     * @deny (create, get, update, delete, list) if the request is made by a different user.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to community forum questions, allowing anyone to read, but only the author or an admin to update or delete.
     * @path /questions/{questionId}
     * @allow (get, list) Anyone can read questions.
     * @allow (create) The question must have the authorId set to the user's ID.
     * @allow (update, delete) Only the author or an admin can modify a question.
     * @deny (create, update, delete) if the request is not properly authenticated.
     * @principle Public read with owner-only writes, enforces ownership on writes.
     */
    match /questions/{questionId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(authorId) {
        return isSignedIn() && request.auth.uid == authorId;
      }
      function isAdmin() {
         return isSignedIn() && request.auth.token.admin == true;
      }
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if (isOwner(resource.data.authorId) && resource != null) || isAdmin();
      allow delete: if (isOwner(resource.data.authorId) && resource != null) || isAdmin();
    }

    /**
     * @description Controls access to answers for a specific question, allowing anyone to read, but only the author or an admin to update or delete.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) Anyone can read answers.
     * @allow (create) The answer must have the authorId set to the user's ID.
     * @allow (update, delete) Only the author or an admin can modify an answer.
     * @deny (create, update, delete) if the request is not properly authenticated.
     * @principle Public read with owner-only writes, enforces ownership on writes, hierarchical data.
     */
    match /questions/{questionId}/answers/{answerId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(authorId) {
        return isSignedIn() && request.auth.uid == authorId;
      }
      function isAdmin() {
         return isSignedIn() && request.auth.token.admin == true;
      }
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if (isOwner(resource.data.authorId) && resource != null) || isAdmin();
      allow delete: if (isOwner(resource.data.authorId) && resource != null) || isAdmin();
    }

    /**
     * @description Controls access to knowledge base articles, allowing anyone to read, but only admins to create, update, or delete.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) Anyone can read articles.
     * @allow (create, update, delete) Only admins can modify articles.
     * @deny (create, update, delete) if the request is not made by an admin.
     * @principle Public read, admin-only writes.
     */
    match /knowledge_base_articles/{articleId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isAdmin() {
         return isSignedIn() && request.auth.token.admin == true;
      }
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Controls access to live updates, allowing anyone to read, but only admins to create, update, or delete.
     * @path /live_updates/{updateId}
     * @allow (get, list) Anyone can read live updates.
     * @allow (create, update, delete) Only admins can modify live updates.
     * @deny (create, update, delete) if the request is not made by an admin.
     * @principle Public read, admin-only writes.
     */
    match /live_updates/{updateId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isAdmin() {
         return isSignedIn() && request.auth.token.admin == true;
      }
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Controls access to tags, allowing anyone to read, but only admins to create, update, or delete.
     * @path /tags/{tagId}
     * @allow (get, list) Anyone can read tags.
     * @allow (create, update, delete) Only admins can modify tags.
     * @deny (create, update, delete) if the request is not made by an admin.
     * @principle Public read, admin-only writes.
     */
    match /tags/{tagId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isAdmin() {
         return isSignedIn() && request.auth.token.admin == true;
      }
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Controls access to user-specific notifications, allowing only the user and admins to read and write.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list) if the request is made by the user with matching {userId} or an admin.
     * @allow (create, update, delete) if the request is made by the user with matching {userId} or an admin.
     * @deny (create, get, update, delete, list) if the request is made by a different user.
     * @principle Enforces document ownership for writes, admin override.
     */
    match /users/{userId}/notifications/{notificationId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }
      function isAdmin() {
         return isSignedIn() && request.auth.token.admin == true;
      }
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description DEPRECATED: Admin roles are now managed via custom claims. The existence of a document at this path previously granted admin privileges. This is kept for historical reference but is no longer the source of truth for admin status.
     * @path /roles_admin/{uid}
     */
    match /roles_admin/{uid} {
        allow get: if false;
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }
}