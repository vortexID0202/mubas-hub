/**
 * @fileoverview Firestore Security Rules for the MUBAS Community Hub.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and notifications,
 * and a public-read with owner-write model for questions, answers, knowledge base articles, and tags.
 * Administrative privileges are granted based on the existence of a document in the `/roles_admin/{uid}` collection.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the user and admins.
 * - /questions/{questionId}: Community forum questions, publicly readable, owner-only writable.
 * - /questions/{questionId}/answers/{answerId}: Answers to questions, publicly readable, owner-only writable.
 * - /knowledge_base_articles/{articleId}: Knowledge base articles, publicly readable, admin-only writable.
 * - /tags/{tagId}: Tags for questions and articles, publicly readable, admin-only writable.
 * - /users/{userId}/notifications/{notificationId}: User-specific notifications, accessible only to the user and admins.
 * - /roles_admin/{uid}: Marks a user as an admin.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect user privacy.
 * - Read-only access is granted to questions, answers, knowledge base articles, and tags.
 * - The default security posture for ambiguous relationships is strict owner-only access.
 * - Admin privileges are granted based on the existence of a document in `/roles_admin/{uid}`, rather than using custom claims.
 *
 * Denormalization for Authorization:
 * - Questions and Answers include denormalized `authorId` fields to enable simpler, more efficient authorization checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource.
     * @param {string} userId The user ID to check against.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner of the resource.
     * @param {string} userId The user ID to check against.
     * @return {bool} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && existsAfter(/databases/$(database)/documents/users/$(userId));
    }

    /**
     * @description Checks if the user is an admin.
     * @return {bool} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Enforces that the incoming document ID matches the path.
     * @param {string} documentId The document ID to check against.
     * @return {bool} True if the document ID matches the path, false otherwise.
     */
    function isValidDocumentId(documentId) {
        return request.resource.id == documentId;
    }

    /**
     * @description Checks if a resource contains the correct authorId
     * @param {string} authorId The authorId to check against.
     * @return {bool} True if resource contains the correct authorId, false otherwise.
     */
     function isResourceAuthor(authorId) {
        return resource.data.authorId == authorId;
    }
    /**
     * @description Checks if the user is the author of the resource.
     * @param {string} authorId The authorId to check against.
     * @return {bool} True if the user is the author, false otherwise.
     */
    function isAuthor(authorId) {
      return isSignedIn() && request.auth.uid == authorId;
    }

    /**
     * @description Checks if the user is an existing author of the resource.
     * @param {string} authorId The authorId to check against.
     * @return {bool} True if the user is the author and the resource exists, false otherwise.
     */
    function isExistingAuthor(authorId) {
        return isAuthor(authorId) && existsAfter(resource);
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) Signed-in user creates their own profile.
     * @allow (get, update, delete) Signed-in user accesses their own profile. Admin can access any user profile.
     * @deny (create) Non-signed-in user attempts to create a profile.
     * @deny (get, update, delete) Signed-in user attempts to access another user's profile.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree, validates relational integrity between documents.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false; // User listing is disallowed.
      allow create: if isOwner(userId) && isValidDocumentId(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for community forum questions.
     * @path /questions/{questionId}
     * @allow (get, list) Anyone can read questions.
     * @allow (create) Signed-in user creates a question with their ID as the authorId.
     * @allow (update, delete) Author of the question or admin can update/delete.
     * @deny (create) User attempts to create a question with a mismatched authorId.
     * @deny (update, delete) Non-author attempts to update/delete a question.
     * @principle Enforces document ownership for writes, restricts unauthorized modifications, and ensures data integrity.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthor(resource.data.authorId) || isAdmin();
      allow delete: if isAuthor(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Rules for answers to questions.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) Anyone can read answers to a question.
     * @allow (create) Signed-in user creates an answer with their ID as the authorId.
     * @allow (update, delete) Author of the answer or admin can update/delete.
     * @deny (create) User attempts to create an answer with a mismatched authorId or questionId.
     * @deny (update, delete) Non-author attempts to update/delete an answer.
     * @principle Enforces document ownership for writes, restricts unauthorized modifications, and ensures data integrity.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthor(resource.data.authorId) || isAdmin();
      allow delete: if isAuthor(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Rules for knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) Anyone can read knowledge base articles.
     * @allow (create, update, delete) Only admins can create, update, or delete articles.
     * @deny (create, update, delete) Non-admins attempt to create, update, or delete articles.
     * @principle Restricts write access to admins, allows public read access.
     */
    match /knowledge_base_articles/{articleId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for tags.
     * @path /tags/{tagId}
     * @allow (get, list) Anyone can read tags.
     * @allow (create, update, delete) Only admins can create, update, or delete tags.
     * @deny (create, update, delete) Non-admins attempt to create, update, or delete tags.
     * @principle Restricts write access to admins, allows public read access.
     */
    match /tags/{tagId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for user-specific notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list) Signed-in user accesses their own notifications. Admins can access any user's notifications.
     * @allow (create) Signed-in user creates a notification for themselves.
     * @allow (update, delete) Signed-in user updates/deletes their own notifications. Admins can update/delete any user's notifications.
     * @deny (create) User attempts to create a notification for another user.
     * @deny (get, update, delete) User attempts to access another user's notifications.
     * @principle Enforces document ownership, restricts access to a user's own data.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for admin roles.
     * @path /roles_admin/{uid}
     * @allow (get, create, update, delete) Only admins can create/modify admin roles.
     * @deny (get, create, update, delete) Non-admins attempt to create/modify admin roles.
     * @principle Database-Based Access Control (DBAC) for admin privileges.
     */
    match /roles_admin/{uid} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}