/**
 * @file Firestore Security Rules for MUBAS Community Hub
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model for personal data while allowing public read access to community content.  Administrative privileges are managed through a dedicated collection.
 * @data_structure User profiles and associated data (questions, notifications) are nested under `/users/{userId}`. Community content (questions, answers, categories, articles) resides in top-level collections. Administrative roles are determined by the existence of documents in the `/roles_admin/{userId}` collection.
 * @key_security_decisions
 *   - User listing is disallowed.
 *   - Public read access is granted to top-level collections containing community content.
 *   - Write access to community content is restricted to authorized users (e.g., owners, admins).
 *   - The data model relies on denormalized fields like `userId` to enforce ownership and relational integrity.
 * @denormalization_for_authorization Ownership of questions, answers, and notifications is enforced by matching the `userId` field in the document to the `userId` in the path.  This avoids costly `get()` calls.
 * @structural_segregation User-specific data (notifications) is stored in a private subcollection under `/users/{userId}`, while community content is stored in top-level collections, enabling different access control policies.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces ownership for user profiles. Only the user themselves can read or write their profile.
     * @path /users/{userId}
     * @allow (get, update, delete) if the user is signed in and their UID matches the userId. (e.g., request.auth.uid == userId)
     * @allow (create) if the user is signed in and their UID matches the userId. (e.g., request.auth.uid == userId)
     * @deny (get, update, delete) if the user is not signed in.
     * @deny (get, update, delete) if the user is signed in but their UID does not match the userId.
     * @deny (create) if the user is not signed in.
     * @deny (create) if the user is signed in but their UID does not match the userId.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
    }

    /**
     * @description Enforces ownership for questions created by a user.
     * @path /users/{userId}/questions/{questionId}
     * @allow (get, list) if the user is the owner.
     * @allow (create) if the user is signed in and the userId matches the path and the userId on the request
     * @allow (update, delete) if the user is the owner and the question exists.
     * @deny (create) if the userId does not match the path.
     * @deny (update, delete) if the question does not exist.
     * @principle Enforces user-owned questions and validates data consistency.
     */
    match /users/{userId}/questions/{questionId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && resource.data.userId == userId;
      allow delete: if isExistingOwner(userId) && resource.data.userId == userId;
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
    }

    /**
     * @description Allows public read access to answers while restricting write access to authenticated users.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) Public read access.
     * @allow (create) if the user is signed in and the question exists.
     * @allow (update, delete) if the user is signed in and the answer exists.
     * @deny (create) if the user is not signed in or the question does not exist.
     * @deny (update, delete) if the user is not signed in or the answer does not exist.
     * @principle Allows public reads, requires authentication for writes, and enforces relational integrity.
     */
    match /questions/{questionId}/answers/{answerId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows public read access to categories and requires authentication for write access.
     * @path /categories/{categoryId}
     * @allow (get, list) Public read access.
     * @allow (create, update, delete) Requires authentication.
     * @principle Allows public reads, requires authentication for writes.
     */
    match /categories/{categoryId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows public read access to knowledge base articles and requires authentication for write access.
     * @path /categories/{categoryId}/articles/{articleId}
     * @allow (get, list) Public read access.
     * @allow (create, update, delete) Requires authentication.
     * @principle Allows public reads, requires authentication for writes.
     */
    match /categories/{categoryId}/articles/{articleId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Enforces ownership for notifications. Only the user themselves can read or write their notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list) if the user is the owner.
     * @allow (create) if the user is the owner.
     * @allow (update, delete) if the user is the owner and the notification exists.
     * @deny (create) if the user is not the owner.
     * @deny (update, delete) if the notification does not exist.
     * @principle Enforces user-owned notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
    }

    /**
     * @description Admin privileges. Only the users who have admin rights can perform operations on these documents. Existence of document is enough to grant admin rights
     * @path /roles_admin/{userId}
     * @allow (get, list) if the user is an admin.
     * @allow (create) if the user is an admin.
     * @allow (update, delete) if the user is an admin.
     * @principle Enforces admin privileges
     */
    match /roles_admin/{userId} {
        function isAdmin() {
            return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
        }
        allow get: if isAdmin();
        allow list: if false;
        allow create: if isAdmin();
        allow update: if isAdmin() && resource != null;
        allow delete: if isAdmin() && resource != null;
    }
  }
}