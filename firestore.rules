/**
 * @file Firestore Security Rules for MUBAS Community Hub
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model for user-generated content
 * and restricts administrative content management to authorized users. Data validation is relaxed
 * in favor of rapid prototyping, focusing on authorization and relational integrity.
 *
 * @data_structure The database is structured with user-owned data nested under `/users/{userId}`
 * (questions, answers, notifications), and administrative data in a top-level `/knowledge_base_articles` collection.
 *
 * @key_security_decisions
 *   - User listing is implicitly allowed via `get` operations on individual user documents.
 *   - Write access to user-owned content is strictly limited to the owner.
 *   - Knowledge base articles are publicly readable but only writable by admins. (TODO: Implement admin role check.)
 *   - Data shape validation is minimal to allow for rapid iteration. Focus is on authorization.
 *
 * @denormalization_for_authorization The `users` documents contain the user's `role`, avoiding the need for separate role lookups.
 *
 * @structural_segregation User-generated content (questions, answers) is stored under the user's path, while admin-managed content (knowledge base articles) resides in a separate top-level collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and manage their own profiles.
     * @path /users/{userId}
     * @allow (get) Authenticated user can read their own profile.
     * @allow (create) Authenticated user can create their own profile if the userId matches their auth UID.
     * @allow (update) Authenticated user can update their own profile if the userId matches their auth UID.
     * @allow (delete) Authenticated user can delete their own profile if the userId matches their auth UID.
     * @deny (get) Authenticated user cannot read another user's profile.
     * @deny (create) Authenticated user cannot create a profile with a userId that does not match their auth UID.
     * @deny (update) Authenticated user cannot update another user's profile.
     * @deny (delete) Authenticated user cannot delete another user's profile.
     * @principle Enforces document ownership for writes and self-creation.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if true; // Anyone can read user profiles
      allow list: if false; // Prevent listing all users
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.id == userId; // Enforce immutability on user id
      allow delete: if isSignedIn() && isOwner(userId) && resource.data.id == userId; // Enforce immutability on user id
    }

    /**
     * @description Allows users to manage their own questions.
     * @path /users/{userId}/questions/{questionId}
     * @allow (get) Authenticated user can read their own question.
     * @allow (list) Authenticated user can list their own questions.
     * @allow (create) Authenticated user can create a question under their own user ID.
     * @allow (update) Authenticated user can update their own question under their own user ID.
     * @allow (delete) Authenticated user can delete their own question under their own user ID.
     * @deny (get) Authenticated user cannot read another user's question.
     * @deny (create) Authenticated user cannot create a question under another user's user ID.
     * @deny (update) Authenticated user cannot update another user's question.
     * @deny (delete) Authenticated user cannot delete another user's question.
     * @principle Enforces document ownership for writes within the user's data tree.
     */
    match /users/{userId}/questions/{questionId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.userId == userId; // enforce immutable userId
      allow delete: if isSignedIn() && isOwner(userId) && resource.data.userId == userId; // enforce immutable userId
    }

    /**
     * @description Allows users to manage their own answers.
     * @path /users/{userId}/answers/{answerId}
     * @allow (get) Authenticated user can read their own answer.
     * @allow (list) Authenticated user can list their own answers.
     * @allow (create) Authenticated user can create an answer under their own user ID.
     * @allow (update) Authenticated user can update their own answer under their own user ID.
     * @allow (delete) Authenticated user can delete their own answer under their own user ID.
     * @deny (get) Authenticated user cannot read another user's answer.
     * @deny (create) Authenticated user cannot create an answer under another user's user ID.
     * @deny (update) Authenticated user cannot update another user's answer.
     * @deny (delete) Authenticated user cannot delete another user's answer.
     * @principle Enforces document ownership for writes within the user's data tree.
     */
    match /users/{userId}/answers/{answerId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.userId == userId; // enforce immutable userId
      allow delete: if isSignedIn() && isOwner(userId) && resource.data.userId == userId; // enforce immutable userId
    }

    /**
     * @description Allows anyone to read Knowledge Base Articles, but only admins can create, update or delete them.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get) Any user can read a knowledge base article.
     * @allow (list) Any user can list knowledge base articles.
     * @deny (create) Only admins should be able to create knowledge base articles.
     * @deny (update) Only admins should be able to update knowledge base articles.
     * @deny (delete) Only admins should be able to delete knowledge base articles.
     * @principle Public read access with owner-only writes, restricted to admin role.
     */
    match /knowledge_base_articles/{articleId} {
      function isAdmin() {
          // TODO: Implement admin role check. This placeholder always returns false.
          return false;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin(); // TODO: Add admin validation once the schema is updated with an ownership field.
      allow update: if isAdmin() && resource != null; // TODO: Add admin validation once the schema is updated with an ownership field.
      allow delete: if isAdmin() && resource != null; // TODO: Add admin validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows users to manage their own notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get) Authenticated user can read their own notification.
     * @allow (list) Authenticated user can list their own notifications.
     * @allow (create) Authenticated user can create a notification under their own user ID.
     * @allow (update) Authenticated user can update their own notification under their own user ID.
     * @allow (delete) Authenticated user can delete their own notification under their own user ID.
     * @deny (get) Authenticated user cannot read another user's notification.
     * @deny (create) Authenticated user cannot create a notification under another user's user ID.
     * @deny (update) Authenticated user cannot update another user's notification.
     * @deny (delete) Authenticated user cannot delete another user's notification.
     * @principle Enforces document ownership for writes within the user's data tree.
     */
    match /users/{userId}/notifications/{notificationId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.userId == userId; // enforce immutable userId
      allow delete: if isSignedIn() && isOwner(userId) && resource.data.userId == userId; // enforce immutable userId
    }
  }
}