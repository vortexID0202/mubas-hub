/**
 * @fileOverview Firestore Security Rules for MUBAS Community Hub.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and notifications,
 * allows public read access to questions, answers, knowledge base articles, live updates, and tags,
 * and restricts administrative privileges for creating, updating, and deleting knowledge base articles, tags, and live updates.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles.
 * - /questions/{questionId}: Stores questions posted by users.
 * - /questions/{questionId}/answers/{answerId}: Stores answers to questions.
 * - /knowledge_base_articles/{articleId}: Stores knowledge base articles.
 * - /live_updates/{updateId}: Stores live updates and announcements.
 * - /tags/{tagId}: Stores tags for categorizing content.
 * - /users/{userId}/notifications/{notificationId}: Stores notifications for users.
 *
 * Key Security Decisions:
 * - User profiles and notifications are private and accessible only to the user and admins.
 * - Questions, answers, knowledge base articles, live updates, and tags are publicly readable.
 * - Only the author or an admin can update or delete questions and answers.
 * - Only admins can create, update, or delete knowledge base articles, tags, and live updates.
 * - Listing of documents is generally allowed for publicly readable collections. User specific collections are limited to the user in question.
 * - The deprecated `/roles_admin/{uid}` collection is ignored, and admin status is determined by custom claims.
 *
 * Denormalization for Authorization:
 * - Questions and answers include denormalized 'authorId' to simplify ownership checks.
 * - Answers also include denormalized 'questionId' to maintain the parent question relationship.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows access to user profiles, restricted to the user and admins.
     * @path /users/{userId}
     * @allow (get, list, update, delete) if the user is the owner or an admin.
     * @allow (create) if the authenticated user's ID matches the userId.
     * @deny (get, list, update, delete) if the user is not the owner or an admin.
     * @principle Enforces document ownership and admin override for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
        return request.auth.token.admin == true;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Allows public read access to questions, but restricts updates and deletes to the author or admins.
     * @path /questions/{questionId}
     * @allow (get, list) to everyone.
     * @allow (create) if the authorId matches the authenticated user's ID.
     * @allow (update, delete) if the user is the author or an admin.
     * @deny (update, delete) if the user is not the author or an admin.
     * @principle Enforces public read access with owner-only writes for questions.
     */
    match /questions/{questionId} {
        function isOwner(authorId) {
          return request.auth.uid == authorId;
        }

        function isAdmin() {
          return request.auth.token.admin == true;
        }

        function isExistingOwner(authorId) {
          return isOwner(authorId) && resource != null;
        }
        allow get: if true;
        allow list: if true;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
        allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Allows public read access to answers, but restricts updates and deletes to the author or admins.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) to everyone.
     * @allow (create) if the authorId matches the authenticated user's ID.
     * @allow (update, delete) if the user is the author or an admin.
     * @deny (update, delete) if the user is not the author or an admin.
     * @principle Enforces public read access with owner-only writes for answers.
     */
    match /questions/{questionId}/answers/{answerId} {
      function isOwner(authorId) {
        return request.auth.uid == authorId;
      }

      function isAdmin() {
        return request.auth.token.admin == true;
      }

      function isExistingOwner(authorId) {
        return isOwner(authorId) && resource != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Allows public read access to knowledge base articles, but restricts creation, updates, and deletes to admins only.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) to everyone.
     * @allow (create, update, delete) if the user is an admin.
     * @deny (create, update, delete) if the user is not an admin.
     * @principle Enforces admin-only writes for knowledge base articles.
     */
    match /knowledge_base_articles/{articleId} {
      function isAdmin() {
        return request.auth.token.admin == true;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows public read access to live updates, but restricts creation to admins only. Updates and deletes are not allowed.
     * @path /live_updates/{updateId}
     * @allow (get, list) to everyone.
     * @allow (create) if the user is an admin.
     * @deny (create) if the user is not an admin.
     * @principle Enforces public read access with admin-only creation for live updates.
     */
    match /live_updates/{updateId} {
        function isAdmin() {
          return request.auth.token.admin == true;
        }
        allow get: if true;
        allow list: if true;
        allow create: if isAdmin();
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Allows public read access to tags, but restricts creation, updates, and deletes to admins only.
     * @path /tags/{tagId}
     * @allow (get, list) to everyone.
     * @allow (create, update, delete) if the user is an admin.
     * @deny (create, update, delete) if the user is not an admin.
     * @principle Enforces admin-only writes for tags.
     */
    match /tags/{tagId} {
      function isAdmin() {
        return request.auth.token.admin == true;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows access to notifications, restricted to the user and admins.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list, update, delete) if the user is the owner or an admin.
     * @allow (create) if the authenticated user's ID matches the userId.
     * @deny (get, list, update, delete) if the user is not the owner or an admin.
     * @principle Enforces document ownership and admin override for notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
        return request.auth.token.admin == true;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description DEPRECATED: Admin roles are now managed via custom claims. This path is kept for historical reference but is no longer used.
     * @path /roles_admin/{uid}
     */
    match /roles_admin/{uid} {
        allow get: if false;
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }
}