/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control system for the MUBAS Community Hub, with a strong emphasis on user-ownership and admin privileges.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the user themselves and admins.
 * - /questions/{questionId}: Stores questions, publicly readable but writable only by the author and admins. The 'authorId' field is denormalized.
 * - /questions/{questionId}/answers/{answerId}: Stores answers, publicly readable but writable only by the author and admins. The 'authorId' and 'questionId' fields are denormalized.
 * - /knowledge_base_articles/{articleId}: Stores knowledge base articles, publicly readable but writable only by admins.
 * - /tags/{tagId}: Stores tags, publicly readable but writable only by admins.
 * - /users/{userId}/notifications/{notificationId}: Stores user-specific notifications, accessible only to the user themselves and admins.
 * - /roles_admin/{uid}: Indicates admin status. The existence of a document for a given UID grants admin privileges.
 *
 * Key Security Decisions:
 * - User data is strictly private, accessible only to the user and admins.
 * - Questions, answers, knowledge base articles, and tags are publicly readable to foster community engagement.
 * - Only admins can manage knowledge base articles and tags.
 * - Notifications are private and only accessible to the user and admins.
 * - Admin status is determined by the existence of a document in the `/roles_admin/{uid}` collection.
 * - Strict ownership is enforced for updates and deletes, preventing unauthorized data modification.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided user ID.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is an admin by verifying the existence of a document in the /roles_admin/{uid} collection.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the user is the owner of an existing document.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) - A user can create their own profile if the userId matches their auth UID.
     * @allow (get, list) - A user can read their own profile or an admin can read any profile.
     * @allow (update, delete) - A user can update or delete their own profile or an admin can update or delete any profile.
     * @deny (create) - A user cannot create a profile with a userId that doesn't match their auth UID.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;

      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for questions in the community forum.
     * @path /questions/{questionId}
     * @allow (get, list) - Anyone can read questions.
     * @allow (create) - A user can create a question if the authorId matches their auth UID.
     * @allow (update, delete) - Only the author of the question or an admin can update or delete it.
     * @deny (create) - A user cannot create a question with an authorId that doesn't match their auth UID.
     * @principle Enforces document ownership for writes while allowing public read access.
     */
    match /questions/{questionId} {
      allow get, list: if true;

      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && resource != null;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && resource != null;
    }

    /**
     * @description Rules for answers to questions in the community forum.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) - Anyone can read answers to a question.
     * @allow (create) - A user can create an answer if the authorId matches their auth UID. The questionId must match the parent question.
     * @allow (update, delete) - Only the author of the answer or an admin can update or delete it.
     * @deny (create) - A user cannot create an answer with an authorId that doesn't match their auth UID.
     * @principle Enforces document ownership for writes while allowing public read access. Validates relational integrity.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get, list: if true;

      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.questionId == questionId;
      allow update: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && resource != null;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && resource != null;
    }

    /**
     * @description Rules for knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) - Anyone can read knowledge base articles.
     * @allow (create, update, delete) - Only admins can create, update, or delete knowledge base articles.
     * @principle Restricts write access to admins while allowing public read access.
     */
    match /knowledge_base_articles/{articleId} {
      allow get, list: if true;

      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for tags.
     * @path /tags/{tagId}
     * @allow (get, list) - Anyone can read tags.
     * @allow (create, update, delete) - Only admins can create, update, or delete tags.
     * @principle Restricts write access to admins while allowing public read access.
     */
    match /tags/{tagId} {
      allow get, list: if true;

      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for user-specific notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get) - A user can read their own notifications or an admin can read any notification.
     * @allow (list) - A user can list their own notifications.
     * @allow (create) - A user or admin can create a notification for a user.
     * @allow (update, delete) - Only the user or an admin can update or delete the notification.
     * @deny (create) - A user cannot create a notification for a userId that doesn't match their auth UID, unless they are an admin.
     * @principle Enforces document ownership for writes and restricts access to a user's own notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId);

      allow create: if (isOwner(userId) || isAdmin()) && request.resource.data.userId == userId;
      allow update: if (isOwner(userId) || isAdmin()) && resource != null;
      allow delete: if (isOwner(userId) || isAdmin()) && resource != null;
    }

     /**
      * @description Rules for admin role management.
      * @path /roles_admin/{uid}
      * @allow (get, list) - Only admins can read the list of admin uids.
      * @allow (create) - Only admins can grant admin permissions
      * @allow (update, delete) - Only admins can revoke admin permissions.
      * @principle Database-Based Access Control (DBAC)
      */
     match /roles_admin/{uid} {
        allow get, list: if isAdmin();
        allow create: if isAdmin();
        allow update: if isAdmin() && resource != null;
        allow delete: if isAdmin() && resource != null;
     }
  }
}