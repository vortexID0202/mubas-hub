/**
 * @fileOverview Firestore Security Rules for MUBAS Community Hub.
 *
 * Core Philosophy:
 * This ruleset enforces a combination of user-ownership, role-based, and public-read/owner-write access control models.
 * User data is strictly private, accessible only to the user.  Admin roles are supported via document existence in a separate `/roles_admin/{uid}` collection.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, private to the user.
 * - /questions/{questionId}: Community forum questions, publicly readable, owner- or admin-writable.
 * - /questions/{questionId}/answers/{answerId}: Answers to questions, publicly readable, owner- or admin-writable.
 * - /knowledge_base_articles/{articleId}: Knowledge base articles, publicly readable, admin-only writable.
 * - /tags/{tagId}: Tags for questions and articles, publicly readable, admin-only writable.
 * - /users/{userId}/notifications/{notificationId}: User-specific notifications, private to the user.
 * - /roles_admin/{uid}: Indicates admin status. Document existence grants admin privileges.
 *
 * Key Security Decisions:
 * - Public read access is granted to questions, answers, knowledge base articles and tags.
 * - Listing of users is disallowed.
 * - Admin privileges are determined by the existence of a document in the `/roles_admin/{uid}` collection.
 *
 * Denormalization for Authorization:
 * - The `authorId` field is denormalized into the `questions` and `answers` collections to allow for fast, simple ownership checks without extra reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is from an authenticated user.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param {string} userId The user ID to compare against the authenticated user ID.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is an existing owner of the resource.
     * @param {string} userId The user ID to compare against the authenticated user ID.
     * @return {bool} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the authenticated user is an admin.
     * @return {bool} True if the user has admin privileges, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Defines read/write rules for user profiles.
     * @path /users/{userId}
     * @allow (get) Authenticated user reading their own profile.
     * @allow (create) Authenticated user creating their own profile.
     * @allow (update) Authenticated user updating their own profile.
     * @deny (get) Authenticated user reading another user's profile.
     * @deny (create) Authenticated user creating a profile with a different ID.
     * @deny (update) Authenticated user updating another user's profile.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if false; // User deletion should be handled via account management APIs.
    }

    /**
     * @description Defines read/write rules for community forum questions.
     * @path /questions/{questionId}
     * @allow (get) Anyone can read a question.
     * @allow (list) Anyone can list questions.
     * @allow (create) Authenticated user creating a question with their user ID as authorId.
     * @allow (update) Authenticated user updating their own question or an admin updating any question.
     * @allow (delete) Authenticated user deleting their own question or an admin deleting any question.
     * @deny (create) Authenticated user creating a question with a different user ID as authorId.
     * @deny (update) Authenticated user updating a question they don't own and are not an admin.
     * @deny (delete) Authenticated user deleting a question they don't own and are not an admin.
     * @principle Enforces public read access with owner- or admin-only writes.
     */
    match /questions/{questionId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Defines read/write rules for answers to questions.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get) Anyone can read an answer.
     * @allow (list) Anyone can list answers.
     * @allow (create) Authenticated user creating an answer with their user ID as authorId.
     * @allow (update) Authenticated user updating their own answer or an admin updating any answer.
     * @allow (delete) Authenticated user deleting their own answer or an admin deleting any answer.
     * @deny (create) Authenticated user creating an answer with a different user ID as authorId.
     * @deny (update) Authenticated user updating an answer they don't own and are not an admin.
     * @deny (delete) Authenticated user deleting an answer they don't own and are not an admin.
     * @principle Enforces public read access with owner- or admin-only writes, nested under questions.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Defines read/write rules for knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get) Anyone can read a knowledge base article.
     * @allow (list) Anyone can list knowledge base articles.
     * @allow (create) Only admins can create knowledge base articles.
     * @allow (update) Only admins can update knowledge base articles.
     * @allow (delete) Only admins can delete knowledge base articles.
     * @deny (create) Non-admin user trying to create a knowledge base article.
     * @deny (update) Non-admin user trying to update a knowledge base article.
     * @deny (delete) Non-admin user trying to delete a knowledge base article.
     * @principle Enforces admin-only writes with public read access.
     */
    match /knowledge_base_articles/{articleId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Defines read/write rules for tags.
     * @path /tags/{tagId}
     * @allow (get) Anyone can read a tag.
     * @allow (list) Anyone can list tags.
     * @allow (create) Only admins can create tags.
     * @allow (update) Only admins can update tags.
     * @allow (delete) Only admins can delete tags.
     * @deny (create) Non-admin user trying to create a tag.
     * @deny (update) Non-admin user trying to update a tag.
     * @deny (delete) Non-admin user trying to delete a tag.
     * @principle Enforces admin-only writes with public read access.
     */
    match /tags/{tagId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Defines read/write rules for user-specific notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get) Authenticated user reading their own notifications.
     * @allow (list) Authenticated user listing their own notifications.
     * @allow (create) Authenticated user creating a notification for themselves.
     * @allow (update) Authenticated user updating their own notification.
     * @allow (delete) Authenticated user deleting their own notification.
     * @deny (get) Authenticated user reading another user's notifications.
     * @deny (list) Authenticated user listing another user's notifications.
     * @deny (create) Authenticated user creating a notification for another user.
     * @deny (update) Authenticated user updating another user's notification.
     * @deny (delete) Authenticated user deleting another user's notification.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines read/write rules for admin role assignments.
     * @path /roles_admin/{uid}
     * @allow (get) Anyone can check if a user is an admin (used by the isAdmin() function).
     * @allow (create) Only admins can assign admin roles (create a role document).
     * @allow (update) Only admins can update admin roles.
     * @allow (delete) Only admins can revoke admin roles (delete a role document).
     * @deny (create) Non-admin user trying to assign an admin role.
     * @deny (update) Non-admin user trying to update an admin role.
     * @deny (delete) Non-admin user trying to revoke an admin role.
     * @principle Enforces admin-only management of admin roles.
     */
    match /roles_admin/{uid} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
  }
}