/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for private data,
 *              public read access for community content, and role-based access control for
 *              administrative functions.
 *
 * Data Structure:
 * - /users/{userId}: Stores private user profile data, accessible only to the user and admins.
 * - /questions/{questionId}: Stores community forum questions, publicly readable but writable only by the author or admins.
 * - /questions/{questionId}/answers/{answerId}: Stores answers to questions, publicly readable but writable only by the author or admins.
 * - /knowledge_base_articles/{articleId}: Stores knowledge base articles, publicly readable but writable only by admins.
 * - /tags/{tagId}: Stores tags for questions and articles, publicly readable but writable only by admins.
 * - /users/{userId}/notifications/{notificationId}: Stores user-specific notifications, accessible only to the user and admins.
 * - /roles_admin/{uid}: Marks a user as an admin. Document existence grants admin privileges.
 *
 * Key Security Decisions:
 * - User data is strictly private and requires authentication.
 * - Community content (questions, answers, articles, tags) is publicly readable.
 * - Administrative actions (creating/updating/deleting articles/tags) are restricted to admins.
 * - User listing is disabled for privacy.
 *
 * Denormalization for Authorization:
 * - The `questions` and `answers` collections denormalize the `authorId` to enable efficient ownership checks without additional reads.
 *
 * Structural Segregation:
 * - Private user data is stored under `/users/{userId}`, while public community content is stored in top-level collections (`/questions`, `/knowledge_base_articles`, `/tags`).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile: `request.auth.uid == 'user123'`
     * @allow (get, update, delete) Authenticated user with ID 'user123' can access their own profile.
     * @deny (get, update, delete) Authenticated user with ID 'user456' cannot access user 'user123' profile.
     * @principle Enforces document ownership for writes; authenticated access for reads.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to community forum questions.
     * @path /questions/{questionId}
     * @allow (get, list) Any user can read all questions.
     * @allow (create) Authenticated user with ID 'user123' can create a question with `authorId: 'user123'`.
     * @allow (update, delete) Authenticated user with ID 'user123' can update/delete their own question where `resource.data.authorId == 'user123'`.
     * @deny (update, delete) Authenticated user with ID 'user456' cannot update/delete question owned by 'user123'.
     * @principle Public read access with owner-only writes.
     */
    match /questions/{questionId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner() {
        return request.auth.uid == resource.data.authorId;
      }
      function isCreatingOwner() {
          return request.auth.uid == request.resource.data.authorId;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isCreatingOwner();
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }

    /**
     * @description Controls access to answers for specific questions.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) Any user can read all answers for a given question.
     * @allow (create) Authenticated user with ID 'user123' can create an answer with `authorId: 'user123'`.
     * @allow (update, delete) Authenticated user with ID 'user123' can update/delete their own answer where `resource.data.authorId == 'user123'`.
     * @deny (update, delete) Authenticated user with ID 'user456' cannot update/delete answer owned by 'user123'.
     * @principle Public read access with owner-only writes.
     */
    match /questions/{questionId}/answers/{answerId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner() {
        return request.auth.uid == resource.data.authorId;
      }
        function isCreatingOwner() {
          return request.auth.uid == request.resource.data.authorId;
        }

      allow get, list: if true;
      allow create: if isSignedIn() && isCreatingOwner();
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }

    /**
     * @description Controls access to knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) Any user can read knowledge base articles.
     * @deny (create, update, delete) Only admins can create, update, or delete knowledge base articles.
     * @principle Public read access with admin-only writes.
     */
    match /knowledge_base_articles/{articleId} {
      function isAdmin() {
          return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
       function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Controls access to tags.
     * @path /tags/{tagId}
     * @allow (get, list) Any user can read tags.
     * @deny (create, update, delete) Only admins can create, update, or delete tags.
     * @principle Public read access with admin-only writes.
     */
    match /tags/{tagId} {
      function isAdmin() {
          return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
       function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Controls access to user-specific notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get) Authenticated user with ID 'user123' can read their own notifications.
     * @allow (list) Authenticated user with ID 'user123' can list their own notifications.
     * @allow (create) Authenticated user with ID 'user123' can create notifications in their own path.
     * @allow (update, delete) Authenticated user with ID 'user123' can update/delete their own notifications.
     * @deny (get, list, update, delete) Authenticated user with ID 'user456' cannot access user 'user123' notifications.
     * @principle Enforces document ownership for notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Marks a user as an admin. The existence of a document at this path grants admin privileges.
     * @path /roles_admin/{uid}
     * @allow (create) Any authenticated user can create their admin role document; in production, this MUST be restricted.
     * @allow (get) Only the user being granted admin can read their own role document.
     * @allow (delete) Only the user being demoted can delete their own role document.
     * @deny (update) Admin roles should not be updated.
     * @principle DBAC: Database-Based Access Control. Authorization based on document existence.
     */
     match /roles_admin/{uid} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner(uid) {
          return request.auth.uid == uid;
        }

        allow get: if isSignedIn() && isOwner(uid);
        allow list: if false;
        allow create: if isSignedIn() && isOwner(uid);
        allow update: if false;
        allow delete: if isSignedIn() && isOwner(uid);
     }
  }
}