/**
 * @file Firebase Security Rules for MUBAS Community Hub
 *
 * @Core Philosophy
 * This ruleset enforces a user-ownership model for user-specific data and a role-based model for administrative data.
 * Public read access is granted for some collections, while write access is strictly controlled.
 *
 * @Data Structure
 * - `/users/{userId}`: User profiles, accessible only to the user themselves.
 * - `/questions/{questionId}`: Community forum questions, publicly readable, writable by the author.
 * - `/questions/{questionId}/answers/{answerId}`: Answers to questions, publicly readable, writable by the answer author.
 * - `/knowledge_base_articles/{articleId}`: Knowledge base articles, publicly readable, writable by admins only.
 * - `/tags/{tagId}`: Tags for questions and articles, publicly readable, writable by admins only.
 * - `/users/{userId}/notifications/{notificationId}`: User-specific notifications, accessible only to the user.
 * - `/roles_admin/{uid}`: Admin role assignments, managed by admins. Existence of a document grants admin role.
 *
 * @Key Security Decisions
 * - User listing is disallowed to protect user privacy.
 * - Admin roles are determined by the existence of a document in `/roles_admin/{uid}`.
 * - Public read access is granted only to collections explicitly intended for public consumption.
 * - Default security posture for ambiguous relationships is strict owner-only access.
 *
 * @Denormalization for Authorization
 * - Questions and Answers include `authorId` to allow simple ownership checks.
 *
 * @Structural Segregation
 * - Private user data (profiles, notifications) is stored under `/users/{userId}` for easy enforcement of user-specific access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

        /**
     * @description Checks if the authenticated user is the owner of the resource, and the resource exists.
     * Use this for update/delete operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is an admin.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) - If the user's ID matches the requested userId.
     * @allow (get, update, delete) - If the user is the owner (their ID matches the userId)
     * @deny (list) - Listing users is not allowed.
     * @deny (create) - If the user's ID does not match the requested userId.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for community forum questions.
     * @path /questions/{questionId}
     * @allow (get, list) - Anyone can read questions.
     * @allow (create) - If the authorId matches the user's ID.
     * @allow (update, delete) - If the user is the author of the question or an admin, and the question exists.
     * @deny (create) - If the authorId does not match the user's ID.
     * @principle Allows public read access, enforces ownership for writes, and admin override.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && resource != null;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && resource != null;
    }

    /**
     * @description Rules for answers to questions.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) - Anyone can read answers to a question.
     * @allow (create) - If the authorId matches the user's ID and the questionId matches the parent question.
     * @allow (update, delete) - If the user is the author of the answer or an admin, and the answer exists.
     * @deny (create) - If the authorId does not match the user's ID or the questionId does not match the parent question.
     * @principle Allows public read access, enforces ownership for writes, and admin override.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.questionId == questionId;
      allow update: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && resource != null;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && resource != null;
    }

    /**
     * @description Rules for knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) - Anyone can read knowledge base articles.
     * @allow (create, update, delete) - Only admins can create, update, or delete articles.
     * @deny (create, update, delete) - If the user is not an admin.
     * @principle Allows public read access, restricts writes to admins.
     */
    match /knowledge_base_articles/{articleId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Rules for tags.
     * @path /tags/{tagId}
     * @allow (get, list) - Anyone can read tags.
     * @allow (create, update, delete) - Only admins can create, update, or delete tags.
     * @deny (create, update, delete) - If the user is not an admin.
     * @principle Allows public read access, restricts writes to admins.
     */
    match /tags/{tagId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Rules for user-specific notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list) - If the user is the owner (their ID matches the userId) or an admin.
     * @allow (create) - If the user's ID matches the requested userId.
     * @allow (update, delete) - If the user is the owner (their ID matches the userId) or an admin, and the notification exists.
     * @deny (create) - If the user's ID does not match the requested userId.
     * @principle Enforces document ownership for notifications, allows admin override.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get, list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && resource != null;
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin()) && resource != null;
    }

        /**
     * @description Rules for admin role assignment.
     * @path /roles_admin/{uid}
     * @allow (get) - If the user is an admin.
     * @allow (create) - If the user is an admin.
     * @allow (update) - If the user is an admin.
     * @allow (delete) - If the user is an admin.
     * @deny (list) - Listing admin roles is not allowed.
     * @principle Enforces admin-only access for role management.
     */
    match /roles_admin/{uid} {
          allow get: if isSignedIn() && isAdmin();
          allow list: if false;
          allow create: if isSignedIn() && isAdmin();
          allow update: if isSignedIn() && isAdmin();
          allow delete: if isSignedIn() && isAdmin();
    }
  }
}