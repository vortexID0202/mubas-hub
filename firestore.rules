
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check for admin role
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // QUESTIONS
    match /questions/{questionId} {
      // Anyone can read questions
      allow read: if true;

      // Only authenticated users can create questions
      allow create: if request.auth != null;

      // Allow users to update specific fields like votes, upvotedBy, and views
      allow update: if request.auth != null && (
        (
          // Rule for voting and view counts
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['votes', 'upvotedBy', 'views']) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'body', 'authorId', 'tags', 'createdAt'])) &&
          (request.auth.uid in request.resource.data.upvotedBy && !(request.auth.uid in resource.data.upvotedBy)) || // Can only add self to upvotedBy
          (request.resource.data.votes == resource.data.votes + 1) || // Can only increment votes by 1
          (request.resource.data.views == resource.data.views + 1) // Can only increment views by 1
        ) ||
        // Admins and authors can update other fields
        (
          (request.auth.uid == resource.data.authorId || isAdmin())
        )
      );

      // Only the author or an admin can delete a question
      allow delete: if request.auth != null && (request.auth.uid == resource.data.authorId || isAdmin());
      
      // ANSWERS SUBCOLLECTION
      match /answers/{answerId} {
        // Anyone can read answers
        allow read: if true;
        
        // Any authenticated user can create an answer
        allow create: if request.auth != null;
        
        // Only the author or an admin can update/delete
        allow update, delete: if request.auth != null && (request.auth.uid == resource.data.authorId || isAdmin());
      }
    }

    // KNOWLEDGE BASE
    match /knowledge_base_articles/{articleId} {
        // Everyone can read
        allow read: if true;
        // Only admins can write/update/delete
        allow write: if isAdmin();
    }
    
    // LIVE UPDATES
    match /live_updates/{updateId} {
        // Everyone can read
        allow read: if true;
        // Only admins can write/update/delete
        allow write: if isAdmin();
    }

    // USERS
    match /users/{userId} {
      // Users can read their own profile, admins can read any
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Users can create their own profile upon signup
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Users can update their own profile, admins can update any
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Only admins can delete user profiles
      allow delete: if isAdmin();
    }
    
    // ADMINS
    match /roles_admin/{userId} {
        // Only admins can see who else is an admin
        allow read: if isAdmin();
        // Writing/deleting admin roles should be done with server-side logic
        allow write: if false; 
    }
  }
}
