/**
 * @fileoverview Firestore Security Rules for MUBAS Community Hub.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-generated content
 * (questions, answers, notifications) and restricts administrative access to
 * knowledge base articles. User roles are denormalized onto user documents
 * to avoid costly `get()` calls during authorization.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, roles (student, admin), and other
 *   user-specific information.
 * - /users/{userId}/questions/{questionId}: Stores questions posted by a user.
 * - /users/{userId}/answers/{answerId}: Stores answers posted by a user.
 * - /knowledge_base_articles/{articleId}: Stores knowledge base articles,
 *   accessible to all for reading, but only modifiable by admins.
 * - /users/{userId}/notifications/{notificationId}: Stores notifications for a specific user.
 *
 * Key Security Decisions:
 * - Users can only read and write their own user documents and content under
 *   their user ID.
 * - Listing questions, answers, and notifications is restricted to the owner.
 * - Knowledge base articles are publicly readable but only modifiable by admins.
 *
 * Denormalization for Authorization:
 * - User roles are stored directly in the user document to avoid additional
 *   reads during authorization checks.
 *
 * Structural Segregation:
 * - Knowledge base articles are stored in a separate collection to allow
 *   distinct security rules for admin-managed content versus user-generated
 *   content.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided user ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is an existing owner of the document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) - A user can create their own profile if the userId matches their auth.uid.
     * @allow (get, update, delete) - A user can get, update, or delete their own profile.
     * @deny (create) - A user cannot create a profile for another user.
     * @deny (update) - A user cannot update another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // disable listing all users

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for questions posted by a user.
     * @path /users/{userId}/questions/{questionId}
     * @allow (create) - A user can create a question under their own user ID.
     * @allow (get, list) - A user can get and list questions under their own user ID.
     * @allow (update, delete) - A user can update or delete questions under their own user ID.
     * @deny (create) - A user cannot create a question under another user's ID.
     * @deny (update) - A user cannot update another user's question.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/questions/{questionId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for answers posted by a user.
     * @path /users/{userId}/answers/{answerId}
     * @allow (create) - A user can create an answer under their own user ID.
     * @allow (get, list) - A user can get and list answers under their own user ID.
     * @allow (update, delete) - A user can update or delete answers under their own user ID.
     * @deny (create) - A user cannot create an answer under another user's ID.
     * @deny (update) - A user cannot update another user's answer.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/answers/{answerId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) - All users can read knowledge base articles.
     * @deny (create, update, delete) - Only admins can create, update, or delete knowledge base articles.
     * @principle Restricts write access to admins only.
     */
    match /knowledge_base_articles/{articleId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add admin role check
    }

    /**
     * @description Rules for notifications for a specific user.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (create) - A user can create a notification under their own user ID (e.g., when a question they asked is answered).
     * @allow (get, list) - A user can get and list notifications under their own user ID.
     * @allow (update, delete) - A user can update or delete notifications under their own user ID.
     * @deny (create) - A user cannot create a notification under another user's ID.
     * @deny (update) - A user cannot update another user's notification.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
    
    /**
     * @description Prevents unauthorized listing of the 'questions' collection.
     * @path /questions
     * @deny (list) -  No unowned 'questions' listing allowed. Questions must be listed under the user to ensure data privacy and security.
     * @principle Secure list operations using path-based authorization
     */
    match /questions {
        allow get: if false;
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }
}