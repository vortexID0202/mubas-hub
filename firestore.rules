/**
 * @fileoverview Firestore Security Rules for MUBAS Community Hub.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-generated content
 * (questions, answers, notifications) and restricts administrative access to
 * knowledge base articles. User roles are denormalized onto user documents
 * to avoid costly `get()` calls during authorization.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, including roles for authorization.
 * - /users/{userId}/questions/{questionId}: Stores questions created by a specific user.
 * - /users/{userId}/answers/{answerId}: Stores answers created by a specific user.
 * - /knowledge_base_articles/{articleId}: Stores knowledge base articles, accessible to all but manageable only by admins.
 * - /users/{userId}/notifications/{notificationId}: Stores notifications for a specific user.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete their own questions, answers, and notifications.
 * - Knowledge base articles are publicly readable but only modifiable by admins (no admin role is defined, assuming this check happens in application code).
 * - Listing operations are generally allowed for user-owned subcollections.
 *
 * Denormalization for Authorization:
 * - User roles (e.g., 'student', 'admin') are stored directly within the `/users/{userId}` document to avoid `get()` calls when checking admin privileges.
 *
 * Structural Segregation:
 * - Knowledge base articles are stored in a separate top-level collection to allow for distinct security rules compared to user-generated content.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure access to user profiles.
     * @path /users/{userId}
     * @allow (create) - User can create their own profile if the userId matches their auth.uid.
     * @allow (get, update, delete) - User can only access their own profile.
     * @deny (create) - User cannot create a profile with an ID that doesn't match their auth.uid.
     * @deny (update, delete) - User cannot modify or delete another user's profile.
     * @principle Enforces user ownership and self-creation for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.id == userId;
      allow delete: if isSignedIn() && isOwner(userId) && resource.data.id == userId;
    }

    /**
     * @description Secure questions posted by a user.
     * @path /users/{userId}/questions/{questionId}
     * @allow (create) - User can create a question under their own user ID.
     * @allow (get, list, update, delete) - User can only access their own questions.
     * @deny (create) - User cannot create a question under another user's ID.
     * @deny (update, delete) - User cannot modify or delete another user's questions.
     * @principle Enforces document ownership for user-generated content.
     */
    match /users/{userId}/questions/{questionId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.userId == userId;
      allow delete: if isSignedIn() && isOwner(userId) && resource.data.userId == userId;
    }

    /**
     * @description Secure answers posted by a user.
     * @path /users/{userId}/answers/{answerId}
     * @allow (create) - User can create an answer under their own user ID.
     * @allow (get, list, update, delete) - User can only access their own answers.
     * @deny (create) - User cannot create an answer under another user's ID.
     * @deny (update, delete) - User cannot modify or delete another user's answers.
     * @principle Enforces document ownership for user-generated content.
     */
    match /users/{userId}/answers/{answerId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.userId == userId;
      allow delete: if isSignedIn() && isOwner(userId) && resource.data.userId == userId;
    }

    /**
     * @description Secure knowledge base articles, allowing public read but restricting write access to admins.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) - Any user can read knowledge base articles.
     * @allow (create, update, delete) - Only admins can manage knowledge base articles (admin check is a placeholder).
     * @deny (create, update, delete) - Non-admins cannot manage knowledge base articles.
     * @principle Enforces role-based access control for admin-managed content.
     */
    match /knowledge_base_articles/{articleId} {
      function isAdmin() {
        // TODO: Replace with actual admin check (e.g., check user role in /users/{userId}).
        return false;
      }

      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Secure notifications for a specific user.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (create) - User can create a notification under their own user ID.
     * @allow (get, list, update, delete) - User can only access their own notifications.
     * @deny (create) - User cannot create a notification under another user's ID.
     * @deny (update, delete) - User cannot modify or delete another user's notifications.
     * @principle Enforces document ownership for user-specific notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.userId == userId;
      allow delete: if isSignedIn() && isOwner(userId) && resource.data.userId == userId;
    }

     /**
      * @description Allow read-only access to the /questions collection for all users.
      * @path /questions
      * @allow (get, list) - Allow all users to read the collection of questions.
      * @deny (create, update, delete) - No user can write to the root questions collection.
      * @principle Public read access with no write access.
      */
    match /questions {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}