rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isDocumentOwner(doc) {
      return request.auth.uid == doc.data.authorId;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isUserAuthenticated();
      allow write: if isUserAuthenticated() && request.auth.uid == userId;
    }

    match /questions/{questionId} {
      allow read: if true;
      allow create: if isUserAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isUserAuthenticated() && isDocumentOwner(resource);
    }

    match /questions/{questionId}/answers/{answerId} {
        allow read: if true;
        allow create: if isUserAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isUserAuthenticated() && isDocumentOwner(resource);
    }
    
    match /kb_articles/{document} {
      allow read, write: if request.auth != null;
    }

    match /knowledge_base_articles/{document} {
      allow read, write: if request.auth != null;
    }

    match /tags/{tagId} {
        allow read: if true;
        allow write: if isAdmin();
    }
    
    match /live_updates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}