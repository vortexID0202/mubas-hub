/**
 * @file Firebase Security Rules for MUBAS Community Hub.
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model for user-specific data,
 *   allows public read access to questions, answers, knowledge base articles, and tags,
 *   and restricts write access based on user roles (admin) or document ownership.
 *   It follows the principle of least privilege, granting only the necessary permissions
 *   to each user based on their role and the data they own.
 *
 * @data_structure The data is organized hierarchically with user data under `/users/{userId}`,
 *   questions under `/questions/{questionId}`, answers nested under `/questions/{questionId}/answers/{answerId}`,
 *   knowledge base articles under `/knowledge_base_articles/{articleId}`, tags under `/tags/{tagId}`,
 *   user-specific notifications under `/users/{userId}/notifications/{notificationId}`,
 *   and admin roles managed in `/roles_admin/{uid}`.
 *
 * @key_security_decisions
 *   - User listing is disabled to protect user privacy.
 *   - Admin privileges are determined by the existence of a document in `/roles_admin/{uid}`.
 *   - Write access to questions and answers is restricted to the author.
 *   - Knowledge base articles and tags are read publicly, but can only be created, updated, or deleted by admins.
 *   - Notifications are private and accessible only to the user and admins.
 *   - Missing ownership fields on key entities must be reported rather than defaulting to insecure rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user's ID matches the provided user ID.
     * @param {string} userId The user ID to compare against the current user's ID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is an existing owner of the document.
     * @param {string} userId The user ID to compare against the document's owner ID.
     * @return {boolean} True if the user is the existing owner, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the current user is an admin.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     *   Request: auth.uid = 'user123', resource.data.id = 'user123'
     * @deny (create) User with ID 'user123' cannot create a profile for 'user456'.
     *   Request: auth.uid = 'user123', resource.data.id = 'user456'
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for community forum questions.
     * @path /questions/{questionId}
     * @allow (get) Any user can read a question.
     *   Request: No auth needed.
     * @allow (create) User with ID 'user123' can create a question.
     *   Request: auth.uid = 'user123', resource.data.authorId = 'user123'
     * @deny (create) User with ID 'user123' cannot create a question for 'user456'.
     *   Request: auth.uid = 'user123', resource.data.authorId = 'user456'
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /questions/{questionId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Rules for answers to questions.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get) Any user can read an answer to a question.
     *   Request: No auth needed.
     * @allow (create) User with ID 'user123' can create an answer to a question.
     *   Request: auth.uid = 'user123', resource.data.authorId = 'user123'
     * @deny (create) User with ID 'user123' cannot create an answer for 'user456'.
     *   Request: auth.uid = 'user123', resource.data.authorId = 'user456'
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Rules for knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get) Any user can read a knowledge base article.
     *   Request: No auth needed.
     * @allow (create) Admin user can create a knowledge base article.
     *   Request: User is authenticated as an admin (has a document in /roles_admin/{uid}).
     * @deny (create) Non-admin user cannot create a knowledge base article.
     *   Request: User is not authenticated as an admin.
     * @principle Enforces admin-only writes, allows public reads.
     */
    match /knowledge_base_articles/{articleId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for tags.
     * @path /tags/{tagId}
     * @allow (get) Any user can read a tag.
     *   Request: No auth needed.
     * @allow (create) Admin user can create a tag.
     *   Request: User is authenticated as an admin (has a document in /roles_admin/{uid}).
     * @deny (create) Non-admin user cannot create a tag.
     *   Request: User is not authenticated as an admin.
     * @principle Enforces admin-only writes, allows public reads.
     */
    match /tags/{tagId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for user-specific notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get) User with ID 'user123' can read their own notification.
     *   Request: auth.uid = 'user123'
     * @deny (get) User with ID 'user123' cannot read notification of 'user456'.
     *   Request: auth.uid = 'user123', userId = 'user456'
     * @principle Enforces document ownership for reads and writes.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if (isOwner(userId) || isAdmin());
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == userId;
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for admin roles.
     * @path /roles_admin/{uid}
     * @allow (create) Any user can be added as admin by script, or cloud function.
     * @principle Existence of a document grants admin privileges.
     */
     match /roles_admin/{uid} {
        allow get: if isAdmin();
        allow list: if false;
        allow create: if false; // Only server can perform this action.
        allow update: if false;
        allow delete: if false;
     }
  }
}