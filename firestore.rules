rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the current user is an admin.
    // It checks for the existence of a document in the 'admins' collection
    // with the user's UID as the document ID.
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Rules for the 'admins' collection itself.
    // Only authenticated users can read their own admin status document.
    // No one can list all admins or write to the collection from the client.
    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, write: if false;
    }

    // Rules for user profiles.
    // Users can read any profile, but can only create or update their own.
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if isAdmin(); // Only admins can delete user profiles
    }

    // Rules for knowledge base articles.
    // Anyone can read, but only admins can write (create, update, delete).
    match /knowledge_base_articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Rules for live updates.
    // Anyone can read, but only admins can write.
    match /live_updates/{updateId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Rules for community questions.
    match /questions/{questionId} {
      // Anyone can read questions.
      allow read: if true;

      // Authenticated users can create questions if they are the author.
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      
      // Users can update votes and views, or if they are the author, they can edit their question. Admins can also edit.
      allow update: if request.auth != null || isAdmin();

      // Only the author or an admin can delete a question.
      allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isAdmin());

      // Rules for answers within a question.
      match /answers/{answerId} {
        // Anyone can read answers.
        allow read: if true;

        // Authenticated users can create answers.
        allow create: if request.auth != null;
        
        // Authenticated users can upvote, or authors/admins can edit.
        allow update: if request.auth != null || isAdmin();

        // Only the author or an admin can delete an answer.
        allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }
    
    // Deny all other reads/writes by default
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
