/**
 * @description This ruleset enforces a strict user-ownership model for user profiles and notifications,
 *              and an admin-controlled model for knowledge base articles, live updates, tags, and logs.
 *              Questions and answers are publicly readable but only editable by their authors or admins.
 * @dataStructure
 *   - /users/{userId}: User profiles, accessible only to the user and admins.
 *   - /questions/{questionId}: Community forum questions, publicly readable, editable by author/admin.
 *   - /questions/{questionId}/answers/{answerId}: Answers to questions, publicly readable, editable by author/admin.
 *   - /knowledge_base_articles/{articleId}: Knowledge base articles, publicly readable, editable by admins only.
 *   - /live_updates/{updateId}: Live updates and announcements, publicly readable, editable by admins only.
 *   - /tags/{tagId}: Tags for questions/articles, publicly readable, editable by admins only.
 *   - /users/{userId}/notifications/{notificationId}: User-specific notifications, accessible only to the user and admins.
 *   - /logs/{logId}: System logs, accessible only to admins.
 * @keySecurityDecisions
 *   - User listing is disabled to prevent data harvesting.
 *   - All write operations require authentication.
 *   - Data validation is relaxed for prototyping, focusing on authorization and relational integrity.
 *   - Denormalization: Questions and answers include `authorId` to avoid costly `get()` calls.
 * @denormalizationForAuthorization
 *   - Questions and Answers include `authorId` to enable `isOwner(resource.data.authorId)` rules, avoiding extra reads.
 * @structuralSegregation
 *   - Private user data (profiles, notifications) is stored under /users/{userId} to ensure ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles. Only the user and admins can read/write their own profile.
     * @path /users/{userId}
     * @allow (create) - User with ID 'user123' creates their profile. (auth.uid == 'user123')
     * @allow (get, update, delete) - User with ID 'user123' reads, updates, or deletes their profile. (auth.uid == 'user123')
     * @allow (get, list) - Admin user reads any user profile. (auth.token.admin == true)
     * @deny (create) - User with ID 'user456' attempts to create a profile for 'user123'. (auth.uid == 'user456', request.resource.data.id == 'user123')
     * @deny (update) - User with ID 'user456' attempts to update profile 'user123'. (auth.uid == 'user456')
     * @principle Enforces document ownership and admin override.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isAdmin() {
        return request.auth != null && request.auth.token.admin == true;
      }

      allow get: if isOwner(userId) || isAdmin();
      allow list: if false; // User listing is disabled.

      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && resource.data.id == userId || isAdmin();
      allow delete: if isOwner(userId) && resource.data.id == userId && resource != null || isAdmin();
    }

    /**
     * @description Controls access to community forum questions.
     *              Anyone can read questions. Only the author or an admin can create, update, or delete them.
     * @path /questions/{questionId}
     * @allow (get, list) - Any user can read or list questions.
     * @allow (create) - User with ID 'user123' creates a question. (auth.uid == 'user123', request.resource.data.authorId == 'user123')
     * @allow (update, delete) - User with ID 'user123' updates or deletes their own question. (auth.uid == 'user123', resource.data.authorId == 'user123')
     * @allow (update, delete) - Admin user updates or deletes any question. (auth.token.admin == true)
     * @deny (create) - User with ID 'user456' attempts to create a question with authorId 'user123'.
     * @deny (update, delete) - User with ID 'user456' attempts to update/delete a question authored by 'user123'.
     * @principle Public read, owner-only write, admin override.
     */
    match /questions/{questionId} {
      function isOwner(authorId) {
        return request.auth != null && request.auth.uid == authorId;
      }

      function isAdmin() {
        return request.auth != null && request.auth.token.admin == true;
      }

      allow get, list: if true;

      allow create: if request.auth != null && isOwner(request.resource.data.authorId) && request.resource.data.authorId == request.auth.uid;
      allow update: if (isOwner(resource.data.authorId) && resource != null) || isAdmin();
      allow delete: if (isOwner(resource.data.authorId) && resource != null) || isAdmin();
    }

    /**
     * @description Controls access to answers for specific questions.
     *              Anyone can read answers to a question.
     *              Only the author of the answer or an admin can update or delete it.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) - Any user can read or list answers to a question.
     * @allow (create) - User with ID 'user123' creates an answer. (auth.uid == 'user123', request.resource.data.authorId == 'user123')
     * @allow (update, delete) - User with ID 'user123' updates or deletes their own answer. (auth.uid == 'user123', resource.data.authorId == 'user123')
     * @allow (update, delete) - Admin user updates or deletes any answer. (auth.token.admin == true)
     * @deny (create) - User with ID 'user456' attempts to create an answer with authorId 'user123'.
     * @deny (update, delete) - User with ID 'user456' attempts to update/delete an answer authored by 'user123'.
     * @principle Public read, owner-only write, admin override.
     */
    match /questions/{questionId}/answers/{answerId} {
      function isOwner(authorId) {
        return request.auth != null && request.auth.uid == authorId;
      }

      function isAdmin() {
        return request.auth != null && request.auth.token.admin == true;
      }

      allow get, list: if true;

      allow create: if request.auth != null && isOwner(request.resource.data.authorId) && request.resource.data.authorId == request.auth.uid;
      allow update: if (isOwner(resource.data.authorId) && resource != null) || isAdmin();
      allow delete: if (isOwner(resource.data.authorId) && resource != null) || isAdmin();
    }

    /**
     * @description Controls access to knowledge base articles.
     *              Anyone can read articles, but only admins can create, update, or delete them.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) - Any user can read or list knowledge base articles.
     * @allow (create, update, delete) - Admin user creates, updates, or deletes articles. (auth.token.admin == true)
     * @deny (create, update, delete) - Non-admin user attempts to create, update, or delete articles.
     * @principle Public read, admin-only write.
     */
    match /knowledge_base_articles/{articleId} {
      function isAdmin() {
        return request.auth != null && request.auth.token.admin == true;
      }

      allow get, list: if true;

      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Controls access to live updates and announcements.
     *              Anyone can read updates, but only admins can create them.
     * @path /live_updates/{updateId}
     * @allow (get, list) - Any user can read or list live updates.
     * @allow (create, update, delete) - Admin user creates live updates. (auth.token.admin == true)
     * @deny (create, update, delete) - Non-admin user attempts to create live updates.
     * @principle Public read, admin-only write.
     */
    match /live_updates/{updateId} {
      function isAdmin() {
        return request.auth != null && request.auth.token.admin == true;
      }

      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Controls access to tags.
     *              Anyone can read tags, but only admins can create, update, or delete them.
     * @path /tags/{tagId}
     * @allow (get, list) - Any user can read or list tags.
     * @allow (create, update, delete) - Admin user creates, updates, or deletes tags. (auth.token.admin == true)
     * @deny (create, update, delete) - Non-admin user attempts to create, update, or delete tags.
     * @principle Public read, admin-only write.
     */
    match /tags/{tagId} {
      function isAdmin() {
        return request.auth != null && request.auth.token.admin == true;
      }

      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Controls access to user-specific notifications.
     *              Only the user and admins can access these notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list) - User with ID 'user123' reads their own notifications. (auth.uid == 'user123')
     * @allow (get, list) - Admin user reads any user's notifications. (auth.token.admin == true)
     * @allow (create) - User with ID 'user123' creates notification for themselves. (auth.uid == 'user123')
     * @allow (update, delete) - User with ID 'user123' updates or deletes their own notification. (auth.uid == 'user123')
     * @allow (update, delete) - Admin user updates or deletes any user's notifications. (auth.token.admin == true)
     * @deny (get, list) - User with ID 'user456' attempts to read notifications for 'user123'.
     * @deny (create) - User with ID 'user456' attempts to create notification for 'user123'.
     * @deny (update, delete) - User with ID 'user456' attempts to update/delete notification of 'user123'.
     * @principle Enforces document ownership and admin override.
     */
    match /users/{userId}/notifications/{notificationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isAdmin() {
        return request.auth != null && request.auth.token.admin == true;
      }

      allow get, list: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if (isOwner(userId) && resource.data.userId == userId && resource != null) || isAdmin();
      allow delete: if (isOwner(userId) && resource.data.userId == userId && resource != null) || isAdmin();
    }

    /**
     * @description Controls access to system logs.
     *              Only admins can read these logs.
     * @path /logs/{logId}
     * @allow (get, list) - Admin user reads system logs. (auth.token.admin == true)
     * @deny (get, list) - Non-admin user attempts to read system logs.
     * @principle Admin-only access.
     */
    match /logs/{logId} {
      function isAdmin() {
        return request.auth != null && request.auth.token.admin == true;
      }

      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}