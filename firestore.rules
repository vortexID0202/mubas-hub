/**
 * @file Firestore Security Rules for MUBAS Community Hub
 *
 * @core_philosophy This ruleset enforces a combination of user-ownership and role-based access control.
 *  - Users can only manage their own profiles and notifications.
 *  - Admins have broad access to manage content and system logs.
 *  - Public read access is granted to questions, answers, knowledge base articles, live updates, and tags.
 * @data_structure
 *  - User profiles are stored under `/users/{userId}`.
 *  - Questions and answers are stored under `/questions/{questionId}` and `/questions/{questionId}/answers/{answerId}`, respectively.
 *  - Knowledge base articles are stored under `/knowledge_base_articles/{articleId}`.
 *  - Live updates are stored under `/live_updates/{updateId}`.
 *  - Tags are stored under `/tags/{tagId}`.
 *  - Notifications are stored under `/users/{userId}/notifications/{notificationId}`.
 *  - Logs are stored under `/logs/{logId}`.
 * @key_security_decisions
 *  - Users cannot list all user accounts.
 *  - Public read access is enabled for specific collections to facilitate community engagement.
 *  - Only admins can manage knowledge base articles, live updates, tags, and system logs.
 * @denormalization_for_authorization
 *  - Questions and answers include denormalized `authorId` fields to simplify ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile access. Only the user and admins can read/write.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' creates their profile.
     * @allow (get) User with ID 'user123' reads their profile.
     * @allow (update) User with ID 'user123' updates their profile.
     * @deny (create) User with ID 'user123' tries to create a profile for 'user456'.
     * @deny (get) User with ID 'user123' tries to read profile of 'user456' when NOT admin.
     * @deny (update) User with ID 'user123' tries to update profile of 'user456' when NOT admin.
     * @deny (delete) User with ID 'user123' tries to delete profile of 'user456' when NOT admin.
     * @principle Enforces document ownership and admin override.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false; // User listing is not allowed

      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Manages community forum question access. Public read, owner/admin write.
     * @path /questions/{questionId}
     * @allow (get) Anyone reads a question.
     * @allow (list) Anyone lists questions.
     * @allow (create) User with ID 'user123' creates a question with authorId 'user123'.
     * @allow (update) User with ID 'user123' updates their question.
     * @deny (create) User with ID 'user123' creates a question with authorId 'user456'.
     * @deny (update) User with ID 'user123' tries to update question of 'user456' when NOT admin.
     * @deny (delete) User with ID 'user123' tries to delete question of 'user456' when NOT admin.
     * @principle Allows public read access but enforces document ownership for writes.
     */
    match /questions/{questionId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Manages answers to questions. Public read, owner/admin write.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get) Anyone reads an answer.
     * @allow (list) Anyone lists answers to a question.
     * @allow (create) User with ID 'user123' creates an answer with authorId 'user123'.
     * @allow (update) User with ID 'user123' updates their answer.
     * @deny (create) User with ID 'user123' creates an answer with authorId 'user456'.
     * @deny (update) User with ID 'user123' tries to update answer of 'user456' when NOT admin.
     * @deny (delete) User with ID 'user123' tries to delete answer of 'user456' when NOT admin.
     * @principle Allows public read access but enforces document ownership for writes.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Manages knowledge base articles. Public read, admin-only write.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get) Anyone reads a knowledge base article.
     * @allow (list) Anyone lists knowledge base articles.
     * @allow (create) Admin creates a knowledge base article.
     * @deny (create) Non-admin tries to create a knowledge base article.
     * @deny (update) Non-admin tries to update a knowledge base article.
     * @deny (delete) Non-admin tries to delete a knowledge base article.
     * @principle Restricts write access to admins only.
     */
    match /knowledge_base_articles/{articleId} {
      allow get: if true;
      allow list: if true;

      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages live updates. Public read, admin-only write.
     * @path /live_updates/{updateId}
     * @allow (get) Anyone reads a live update.
     * @allow (list) Anyone lists live updates.
     * @allow (create) Admin creates a live update.
     * @deny (create) Non-admin tries to create a live update.
     * @deny (update) Non-admin tries to update a live update.
     * @deny (delete) Non-admin tries to delete a live update.
     * @principle Restricts write access to admins only.
     */
    match /live_updates/{updateId} {
      allow get: if true;
      allow list: if true;

      allow create: if isAdmin();
      allow update: if false; // Updates and deletes are not allowed.
      allow delete: if false; // Updates and deletes are not allowed.
    }

    /**
     * @description Manages tags. Public read, admin-only write.
     * @path /tags/{tagId}
     * @allow (get) Anyone reads a tag.
     * @allow (list) Anyone lists tags.
     * @allow (create) Admin creates a tag.
     * @deny (create) Non-admin tries to create a tag.
     * @deny (update) Non-admin tries to update a tag.
     * @deny (delete) Non-admin tries to delete a tag.
     * @principle Restricts write access to admins only.
     */
    match /tags/{tagId} {
      allow get: if true;
      allow list: if true;

      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages user notifications. Only the user and admins can access.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get) User with ID 'user123' reads their notification.
     * @allow (list) User with ID 'user123' lists their notifications.
     * @deny (get) User with ID 'user123' tries to read notification of 'user456' when NOT admin.
     * @deny (update) User with ID 'user123' tries to update notification of 'user456' when NOT admin.
     * @deny (delete) User with ID 'user123' tries to delete notification of 'user456' when NOT admin.
     * @principle Enforces document ownership and admin override.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();

      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Manages system logs. Admin-only access.
     * @path /logs/{logId}
     * @allow (get) Admin reads a log entry.
     * @allow (list) Admin lists log entries.
     * @deny (get) Non-admin tries to read a log entry.
     * @deny (create) Non-admin tries to create a log entry.
     * @deny (update) Non-admin tries to update a log entry.
     * @deny (delete) Non-admin tries to delete a log entry.
     * @principle Restricts access to admins only.
     */
    match /logs/{logId} {
      allow get: if isAdmin();
      allow list: if isAdmin();

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }

  function isAdmin() {
    return isSignedIn() && request.auth.token.admin == true;
  }
}