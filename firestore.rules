/**
 * @fileoverview Firestore Security Rules for MUBAS Community Hub.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data and a role-based model for administrative functions.
 * Public read access is granted to certain collections like 'questions' and 'knowledge_base_articles', with restricted write access.
 * Authorization Independence is achieved through denormalization of authorization data, primarily the `authorId` field.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the user themselves.
 * - /questions/{questionId}: Community forum questions, publicly readable, writeable by the author.
 * - /questions/{questionId}/answers/{answerId}: Answers to questions, publicly readable, writeable by the answer's author.
 * - /knowledge_base_articles/{articleId}: Knowledge base articles, publicly readable, writeable by admins.
 * - /tags/{tagId}: Tags for questions and articles, publicly readable, writeable by admins.
 * - /users/{userId}/notifications/{notificationId}: User-specific notifications, accessible only to the user.
 * - /roles_admin/{uid}: Indicates admin status; existence of document grants admin privileges.
 *
 * Key Security Decisions:
 * - User listing is disabled to protect privacy.
 * - Public read access is granted for questions, answers and knowledge base articles.
 * - Default security posture for ambiguous relationships is strict owner-only access.
 * - Admin privileges are determined by the existence of a document in the `/roles_admin/{uid}` collection.
 *
 * Denormalization for Authorization:
 * - Questions and Answers include an `authorId` field to simplify ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by an authenticated user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided user ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

     /**
      * @description Checks if the authenticated user is an admin by checking the existence of the `/roles_admin/{uid}` document.
      */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the authenticated user owns the existing document based on the 'authorId' field.
     */
    function isExistingOwner(authorId) {
      return isSignedIn() && request.auth.uid == authorId && resource != null;
    }

    /**
     * @description Defines write rules for documents owned by users.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile: request.auth.uid == 'user123'
     * @deny (create) User with ID 'user456' cannot create a profile for 'user123': request.auth.uid != 'user123'
     * @allow (get, update, delete) Authenticated user 'user123' can access their own profile: request.auth.uid == 'user123'
     * @deny (get, update, delete) Authenticated user 'user456' cannot access 'user123' profile: request.auth.uid != 'user123'
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      // Only allow creation if the user ID in the path matches the authenticated user's ID.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      // Only the owner can read, update, or delete their own profile.
      allow get, update, delete: if isExistingOwner(userId);
      allow list: if false;
    }

    /**
     * @description Defines read and write rules for community questions.
     * @path /questions/{questionId}
     * @allow (get, list) Any user can read questions.
     * @allow (create) Authenticated user 'user123' can create a question with authorId 'user123'.
     * @deny (create) Authenticated user 'user456' cannot create a question with authorId 'user123'.
     * @allow (update, delete) Authenticated user 'user123' can update/delete their question with authorId 'user123'.
     * @deny (update, delete) Authenticated user 'user456' cannot update/delete question with authorId 'user123'.
     * @principle Allows public read access but restricts writes to the author.
     */
    match /questions/{questionId} {
      // Allow anyone to read questions.
      allow get, list: if true;

      // Only allow creation if the authorId matches the authenticated user's ID.
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;

      // Only the author can update or delete the question.
      allow update, delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Defines read and write rules for answers to community questions.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) Any user can read answers to questions.
     * @allow (create) Authenticated user 'user123' can create an answer with authorId 'user123'.
     * @deny (create) Authenticated user 'user456' cannot create an answer with authorId 'user123'.
     * @allow (update, delete) Authenticated user 'user123' can update/delete their answer with authorId 'user123'.
     * @deny (update, delete) Authenticated user 'user456' cannot update/delete answer with authorId 'user123'.
     * @principle Allows public read access but restricts writes to the author.
     */
    match /questions/{questionId}/answers/{answerId} {
      // Allow anyone to read answers.
      allow get, list: if true;

      // Only allow creation if the authorId matches the authenticated user's ID.
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;

      // Only the author can update or delete their answer.
      allow update, delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Defines read and write rules for knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) Any user can read knowledge base articles.
     * @allow (create, update, delete) Only admins can create, update, or delete articles.
     * @principle Allows public read access but restricts writes to admins only.
     */
    match /knowledge_base_articles/{articleId} {
      // Allow anyone to read knowledge base articles.
      allow get, list: if true;

      // Only admins can create, update, or delete knowledge base articles.
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Defines read and write rules for tags.
     * @path /tags/{tagId}
     * @allow (get, list) Any user can read tags.
     * @allow (create, update, delete) Only admins can create, update, or delete tags.
     * @principle Allows public read access but restricts writes to admins only.
     */
    match /tags/{tagId} {
      // Allow anyone to read tags.
      allow get, list: if true;

      // Only admins can create, update, or delete tags.
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Defines read and write rules for user-specific notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list, create, update, delete) Only the user can access their notifications.
     * @principle Restricts access to a user's own notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      // Only the user can read, create, update, or delete their own notifications.
      allow get, list, create, update, delete: if isOwner(userId);
    }
       /**
        * @description Defines read and write rules for admin roles based on document existence.
        * @path /roles_admin/{uid}
        * @allow (create) Any authenticated user with a matching uid can create their roles_admin profile.
        * @deny (create) Authenticated user 'user456' cannot create a roles_admin profile for 'user123'.
        * @allow (get, update, delete) Any authenticated user with a matching uid can get, update, or delete their roles_admin profile.
        * @deny (get, update, delete) Authenticated user 'user456' cannot get, update or delete 'user123' roles_admin profile.
        * @principle Defines admin permissions based on the existence of a dedicated `/roles_admin/{uid}` document.
        */
    match /roles_admin/{uid} {
         allow get, create, update, delete: if isSignedIn() && request.auth.uid == uid;
         allow list: if false;
    }
  }
}