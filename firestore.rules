/**
 * @fileOverview
 * This ruleset enforces a strict user-ownership model for user profiles and notifications,
 * while allowing public read access to questions, answers, knowledge base articles, and tags.
 * Admin privileges are granted based on the existence of a document in the `/roles_admin/{uid}` collection.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the user and admins.
 * - /questions/{questionId}: Community forum questions, publicly readable but writable only by the author and admins.
 * - /questions/{questionId}/answers/{answerId}: Answers to questions, publicly readable but writable only by the author and admins.
 * - /knowledge_base_articles/{articleId}: Knowledge base articles, publicly readable but writable only by admins.
 * - /tags/{tagId}: Tags for questions and articles, publicly readable but writable only by admins.
 * - /users/{userId}/notifications/{notificationId}: Notifications for users, accessible only to the user and admins.
 * - /roles_admin/{uid}: Admin role assignments. The existence of a document grants admin privileges to the user.
 *
 * Key Security Decisions:
 * - User profiles and notifications are strictly private, accessible only to the owning user and admins.
 * - Questions, answers, knowledge base articles, and tags are publicly readable to encourage community engagement.
 * - Only admins can create, update, or delete knowledge base articles and tags.
 * - List operations are generally allowed for owners of user-scoped data. Listing questions, answers, articles, and tags is public.
 * - Admin privileges are granted based on the existence of a document under `/roles_admin/{uid}`, simplifying rule logic.
 *
 * Denormalization for Authorization:
 * - The 'authorId' field is denormalized into the 'questions' and 'answers' collections to simplify ownership checks, avoiding costly `get()` calls.
 *
 * Structural Segregation:
 * - Publicly readable data (questions, answers, articles, tags) is stored in top-level collections, separate from private user data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to manage their own profiles. Only the user and admins can read/write.
     * @path /users/{userId}
     * @allow (create) - User with ID 'user123' can create their own profile if request.auth.uid == 'user123'.
     * @allow (get) - User with ID 'user123' can read their own profile if request.auth.uid == 'user123'.
     * @allow (update) - User with ID 'user123' can update their own profile if request.auth.uid == 'user123'.
     * @allow (delete) - User with ID 'user123' can delete their own profile if request.auth.uid == 'user123'.
     * @deny (create) - User with ID 'user456' cannot create a profile for 'user123' if request.auth.uid != 'user123'.
     * @deny (get) - User with ID 'user456' cannot read the profile of 'user123' if request.auth.uid != 'user123' and is not an admin.
     * @deny (update) - User with ID 'user456' cannot update the profile of 'user123' if request.auth.uid != 'user123' and is not an admin.
     * @deny (delete) - User with ID 'user456' cannot delete the profile of 'user123' if request.auth.uid != 'user123' and is not an admin.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && resource.data.id == request.resource.data.id;
      allow delete: if isSignedIn() && (isExistingOwner(userId) || isAdmin());
    }

    /**
     * @description Allows anyone to read questions, but only the author or an admin can create, update, or delete them.
     * @path /questions/{questionId}
     * @allow (get) - Any user can read a question.
     * @allow (list) - Any user can list questions.
     * @allow (create) - User with ID 'user123' can create a question with authorId 'user123' if request.auth.uid == 'user123'.
     * @allow (update) - User with ID 'user123' can update their own question if request.auth.uid == 'user123'.
     * @allow (delete) - User with ID 'user123' can delete their own question if request.auth.uid == 'user123'.
     * @deny (create) - User with ID 'user456' cannot create a question with authorId 'user123' if request.auth.uid != 'user123'.
     * @deny (update) - User with ID 'user456' cannot update the question of 'user123' if request.auth.uid != 'user123' and is not an admin.
     * @deny (delete) - User with ID 'user456' cannot delete the question of 'user123' if request.auth.uid != 'user123' and is not an admin.
     * @principle Public read access with owner-only writes.
     */
    match /questions/{questionId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (isOwner(resource.data.authorId) || isAdmin()) && resource != null;
      allow delete: if isSignedIn() && (isExistingOwner(resource.data.authorId) || isAdmin());
    }

    /**
     * @description Allows anyone to read answers, but only the author or an admin can create, update, or delete them.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get) - Any user can read an answer.
     * @allow (list) - Any user can list answers for a question.
     * @allow (create) - User with ID 'user123' can create an answer with authorId 'user123' if request.auth.uid == 'user123'.
     * @allow (update) - User with ID 'user123' can update their own answer if request.auth.uid == 'user123'.
     * @allow (delete) - User with ID 'user123' can delete their own answer if request.auth.uid == 'user123'.
     * @deny (create) - User with ID 'user456' cannot create an answer with authorId 'user123' if request.auth.uid != 'user123'.
     * @deny (update) - User with ID 'user456' cannot update the answer of 'user123' if request.auth.uid != 'user123' and is not an admin.
     * @deny (delete) - User with ID 'user456' cannot delete the answer of 'user123' if request.auth.uid != 'user123' and is not an admin.
     * @principle Public read access with owner-only writes, scoped to a subcollection.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (isOwner(resource.data.authorId) || isAdmin()) && resource != null;
      allow delete: if isSignedIn() && (isExistingOwner(resource.data.authorId) || isAdmin());
    }

    /**
     * @description Allows anyone to read knowledge base articles, but only admins can create, update, or delete them.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get) - Any user can read a knowledge base article.
     * @allow (list) - Any user can list knowledge base articles.
     * @allow (create) - Only admins can create knowledge base articles.
     * @allow (update) - Only admins can update knowledge base articles.
     * @allow (delete) - Only admins can delete knowledge base articles.
     * @deny (create) - Non-admins cannot create knowledge base articles.
     * @deny (update) - Non-admins cannot update knowledge base articles.
     * @deny (delete) - Non-admins cannot delete knowledge base articles.
     * @principle Public read access with admin-only writes.
     */
    match /knowledge_base_articles/{articleId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin() && resource != null;
      allow delete: if isSignedIn() && isAdmin() && resource != null;
    }

    /**
     * @description Allows anyone to read tags, but only admins can create, update, or delete them.
     * @path /tags/{tagId}
     * @allow (get) - Any user can read a tag.
     * @allow (list) - Any user can list tags.
     * @allow (create) - Only admins can create tags.
     * @allow (update) - Only admins can update tags.
     * @allow (delete) - Only admins can delete tags.
     * @deny (create) - Non-admins cannot create tags.
     * @deny (update) - Non-admins cannot update tags.
     * @deny (delete) - Non-admins cannot delete tags.
     * @principle Public read access with admin-only writes.
     */
    match /tags/{tagId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin() && resource != null;
      allow delete: if isSignedIn() && isAdmin() && resource != null;
    }

    /**
     * @description Allows users to manage their own notifications. Only the user and admins can access these notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (create) - User with ID 'user123' can create a notification for themselves if request.auth.uid == 'user123'.
     * @allow (get) - User with ID 'user123' can read their own notification if request.auth.uid == 'user123'.
     * @allow (list) - User with ID 'user123' can list their own notifications if request.auth.uid == 'user123'.
     * @allow (update) - User with ID 'user123' can update their own notification if request.auth.uid == 'user123'.
     * @allow (delete) - User with ID 'user123' can delete their own notification if request.auth.uid == 'user123'.
     * @deny (create) - User with ID 'user456' cannot create a notification for 'user123' if request.auth.uid != 'user123'.
     * @deny (get) - User with ID 'user456' cannot read a notification for 'user123' if request.auth.uid != 'user123' and is not an admin.
     * @deny (list) - User with ID 'user456' cannot list notifications for 'user123' if request.auth.uid != 'user123' and is not an admin.
     * @deny (update) - User with ID 'user456' cannot update a notification for 'user123' if request.auth.uid != 'user123' and is not an admin.
     * @deny (delete) - User with ID 'user456' cannot delete a notification for 'user123' if request.auth.uid != 'user123' and is not an admin.
     * @principle Enforces document ownership for user notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && request.resource.data.userId == userId && resource != null;
      allow delete: if isSignedIn() && (isExistingOwner(userId) || isAdmin());
    }

    /**
     * @description Grants admin privileges to a user based on the existence of a document at this path.
     * @path /roles_admin/{uid}
     */
    match /roles_admin/{uid} {
        allow get: if isSignedIn() && isAdmin();
        allow list: if false;
        allow create: if isSignedIn() && isAdmin();
        allow update: if false;
        allow delete: if isSignedIn() && isAdmin() && resource != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return request.auth.uid == userId && resource != null;
    }

    function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}