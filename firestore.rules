/**
 * @file Firebase Security Rules for MUBAS Community Hub
 *
 * @Core Philosophy:
 * This ruleset prioritizes secure data access based on user roles and ownership.
 * It enforces a user-ownership model for personal data and allows for open access to
 * public content while restricting modifications to authorized users or admins.
 *
 * @Data Structure:
 * The database is structured with user-specific data under `/users/{userId}` and
 * community content such as questions and knowledge base articles in top-level collections.
 * Answers are stored as subcollections under their respective questions.
 * Admin roles are managed through the `/roles_admin/{uid}` collection.
 *
 * @Key Security Decisions:
 * - User listing is disabled for privacy.
 * - Knowledge base articles are publicly readable but only writable by logged in users.
 * - The existence of a document in `/roles_admin/{uid}` grants admin privileges.
 * - Read and write access to notifications is restricted to the owning user.
 *
 * @Denormalization for Authorization:
 * - The `authorId` field is denormalized in `Question` and `Answer` documents to
 *   simplify ownership checks without requiring additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure access to user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     *    - auth.uid: 'user123'
     *    - request.resource.data.id: 'user123'
     * @allow (get) User with ID 'user123' can read their own profile.
     *    - auth.uid: 'user123'
     * @deny (update) User with ID 'user456' cannot update the profile of user 'user123'.
     *    - auth.uid: 'user456'
     * @deny (delete) User with ID 'user456' cannot delete the profile of user 'user123'.
     *    - auth.uid: 'user456'
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secure access to community forum questions.
     * @path /questions/{questionId}
     * @allow (get, list) Anyone can read and list questions.
     * @allow (create) User with ID 'user123' can create a question with authorId 'user123'.
     *    - auth.uid: 'user123'
     *    - request.resource.data.authorId: 'user123'
     * @allow (update) User with ID 'user123' can update a question they authored.
     *    - auth.uid: 'user123'
     *    - resource.data.authorId: 'user123'
     * @deny (update) User with ID 'user456' cannot update a question authored by 'user123'.
     *    - auth.uid: 'user456'
     *    - resource.data.authorId: 'user123'
     * @deny (delete) User with ID 'user456' cannot delete a question authored by 'user123'.
     *    - auth.uid: 'user456'
     *    - resource.data.authorId: 'user123'
     * @principle Enforces document ownership for writes while allowing public reads.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.authorId == resource.data.authorId && resource.data.authorId == request.auth.uid;
      allow delete: if isSignedIn() && request.resource.data.authorId == resource.data.authorId && resource.data.authorId == request.auth.uid;
    }

    /**
     * @description Secure access to answers to community forum questions.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) Anyone can read answers to a question.
     * @allow (create) User with ID 'user123' can create an answer with authorId 'user123' and questionId matching the parent.
     *    - auth.uid: 'user123'
     *    - request.resource.data.authorId: 'user123'
     *    - request.resource.data.questionId: '{questionId}'
     * @allow (update) User with ID 'user123' can update an answer they authored.
     *    - auth.uid: 'user123'
     *    - resource.data.authorId: 'user123'
     * @deny (update) User with ID 'user456' cannot update an answer authored by 'user123'.
     *    - auth.uid: 'user456'
     *    - resource.data.authorId: 'user123'
     * @deny (delete) User with ID 'user456' cannot delete an answer authored by 'user123'.
     *    - auth.uid: 'user456'
     *    - resource.data.authorId: 'user123'
     * @principle Enforces document ownership for writes while allowing public reads; validates relational integrity on create.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.questionId == questionId;
      allow update: if isSignedIn() && request.resource.data.authorId == resource.data.authorId && resource.data.authorId == request.auth.uid;
      allow delete: if isSignedIn() && request.resource.data.authorId == resource.data.authorId && resource.data.authorId == request.auth.uid;
    }

    /**
     * @description Secure access to knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) Anyone can read and list articles.
     * @allow (create) Logged in user can create knowledge base articles
     * @allow (update) Logged in user can update knowledge base articles
     * @allow (delete) Logged in user can delete knowledge base articles
     * @principle Allows public reads but restricts writes to logged in users.
     */
    match /knowledge_base_articles/{articleId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Secure access to tags.
     * @path /tags/{tagId}
     * @allow (get, list) Anyone can read tags.
     * @deny (create) Only admins can create tags.
     * @deny (update) Only admins can update tags.
     * @deny (delete) Only admins can delete tags.
     * @principle Restricts write access to admins only.
     */
    match /tags/{tagId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Secure access to user notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get) User with ID 'user123' can read their own notification.
     *    - auth.uid: 'user123'
     * @allow (list) User with ID 'user123' can list their own notifications.
     *    - auth.uid: 'user123'
     * @deny (create) User with ID 'user456' cannot create a notification for user 'user123'.
     *    - auth.uid: 'user456'
     * @deny (update) User with ID 'user456' cannot update the notification of user 'user123'.
     *    - auth.uid: 'user456'
     * @deny (delete) User with ID 'user456' cannot delete the notification of user 'user123'.
     *    - auth.uid: 'user456'
     * @principle Enforces document ownership and restricts access to a user's own notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Determines admin status based on document existence.
     * @path /roles_admin/{uid}
     * @allow (get) Anyone can check if a user is an admin
     * @allow (list) Nobody can list the roles_admin collection.
     * @allow (create) User with ID 'user123' can create their admin doc.
     *    - auth.uid: 'user123'
     * @deny (update) User with ID 'user456' cannot update the admin status of user 'user123'.
     *    - auth.uid: 'user456'
     * @deny (delete) User with ID 'user456' cannot delete the admin status of user 'user123'.
     *    - auth.uid: 'user456'
     */
    match /roles_admin/{uid} {
       allow get: if true;
       allow list: if false;
       allow create: if request.auth.uid == uid;
       allow update: if false;
       allow delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isAdmin() {
    return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
  }
}