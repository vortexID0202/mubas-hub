/**
 * @file Firestore Security Rules for MUBAS Community Hub
 *
 * @core_philosophy This ruleset enforces a combination of user-ownership and admin-controlled access.
 *  User data is strictly private, while certain content (questions, answers, knowledge base articles, live updates)
 *  allows for public read access. Administrative privileges are required for managing system-level data like logs and API keys.
 *
 * @data_structure The Firestore database is structured with top-level collections for core entities
 *  (questions, knowledge_base_articles, live_updates, tags, api_keys, logs) and user-specific subcollections
 *  under `/users/{userId}` for private data (user profiles, notifications). Answers are stored as a subcollection
 *  of questions at `/questions/{questionId}/answers/{answerId}` to establish a clear hierarchical relationship.
 *
 * @key_security_decisions
 *  - User listing is implicitly disallowed by the absence of a top-level `/users` collection read rule.
 *  - Read-only collections: Questions, Answers, KnowledgeBaseArticles, LiveUpdates and Tags allow public read access (`get`, `list`).
 *  - Logs and API keys are strictly admin-only.
 *  - All write operations are explicitly authorized to prevent accidental open access.
 *
 * @denormalization_for_authorization
 *  - Questions and Answers include denormalized `authorId` and `questionId` fields. This is to avoid costly `get()` operations
 *    when checking ownership or relationship constraints. Rules can directly validate `resource.data.authorId` against `request.auth.uid`.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profiles. Only the user and admins can access user profiles.
     * @path /users/{userId}
     * @allow (create) - User with ID 'user123' creates their profile. (request.auth.uid == 'user123')
     * @allow (get) - User with ID 'user123' reads their profile. (request.auth.uid == 'user123')
     * @allow (update) - User with ID 'user123' updates their profile. (request.auth.uid == 'user123')
     * @allow (delete) - User with ID 'user123' deletes their profile. (request.auth.uid == 'user123')
     * @deny (create) - User with ID 'user456' attempts to create profile for 'user123'.
     * @deny (get) - User with ID 'user456' attempts to read profile of 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow create: if isSignedIn() && isOwner(userId);
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to questions. Everyone can read questions, but only the author or an admin can update or delete them.
     * @path /questions/{questionId}
     * @allow (get) - Any user can read question with ID 'question123'.
     * @allow (list) - Any user can list questions.
     * @allow (create) - User with ID 'user123' creates a new question. (request.auth.uid == 'user123')
     * @allow (update) - User with ID 'user123' updates their question with ID 'question123'. (resource.data.authorId == 'user123' && request.auth.uid == 'user123')
     * @allow (delete) - User with ID 'user123' deletes their question with ID 'question123'. (resource.data.authorId == 'user123' && request.auth.uid == 'user123')
     * @deny (update) - User with ID 'user456' attempts to update question of 'user123'.
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /questions/{questionId} {
      function isOwner(authorId) {
        return request.auth.uid == authorId;
      }

      function isSignedIn() {
        return request.auth != null;
      }
       allow get: if true;
       allow list: if true;
       allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
       allow update: if isSignedIn() && isExistingOwner(resource.data.authorId);
       allow delete: if isSignedIn() && isExistingOwner(resource.data.authorId);

      function isExistingOwner(authorId) {
          return isOwner(authorId) && resource.data.authorId == authorId;
      }

      /**
       * @description Controls access to answers for specific questions. Everyone can read answers to a question, but only the author or an admin can update or delete them.
       * @path /questions/{questionId}/answers/{answerId}
       * @allow (get) - Any user can read answer with ID 'answer123' to question 'question123'.
       * @allow (list) - Any user can list answers to question 'question123'.
       * @allow (create) - User with ID 'user123' creates a new answer to question 'question123'. (request.auth.uid == 'user123')
       * @allow (update) - User with ID 'user123' updates their answer with ID 'answer123' to question 'question123'. (resource.data.authorId == 'user123' && request.auth.uid == 'user123')
       * @allow (delete) - User with ID 'user123' deletes their answer with ID 'answer123' to question 'question123'. (resource.data.authorId == 'user123' && request.auth.uid == 'user123')
       * @deny (update) - User with ID 'user456' attempts to update answer of 'user123' to question 'question123'.
       * @principle Enforces document ownership for writes, allows public reads.
       */
      match /answers/{answerId} {
        function isOwner(authorId) {
          return request.auth.uid == authorId;
        }

        function isSignedIn() {
          return request.auth != null;
        }
        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update: if isSignedIn() && isExistingOwner(resource.data.authorId);
        allow delete: if isSignedIn() && isExistingOwner(resource.data.authorId);

        function isExistingOwner(authorId) {
            return isOwner(authorId) && resource.data.authorId == authorId;
        }
      }
    }

    /**
     * @description Controls access to knowledge base articles. Only admins can create, update, or delete articles. Everyone can read.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get) - Any user can read article with ID 'article123'.
     * @allow (list) - Any user can list articles.
     * @allow (create) - Admin user creates a new article. (request.auth.token.admin == true)
     * @allow (update) - Admin user updates article with ID 'article123'. (request.auth.token.admin == true)
     * @allow (delete) - Admin user deletes article with ID 'article123'. (request.auth.token.admin == true)
     * @deny (create) - Non-admin user attempts to create a new article.
     * @principle Enforces admin-only writes, allows public reads.
     */
    match /knowledge_base_articles/{articleId} {
      function isAdmin() {
        return request.auth.token.admin == true;
      }

      function isSignedIn() {
        return request.auth != null;
      }
       allow get: if true;
       allow list: if true;
       allow create: if isSignedIn() && isAdmin();
       allow update: if isSignedIn() && isAdmin();
       allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Controls access to live updates and announcements. Anyone can read these updates, but only admins can create them.
     * @path /live_updates/{updateId}
     * @allow (get) - Any user can read update with ID 'update123'.
     * @allow (list) - Any user can list updates.
     * @allow (create) - Admin user creates a new update. (request.auth.token.admin == true)
     * @deny (create) - Non-admin user attempts to create a new update.
     * @principle Enforces admin-only writes, allows public reads.
     */
    match /live_updates/{updateId} {
      function isAdmin() {
        return request.auth.token.admin == true;
      }

      function isSignedIn() {
        return request.auth != null;
      }
       allow get: if true;
       allow list: if true;
       allow create: if isSignedIn() && isAdmin();
       allow update: if false;
       allow delete: if false;
    }

    /**
     * @description Controls access to tags. Tags can be read by anyone, but only admins can create, update, or delete them.
     * @path /tags/{tagId}
     * @allow (get) - Any user can read tag with ID 'tag123'.
     * @allow (list) - Any user can list tags.
     * @allow (create) - Admin user creates a new tag. (request.auth.token.admin == true)
     * @allow (update) - Admin user updates tag with ID 'tag123'. (request.auth.token.admin == true)
     * @allow (delete) - Admin user deletes tag with ID 'tag123'. (request.auth.token.admin == true)
     * @deny (create) - Non-admin user attempts to create a new tag.
     * @principle Enforces admin-only writes, allows public reads.
     */
    match /tags/{tagId} {
      function isAdmin() {
        return request.auth.token.admin == true;
      }

      function isSignedIn() {
        return request.auth != null;
      }
       allow get: if true;
       allow list: if true;
       allow create: if isSignedIn() && isAdmin();
       allow update: if isSignedIn() && isAdmin();
       allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Protects user notifications. Only the user and admins can access these notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (create) - User with ID 'user123' creates a notification for themselves. (request.auth.uid == 'user123')
     * @allow (get) - User with ID 'user123' reads their notification with ID 'notification123'. (request.auth.uid == 'user123')
     * @allow (list) - User with ID 'user123' lists their notifications. (request.auth.uid == 'user123')
     * @allow (update) - User with ID 'user123' updates their notification with ID 'notification123'. (request.auth.uid == 'user123')
     * @allow (delete) - User with ID 'user123' deletes their notification with ID 'notification123'. (request.auth.uid == 'user123')
     * @deny (create) - User with ID 'user456' attempts to create a notification for 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/notifications/{notificationId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow create: if isSignedIn() && isOwner(userId);
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Restricts access to system logs. Only admins can read these logs.
     * @path /logs/{logId}
     * @allow (get) - Admin user reads log with ID 'log123'. (request.auth.token.admin == true)
     * @allow (list) - Admin user lists logs. (request.auth.token.admin == true)
     * @deny (get) - Non-admin user attempts to read log.
     * @principle Enforces admin-only access.
     */
    match /logs/{logId} {
      function isAdmin() {
        return request.auth.token.admin == true;
      }

      function isSignedIn() {
        return request.auth != null;
      }
       allow get: if isSignedIn() && isAdmin();
       allow list: if isSignedIn() && isAdmin();
       allow create: if false;
       allow update: if false;
       allow delete: if false;
    }

    /**
     * @description Restricts access to API keys. Only admins can manage these keys.
     * @path /api_keys/{apiKeyId}
     * @allow (create) - Admin user creates a new API key. (request.auth.token.admin == true)
     * @allow (get) - Admin user reads API key with ID 'apiKey123'. (request.auth.token.admin == true)
     * @allow (list) - Admin user lists API keys. (request.auth.token.admin == true)
     * @allow (update) - Admin user updates API key with ID 'apiKey123'. (request.auth.token.admin == true)
     * @allow (delete) - Admin user deletes API key with ID 'apiKey123'. (request.auth.token.admin == true)
     * @deny (create) - Non-admin user attempts to create a new API key.
     * @principle Enforces admin-only access.
     */
    match /api_keys/{apiKeyId} {
      function isAdmin() {
        return request.auth.token.admin == true;
      }

      function isSignedIn() {
        return request.auth != null;
      }
       allow create: if isSignedIn() && isAdmin();
       allow get: if isSignedIn() && isAdmin();
       allow list: if isSignedIn() && isAdmin();
       allow update: if isSignedIn() && isAdmin();
       allow delete: if isSignedIn() && isAdmin();
    }
  }
}