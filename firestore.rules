/**
 * @file Firestore Security Rules for MUBAS Community Hub
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model for personal data (users, questions, notifications) and allows public read access to questions and answers.
 *   Administrative privileges are granted based on the existence of a document in the `roles_admin` collection.  Data validation is minimal, focusing on authorization and relational integrity.
 *
 * @data_structure
 *   - /users/{userId}: User profiles, accessible only by the user and admins.
 *   - /users/{userId}/questions/{questionId}: Questions created by a specific user, accessible only by the user and admins.
 *   - /questions/{questionId}/answers/{answerId}: Answers to questions, publicly readable, but writable only with a valid user ID and correct questionId.
 *   - /categories/{categoryId}: Knowledge base categories, writable only by admins.
 *   - /categories/{categoryId}/articles/{articleId}: Knowledge base articles, writable only by admins.
 *   - /users/{userId}/notifications/{notificationId}: Notifications for a specific user, accessible only by that user.
 *   - /roles_admin/{userId}: Indicates admin privileges; the existence of a document grants admin rights to the user.
 *
 * @key_security_decisions
 *   - Public read access to questions and answers.
 *   - Strict ownership for user profiles and notifications.
 *   - Admin-only access for categories and knowledge base articles.
 *   - Listing of questions and answers is allowed for all users.
 *   - Listing of notifications is restricted to the owning user.
 *   - User listing is disallowed.
 *
 * @denormalization_for_authorization
 *   - Questions include the `userId` field for authorization, avoiding extra reads.
 *   - Answers include the `questionId` and `userId` fields for authorization.
 *
 * @structural_segregation
 *   - Private user data (notifications) is stored under /users/{userId}.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles. Users can only read/write their own profile. Admins can read all profiles.
     * @path /users/{userId}
     * @allow (get, update, delete) if isSignedIn() && isOwner(userId)
     * @allow (create) if isSignedIn() && request.auth.uid == userId
     * @allow (list) if false; // User listing is disallowed.
     * @deny (get, update, delete) if !isSignedIn() || !isOwner(userId)
     * @principle Enforces document ownership for writes, allows owner and admins to read.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isAdmin() {
          return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && exists(resource);
      }
        function isSignedIn() {
            return request.auth != null;
        }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    /**
     * @description Controls access to questions posted by a specific user. The user can only read/write their own questions.
     * @path /users/{userId}/questions/{questionId}
     * @allow (get, update, delete) if isSignedIn() && isOwner(userId)
     * @allow (create) if isSignedIn() && request.auth.uid == userId
     * @allow (list) if isSignedIn() && isOwner(userId)
     * @deny (get, update, delete) if !isSignedIn() || !isOwner(userId)
     * @principle Enforces document ownership for writes, allows owner to read.
     */
    match /users/{userId}/questions/{questionId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
          return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && exists(resource);
      }
        function isSignedIn() {
            return request.auth != null;
        }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.get('userId') == userId;
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && request.resource.data.get('userId') == resource.data.get('userId');
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    /**
     * @description Controls access to answers for a specific question. Answers are publicly readable, but creation requires authentication.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) if true;
     * @allow (create) if isSignedIn()
     * @allow (update, delete) if isSignedIn() && isOwner(resource.data.userId)
     * @deny (create) if !isSignedIn()
     * @deny (update, delete) if !isSignedIn() || !isOwner(resource.data.userId)
     * @principle Allows public read access, enforces ownership for updates and deletes.
     */
    match /questions/{questionId}/answers/{answerId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
          return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && exists(resource);
      }
        function isSignedIn() {
            return request.auth != null;
        }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isOwner(resource.data.get('userId'));
      allow delete: if isSignedIn() && isOwner(resource.data.get('userId'));
    }

    /**
     * @description Controls access to knowledge base categories. Only admins can create, edit, and delete categories.
     * @path /categories/{categoryId}
     * @allow (get, list) if true;
     * @allow (create, update, delete) if isAdmin()
     * @deny (create, update, delete) if !isAdmin()
     * @principle Restricts access to admins only.
     */
    match /categories/{categoryId} {
        function isAdmin() {
            return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
        }

        function isExistingAdmin() {
            return isAdmin() && exists(resource);
        }
        function isSignedIn() {
            return request.auth != null;
        }

      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to knowledge base articles within specific categories. Only admins can create, edit, and delete articles.
     * @path /categories/{categoryId}/articles/{articleId}
     * @allow (get, list) if true;
     * @allow (create, update, delete) if isAdmin()
     * @deny (create, update, delete) if !isAdmin()
     * @principle Restricts access to admins only.
     */
    match /categories/{categoryId}/articles/{articleId} {
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
        function isExistingAdmin() {
            return isAdmin() && exists(resource);
        }
        function isSignedIn() {
            return request.auth != null;
        }

      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to notifications for individual users. Only the user can access their notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, update, delete) if isSignedIn() && isOwner(userId)
     * @allow (create) if isSignedIn() && request.auth.uid == userId
     * @allow (list) if isSignedIn() && isOwner(userId)
     * @deny (get, update, delete) if !isSignedIn() || !isOwner(userId)
     * @principle Enforces document ownership.
     */
    match /users/{userId}/notifications/{notificationId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
          return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && exists(resource);
      }
        function isSignedIn() {
            return request.auth != null;
        }
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    /**
     * @description Grants admin privileges based on the existence of a document in this collection.
     * @path /roles_admin/{userId}
     */
    match /roles_admin/{userId} {
        function isAdmin() {
            return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
        }

        function isExistingAdmin() {
            return isAdmin() && exists(resource);
        }
        function isSignedIn() {
            return request.auth != null;
        }

        allow get: if isAdmin();
        allow list: if false;
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update: if isAdmin() && request.auth.uid == userId;
        allow delete: if isAdmin();
    }

    /**
     * @description Questions collection is publicly readable, but requires authentication to post.
     * @path /questions/{questionId}
     * @allow (get, list) if true;
     * @allow (create) if isSignedIn();
     *
     */
    match /questions/{questionId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function isAdmin() {
            return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
        }

        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn();
        allow update: if false;
        allow delete: if isSignedIn() && isAdmin();
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}