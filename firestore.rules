rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }
    
    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId); // Allow users to create their own profile
      allow update: if isOwner(userId); // Allow users to update their own profile
      allow delete: if isAdmin(); // Only admins can delete user profiles
    }

    // Questions and Answers
    match /questions/{questionId} {
      allow read, update, delete: if true; // anyone can read, owner/admin can update/delete
      allow create: if request.auth != null; // Must be logged in to create
      
      match /answers/{answerId} {
        allow read: if true; // Anyone can read answers
        allow create: if request.auth != null; // Must be logged in to answer
        allow update, delete: if request.auth != null && (isOwner(resource.data.authorId) || isAdmin()); // Answer owner or admin
      }
    }

    // Knowledge Base Articles
    match /knowledge_base_articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin(); // Only admins can write/update/delete KB articles
    }
    
    // Live Updates
    match /live_updates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tags
    match /tags/{tagId} {
      allow read: if true; // Everyone can read tags
      allow write: if isAdmin(); // Only admins can create/update tags
    }

    // Admin Roles
    match /roles_admin/{userId} {
      allow get: if isOwner(userId) || isAdmin(); // Allow user to check their own admin status, or admins to check others
      allow list, write: if isAdmin(); // Only admins can list or modify admin roles
    }
    
    // User-specific notifications
    match /users/{userId}/notifications/{notificationId} {
        allow read, write: if isOwner(userId); // Only the user can access their notifications
    }
  }
}
