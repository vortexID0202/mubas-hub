/**
 * @fileOverview
 * Core Philosophy: This ruleset enforces a strict user-ownership model for personal data,
 * combined with public read access and owner-only write access for community content. Admin
 * roles are managed through database-based access control (DBAC). Data validation is relaxed
 * to enable rapid prototyping, focusing primarily on authorization and relational integrity.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, private to the user.
 * - /questions/{questionId}: Community questions, publicly readable but owner-writable.
 * - /questions/{questionId}/answers/{answerId}: Answers to questions, publicly readable but owner-writable.
 * - /knowledge_base_articles/{articleId}: Knowledge base articles, publicly readable, admin-writable.
 * - /tags/{tagId}: Tags for content, publicly readable, admin-writable.
 * - /users/{userId}/notifications/{notificationId}: User-specific notifications, private to the user.
 * - /roles_admin/{uid}: Admin role assignments. Existence of a document grants admin privileges.
 *
 * Key Security Decisions:
 * - User data is strictly private and only accessible to the user themselves and admins.
 * - Public read access is granted to questions, answers, knowledge base articles, and tags to encourage community engagement and knowledge sharing.
 * - List operations are generally restricted to owners for user-specific data.
 * - Data validation is minimized to focus on authorization and relational integrity, enabling rapid prototyping.
 * - Admin privileges are granted based on the existence of a document in the `/roles_admin/{uid}` collection.
 *
 * Denormalization for Authorization:
 * - Questions and Answers include the `authorId` field, directly linking them to the user who created them. This avoids costly `get()` calls to the `/users/{userId}` collection to verify ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles. Only the user and admins can read/write.
     * @path /users/{userId}
     * @allow (create) - User with matching userId can create their profile.
     * @allow (get, list, update, delete) - User with matching userId can read/update/delete their profile.
     * @deny (create, get, list, update, delete) - Other users cannot access this data.
     * @principle Enforces document ownership for user profiles and uses DBAC for admin roles.
     */
    match /users/{userId} {
      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to community forum questions.
     * @path /questions/{questionId}
     * @allow (get, list) - Anyone can read questions.
     * @allow (create) - Authenticated user can create a question.
     * @allow (update, delete) - Only the author of the question can update/delete it.
     * @deny (create, update, delete) - Non-authors cannot modify questions.
     * @principle Allows public read access while enforcing owner-only write access for questions.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.authorId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.authorId);
    }

    /**
     * @description Controls access to answers for specific questions.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) - Anyone can read answers to a question.
     * @allow (create) - Authenticated user can create an answer.
     * @allow (update, delete) - Only the author of the answer can update/delete it.
     * @deny (create, update, delete) - Non-authors cannot modify answers.
     * @principle Allows public read access while enforcing owner-only write access for answers.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.authorId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.authorId);
    }

    /**
     * @description Controls access to knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) - Anyone can read knowledge base articles.
     * @deny (create, update, delete) - Only admins can modify articles.
     * @principle Restricts write access to knowledge base articles to admins only.
     */
    match /knowledge_base_articles/{articleId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to tags.
     * @path /tags/{tagId}
     * @allow (get, list) - Anyone can read tags.
     * @deny (create, update, delete) - Only admins can modify tags.
     * @principle Restricts write access to tags to admins only.
     */
    match /tags/{tagId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to user-specific notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list) - The user and admins can read notifications.
     * @allow (create) - The user can create notification.
     * @allow (update, delete) - The user can update/delete notifications.
     * @deny (create, get, list, update, delete) - Other users cannot access this data.
     * @principle Enforces document ownership for notifications and uses DBAC for admin roles.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

        /**
         * @description Grants admin privileges based on the existence of a document in this collection.
         * @path /roles_admin/{uid}
         * @allow get: if true; // Needed for the isAdmin() function to work.
         * @allow create: if false;
         * @allow update: if false;
         * @allow delete: if false;
         * @principle DBAC (Database-Based Access Control)
         */
        match /roles_admin/{uid} {
          allow get: if true;
          allow create: if false;
          allow update: if false;
          allow delete: if false;
        }

    // ---- Helper Functions ----

    /**
     * @description Checks if the user is signed in.
     * @returns {boolean} True if the user is signed in; false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user ID matches the authenticated user's ID.
     * @param {string} userId The user ID to check.
     * @returns {boolean} True if the user ID matches the authenticated user's ID; false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of an existing document.
     * @param {string} userId The user ID to check.
     * @returns {boolean} True if the user ID matches the authenticated user's ID and the document exists; false otherwise.
     */
    function isExistingOwner(userId) {
        return isSignedIn() && isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is an admin by verifying the existence of a document in the `/roles_admin/{uid}` collection.
     * @returns {boolean} True if the user is an admin; false otherwise.
     */
    function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}