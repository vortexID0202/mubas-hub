/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for personal data and an admin-controlled model for system-level data.
 *
 * Data Structure:
 * - User profiles are stored under `/users/{userId}` and are private to the user and admins.
 * - Questions are stored under `/questions/{questionId}` and answers are stored under `/questions/{questionId}/answers/{answerId}`.
 * - Knowledge base articles are stored under `/knowledge_base_articles/{articleId}` and are publicly readable.
 * - Live updates are stored under `/live_updates/{updateId}` and are publicly readable.
 * - Tags are stored under `/tags/{tagId}` and are publicly readable.
 * - Notifications are stored under `/users/{userId}/notifications/{notificationId}` and are private to the user.
 * - Logs are stored under `/logs/{logId}` and are only readable by admins.
 * - API Keys are stored under `/api_keys/{apiKeyId}` and are only manageable by admins.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Public read access is granted to questions, answers, knowledge base articles, live updates and tags.
 * - Write access to questions and answers is restricted to the author and admins.
 * - Knowledge base articles, live updates, tags, logs, and API keys are only manageable by admins.
 * - Default security posture for ambiguous relationships is strict owner-only access.
 *
 * Denormalization for Authorization:
 * - Questions and Answers include denormalized `authorId` fields to simplify ownership checks.
 * - Answers also include a denormalized `questionId` for authorization purposes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures user profiles, allowing only the user and admins to read and write.
     * @path /users/{userId}
     * @allow (create) User with ID matching auth.uid can create their profile.
     * @allow (get, update, delete) Authenticated user with ID matching the document ID can access it. Admins can also access.
     * @deny (create) User with ID not matching auth.uid cannot create a profile.
     * @deny list
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      //function isAdmin() {
      //  return request.auth.token.admin == true;
      //}

      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures community forum questions, allowing anyone to read, but only the author or an admin to update or delete.
     * @path /questions/{questionId}
     * @allow (get, list) Anyone can read or list questions.
     * @allow (create) Authenticated user can create a question with their ID as the author.
     * @allow (update, delete) Only the author or an admin can update or delete.
     * @deny (create) Non-authenticated users cannot create questions.
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /questions/{questionId} {

      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(authorId) {
        return request.auth.uid == authorId;
      }

      function isExistingOwner(authorId) {
        return isOwner(authorId) && resource != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId);
      allow delete: if isExistingOwner(resource.data.authorId);
    }

    /**
     * @description Secures answers to questions, allowing anyone to read, but only the author or an admin to update or delete.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) Anyone can read or list answers to a question.
     * @allow (create) Authenticated user can create an answer with their ID as the author and the correct questionId.
     * @allow (update, delete) Only the author or an admin can update or delete.
     * @deny (create) Non-authenticated users cannot create answers.
     * @principle Enforces document ownership for writes, allows public reads, and validates relationship integrity.
     */
    match /questions/{questionId}/answers/{answerId} {

      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(authorId) {
        return request.auth.uid == authorId;
      }

      function isExistingOwner(authorId) {
        return isOwner(authorId) && resource != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.questionId == questionId;
      allow update: if isExistingOwner(resource.data.authorId);
      allow delete: if isExistingOwner(resource.data.authorId);
    }

    /**
     * @description Secures knowledge base articles, allowing anyone to read, but only admins to create, update, or delete.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) Anyone can read knowledge base articles.
     * @deny (create, update, delete) Only admins can create, update, or delete articles.
     * @principle Restricts write access to admins, allows public reads.
     */
    match /knowledge_base_articles/{articleId} {

      function isAdmin() {
        return request.auth.token.admin == true;
      }

      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Secures live updates, allowing anyone to read, but only admins to create, update or delete.
     * @path /live_updates/{updateId}
     * @allow (get, list) Anyone can read live updates.
     * @deny (create, update, delete) Only admins can create, update, or delete live updates.
     * @principle Restricts write access to admins, allows public reads.
     */
    match /live_updates/{updateId} {

      function isAdmin() {
        return request.auth.token.admin == true;
      }

      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Secures tags, allowing anyone to read, but only admins to create, update, or delete.
     * @path /tags/{tagId}
     * @allow (get, list) Anyone can read tags.
     * @deny (create, update, delete) Only admins can create, update, or delete tags.
     * @principle Restricts write access to admins, allows public reads.
     */
    match /tags/{tagId} {

      function isAdmin() {
        return request.auth.token.admin == true;
      }

      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Secures notifications for a specific user, allowing only the user and admins to access.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list) Only the user and admins can read notifications.
     * @allow (create) Authenticated user with ID matching the parent userId can create a notification for themselves.
     * @allow (update, delete) Only the user and admins can update or delete notifications.
     * @deny list
     * @principle Enforces document ownership for reads and writes.
     */
    match /users/{userId}/notifications/{notificationId} {

      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures system logs, allowing only admins to read.
     * @path /logs/{logId}
     * @allow (get, list) Only admins can read logs.
     * @deny (create, update, delete) No one can create, update, or delete logs through the client.
     * @principle Restricts access to sensitive system data.
     */
    match /logs/{logId} {

      function isAdmin() {
        return request.auth.token.admin == true;
      }

      allow get, list: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secures API keys, allowing only admins to manage them.
     * @path /api_keys/{apiKeyId}
     * @allow (get, list, create, update, delete) Only admins can manage API keys.
     * @principle Restricts access to sensitive API key data.
     */
    match /api_keys/{apiKeyId} {

      function isAdmin() {
        return request.auth.token.admin == true;
      }

      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
  }
}