/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control system and user-ownership model.
 *   - Users can only read and write their own data under /users/{userId}.
 *   - Knowledge base articles are publicly readable, but only admins can modify them.
 *   - Questions and answers are publicly readable, but only the author can modify them.
 *   - Notifications are private and accessible only to the user they belong to.
 *   - Tags are publicly readable, but only admins can modify them.
 *
 * @dataStructure
 *   - /users/{userId}: User profiles, private to the user.
 *   - /questions/{questionId}: Community forum questions, publicly readable, owner-editable.
 *   - /questions/{questionId}/answers/{answerId}: Answers to questions, publicly readable, owner-editable.
 *   - /knowledge_base_articles/{articleId}: Knowledge base articles, publicly readable, admin-editable.
 *   - /tags/{tagId}: Tags, publicly readable, admin-editable.
 *   - /users/{userId}/notifications/{notificationId}: User-specific notifications, private to the user.
 *   - /roles_admin/{uid}: Documents indicating admin role; existence confers admin privileges.
 *
 * @keySecurityDecisions
 *   - Admin privileges are determined by the existence of a document in the `/roles_admin/{uid}` collection.
 *   - User listing is generally disallowed to protect privacy.
 *   - All write operations require authentication (`request.auth != null`).
 *   - Missing ownership fields for "Public Read with Owner-Only Writes" patterns are flagged with `// TODO:` comments.
 *
 * @denormalizationForAuthorization
 *   - Questions and Answers both denormalize the `authorId` to allow for easy ownership checks.
 *
 * @structuralSegregation
 *   - Private user data is stored under the `/users/{userId}` collection, ensuring clear ownership and access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the request is made by the owner of the resource.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

     /**
      * @description Checks if the request is made by the owner of the existing resource.
      */
     function isExistingOwner(userId) {
       return isOwner(userId) && resource != null;
     }

    /**
     * @description Checks if the user is an admin based on the existence of a document in /roles_admin/{uid}.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /******************** Users Collection ********************/

    /**
     * @description Manages user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     *     - auth.uid: 'user123'
     *     - request.resource.data.id: 'user123'
     * @deny (update) User with ID 'user456' cannot update the profile of user 'user123'.
     *     - auth.uid: 'user456'
     *     - userId: 'user123'
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree, validates relational integrity between documents.
     */
    match /users/{userId} {
      // Only the user themselves can read their profile.
      allow get: if isOwner(userId);
      // Only the user themselves can list their profile.
      allow list: if false;

      // Allow a user to create their own profile if the userId matches their auth.uid.
      allow create: if isOwner(userId) && request.resource.data.id == userId;

      // Only the user themselves can update their profile.  Ensure the userId is immutable.
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;

      // Only the user themselves can delete their profile.
      allow delete: if isExistingOwner(userId);
    }

    /******************** Questions Collection ********************/

    /**
     * @description Manages community forum questions.
     * @path /questions/{questionId}
     * @allow (get) Any user can read a question.
     * @allow (create) User with ID 'user123' can create a question with authorId 'user123'.
     *     - auth.uid: 'user123'
     *     - request.resource.data.authorId: 'user123'
     * @deny (update) User with ID 'user456' cannot update a question authored by 'user123'.
     *     - auth.uid: 'user456'
     *     - resource.data.authorId: 'user123'
     * @principle Enforces document ownership for writes.
     */
    match /questions/{questionId} {
      // Anyone can read or list questions.
      allow get, list: if true;

      // Only signed-in users can create questions, and the authorId must match their UID.
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;

      // Only the author or an admin can update a question. Enforce immutability of authorId.
      allow update: if (isExistingOwner(resource.data.authorId) || isAdmin()) && request.resource.data.authorId == resource.data.authorId;

      // Only the author or an admin can delete a question.
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /******************** Answers Collection ********************/

    /**
     * @description Manages answers to specific questions.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get) Any user can read an answer.
     * @allow (create) User with ID 'user123' can create an answer with authorId 'user123'.
     *     - auth.uid: 'user123'
     *     - request.resource.data.authorId: 'user123'
     * @deny (update) User with ID 'user456' cannot update an answer authored by 'user123'.
     *     - auth.uid: 'user456'
     *     - resource.data.authorId: 'user123'
     * @principle Enforces document ownership for writes.
     */
    match /questions/{questionId}/answers/{answerId} {
      // Anyone can read or list answers to a question.
      allow get, list: if true;

      // Only signed-in users can create answers, and the authorId must match their UID.
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;

      // Only the author or an admin can update an answer. Enforce immutability of authorId.
      allow update: if (isExistingOwner(resource.data.authorId) || isAdmin()) && request.resource.data.authorId == resource.data.authorId;

      // Only the author or an admin can delete an answer.
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /******************** Knowledge Base Articles Collection ********************/

    /**
     * @description Manages knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get) Any user can read a knowledge base article.
     * @allow (create) Only admins can create knowledge base articles.
     * @deny (update) Non-admins cannot update knowledge base articles.
     * @principle Restricts write access to admins.
     */
    match /knowledge_base_articles/{articleId} {
      // Anyone can read or list knowledge base articles.
      allow get, list: if true;

      // Only admins can create knowledge base articles. Author ID must match.
      allow create: if isAdmin() && isSignedIn() && request.resource.data.authorId == request.auth.uid;

      // Only admins can update knowledge base articles. Author ID must not change.
      allow update: if isAdmin() && request.resource.data.authorId == resource.data.authorId;

      // Only admins can delete knowledge base articles.
      allow delete: if isAdmin();
    }

    /******************** Tags Collection ********************/

    /**
     * @description Manages tags.
     * @path /tags/{tagId}
     * @allow (get) Any user can read a tag.
     * @allow (create) Only admins can create tags.
     * @deny (update) Non-admins cannot update tags.
     * @principle Restricts write access to admins.
     */
    match /tags/{tagId} {
      // Anyone can read or list tags.
      allow get, list: if true;

      // Only admins can create tags.
      allow create: if isAdmin();

      // Only admins can update tags.
      allow update: if isAdmin();

      // Only admins can delete tags.
      allow delete: if isAdmin();
    }

    /******************** Notifications Collection ********************/

    /**
     * @description Manages notifications for a specific user.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get) Only the user and admins can read their own notifications.
     * @allow (create) Only the user can create notifications for themselves.
     * @deny (update) Other users cannot update notifications.
     * @principle Restricts access to a user's own notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      // Only the user themselves can read their own notifications.
      allow get: if isOwner(userId);
      // Only the user themselves can list their own notifications.
      allow list: if isOwner(userId);

      // Only the user can create notifications for themselves.
      allow create: if isOwner(userId);

      // Only the user can update their own notifications.
      allow update: if isExistingOwner(userId);

      // Only the user can delete their own notifications.
      allow delete: if isExistingOwner(userId);
    }
    /******************** Roles Admin Collection ********************/
   /**
    * @description Admin role collection. Presence of a document with a user ID confers admin privileges.
    * @path /roles_admin/{uid}
    * @allow (get) Admins can read role assignments
    * @allow (create) Admins can assign roles
    * @allow (update) Admins can modify role assignments
    * @allow (delete) Admins can remove role assignments
    * @principle DBAC (Database-Based Access Control): Role is determined by the existence of a document at a specific path.
    */
    match /roles_admin/{uid} {
        allow get: if isAdmin();
        allow list: if false; // Prevent listing of admin roles
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
    }
  }
}