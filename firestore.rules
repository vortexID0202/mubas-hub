/**
 * @file Firebase Security Rules for MUBAS Community Hub
 * @version 2
 *
 * @Core Philosophy:
 * This ruleset implements a hybrid security model, combining user-based ownership,
 * role-based access control (using DBAC), and public read access where appropriate.
 * User-generated content (questions, answers, notifications) is generally restricted to
 * the owning user. Knowledge base articles and tags have stricter controls, typically
 * managed by admins.
 *
 * @Data Structure:
 * - /users/{userId}: User profiles, accessible only to the user and admins.
 * - /questions/{questionId}: Community forum questions. Publicly readable, but
 *   updates/deletes are restricted to the author or an admin.
 * - /questions/{questionId}/answers/{answerId}: Answers to questions. Similar read/write
 *   permissions as questions.
 * - /knowledge_base_articles/{articleId}: Knowledge base articles, publicly readable,
 *   but create/update/delete are restricted to admins.
 * - /tags/{tagId}: Tags for questions and articles. Admin-only create/update/delete.
 * - /users/{userId}/notifications/{notificationId}: User-specific notifications, accessible
 *   only to the user.
 * - /roles_admin/{uid}: Database-Based Access Control (DBAC) collection used to grant admin roles.
 *
 * @Key Security Decisions:
 * - **Denormalization for Authorization**:  The `authorId` field is denormalized in Questions and Answers to avoid costly `get()` calls for ownership checks.
 * - **DBAC for Admin Roles**: Admin privileges are determined by the existence of a document in `/roles_admin/{uid}`, not by custom claims.
 * - **No User Listing**: The rules explicitly prevent listing all users in the `/users` collection.
 * - **Read-only Collections**: The `/tags` and `/knowledge_base_articles` collections are publicly readable but only writable by admins.
 *
 * @Denormalization for Authorization:
 *   - Questions and Answers both contain the `authorId` field to simplify ownership checks, avoiding expensive `get()` operations to fetch user data.
 *
 * @Structural Segregation:
 *   - User-specific data (notifications) is stored in subcollections under `/users/{userId}` for easy security scoping.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description: Checks if the current user is signed in.
     * @return: True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description: Checks if the current user's ID matches the provided user ID.
     * @param userId: The user ID to compare against.
     * @return: True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description: Checks if the user is an existing owner of a resource.
     *               This combines the ownership check with an existence check for updates/deletes.
     * @param userId: The user ID to compare against.
     * @return: True if the user is the owner and the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description: Checks if the user is an admin based on the existence of a document in `/roles_admin/{uid}`.
     * @return: True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /******************** USERS ********************/

    /**
     * @description: Manages user profiles.
     * @path: /users/{userId}
     * @allow: (create) If the user is creating their own profile (userId matches auth.uid).
     * @allow: (get, update, delete) If the user is the owner of the profile or an admin.
     * @deny: (create) If the user ID in the path does not match the authenticated user's ID.
     * @deny: (list) Listing all users is not permitted for security reasons.
     * @principle: Enforces user-based ownership and prevents unauthorized access to user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false; // Prevent listing all users

      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) || isAdmin() && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /******************** QUESTIONS ********************/

    /**
     * @description: Manages community forum questions.
     * @path: /questions/{questionId}
     * @allow: (get, list) Public read access for all questions.
     * @allow: (create) If the authorId matches the authenticated user's ID.
     * @allow: (update, delete) If the user is the author of the question or an admin.
     * @deny: (update, delete) If the user is not the author and not an admin.
     * @principle: Provides public read access while restricting write access to the author or admins.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if (resource.data.authorId == request.auth.uid && resource != null) || isAdmin();
      allow delete: if (resource.data.authorId == request.auth.uid && resource != null) || isAdmin();
    }

    /******************** ANSWERS ********************/

    /**
     * @description: Manages answers to questions.
     * @path: /questions/{questionId}/answers/{answerId}
     * @allow: (get, list) Public read access for all answers.
     * @allow: (create) If the authorId matches the authenticated user's ID.
     * @allow: (update, delete) If the user is the author of the answer or an admin.
     * @deny: (update, delete) If the user is not the author and not an admin.
     * @principle: Provides public read access while restricting write access to the author or admins.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if (resource.data.authorId == request.auth.uid && resource != null) || isAdmin();
      allow delete: if (resource.data.authorId == request.auth.uid && resource != null) || isAdmin();
    }

    /******************** KNOWLEDGE BASE ARTICLES ********************/

    /**
     * @description: Manages knowledge base articles.
     * @path: /knowledge_base_articles/{articleId}
     * @allow: (get, list) Public read access for all articles.
     * @allow: (create, update, delete) Only admins can create, update, or delete articles.
     * @deny: (create, update, delete) Non-admins cannot modify knowledge base articles.
     * @principle: Restricts write access to admins, allowing public read access.
     */
    match /knowledge_base_articles/{articleId} {
      allow get, list: if true;
      allow create: if isAdmin() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /******************** TAGS ********************/

    /**
     * @description: Manages tags for questions and articles.
     * @path: /tags/{tagId}
     * @allow: (get, list) Public read access for all tags.
     * @allow: (create, update, delete) Only admins can create, update, or delete tags.
     * @deny: (create, update, delete) Non-admins cannot modify tags.
     * @principle: Restricts write access to admins, allowing public read access.
     */
    match /tags/{tagId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /******************** NOTIFICATIONS ********************/

    /**
     * @description: Manages user-specific notifications.
     * @path: /users/{userId}/notifications/{notificationId}
     * @allow: (get, list) If the user is the owner of the notification or an admin.
     * @allow: (create, update, delete) If the user is the owner of the notification or an admin.
     * @deny: (create, update, delete) If the user is not the owner and not an admin.
     * @principle: Restricts access to a user's own notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if (isExistingOwner(userId) || isAdmin()) && request.resource.data.userId == userId;
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /******************** ADMIN ROLES (DBAC) ********************/

    /**
     * @description: Manages admin roles using DBAC (Database-Based Access Control).
     * @path: /roles_admin/{uid}
     * @allow: (get) Only admins can read the existence of other admins.
     * @allow: (create, delete) Only admins can grant or revoke admin roles.
     * @deny: All operations for non-admins.
     * @principle: Implements role-based access control using the presence of documents in a dedicated collection.
     */
     match /roles_admin/{uid} {
      allow get: if isAdmin();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
      allow list: if false;
    }
  }
}