/**
 * @file Firebase Security Rules for MUBAS Community Hub
 * @version Prototyping
 *
 * @Core Philosophy:
 * This ruleset enforces a user-ownership model for personal data and a role-based model for administrative functions.
 * Public read access is granted to certain collections (e.g., questions, knowledge base articles) while write access is restricted to owners or administrators.
 *
 * @Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the user themselves.
 * - /questions/{questionId}: Stores questions, publicly readable, but writable only by the author.
 * - /questions/{questionId}/answers/{answerId}: Stores answers to questions, publicly readable, but writable only by the answer's author.
 * - /knowledge_base_articles/{articleId}: Stores knowledge base articles, publicly readable, writable only by admins.
 * - /tags/{tagId}: Stores tags, publicly readable, writable only by admins.
 * - /users/{userId}/notifications/{notificationId}: Stores notifications, accessible only to the user themselves.
 * - /roles_admin/{uid}: Indicates admin status; its existence grants admin privileges.
 *
 * @Key Security Decisions:
 * - User listing is implicitly disallowed.
 * - The existence of a document in `/roles_admin/{uid}` determines admin status (Database-Based Access Control).
 * - Read-only collections like `tags` are publicly readable.
 * - Data validation is relaxed in this prototyping phase, focusing on ownership and relational integrity.
 *
 * @Denormalization for Authorization:
 * - The `Question` and `Answer` entities include the `authorId` field, allowing for fast ownership checks without additional reads.
 *
 * @Structural Segregation:
 * - Private user data is stored under the `/users/{userId}` path, separate from public collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the resource based on the provided userId.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of the existing resource based on the provided userId and that the resource exists.
     * @param {string} userId - The user ID to compare against the resource's data.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user has admin privileges by checking if the document exists in roles_admin collection.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for /users/{userId} documents.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their own profile document if request.auth.uid == 'user123'.
     * @allow (get, update, delete) - User with UID 'user123' can read, update, and delete their own profile if authenticated as 'user123'.
     * @deny (create) - User with UID 'user456' cannot create a profile for user 'user123'.
     * @deny (update, delete) - User with UID 'user456' cannot update or delete the profile of user 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for /questions/{questionId} documents.
     * @path /questions/{questionId}
     * @allow (get, list) - Any user can read any question.
     * @allow (create) - User with UID 'user123' can create a question with authorId: 'user123'.
     * @allow (update, delete) - User with UID 'user123' can update or delete their own question (authorId: 'user123').
     * @deny (create) - User with UID 'user456' cannot create a question with authorId: 'user123'.
     * @deny (update, delete) - User with UID 'user456' cannot update or delete a question where authorId: 'user123'.
     * @principle Enforces document ownership for writes; allows public reads.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && (isExistingOwner(resource.data.authorId) || isAdmin());
    }

    /**
     * @description Rules for /questions/{questionId}/answers/{answerId} documents.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) - Any user can read any answer to a question.
     * @allow (create) - User with UID 'user123' can create an answer with authorId: 'user123'.
     * @allow (update, delete) - User with UID 'user123' can update or delete their own answer (authorId: 'user123').
     * @deny (create) - User with UID 'user456' cannot create an answer with authorId: 'user123'.
     * @deny (update, delete) - User with UID 'user456' cannot update or delete an answer where authorId: 'user123'.
     * @principle Enforces document ownership for writes; allows public reads.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && (isExistingOwner(resource.data.authorId) || isAdmin());
    }

    /**
     * @description Rules for /knowledge_base_articles/{articleId} documents.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) - Any user can read any knowledge base article.
     * @allow (create, update, delete) - Only admins can create, update, or delete knowledge base articles.
     * @deny (create, update, delete) - User with UID 'user123' cannot create, update, or delete knowledge base articles if not an admin.
     * @principle Restricts write access to admins; allows public reads.
     */
    match /knowledge_base_articles/{articleId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for /tags/{tagId} documents.
     * @path /tags/{tagId}
     * @allow (get, list) - Any user can read any tag.
     * @allow (create, update, delete) - Only admins can create, update, or delete tags.
     * @deny (create, update, delete) - User with UID 'user123' cannot create, update, or delete tags if not an admin.
     * @principle Restricts write access to admins; allows public reads.
     */
    match /tags/{tagId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for /users/{userId}/notifications/{notificationId} documents.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get) - User with UID 'user123' can get their own notifications if authenticated as 'user123'.
     * @allow (list) - User with UID 'user123' can list their own notifications if authenticated as 'user123'.
     * @allow (create) - User with UID 'user123' can create notifications for themselves.
     * @allow (update, delete) - User with UID 'user123' can update or delete their own notifications if authenticated as 'user123'.
     * @deny (get, list, create, update, delete) - User with UID 'user456' cannot access or modify notifications for user 'user123'.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for /roles_admin/{uid} documents.
     * @path /roles_admin/{uid}
     * @allow (get, create, update, delete) - Only admins can create, update, or delete admin roles.  An admin can only grant admin role to themselves.
     * @allow (list) - No one can list the roles.
     * @deny (get, create, update, delete) - User with UID 'user123' cannot become admin if not already one.
     * @principle Database-Based Access Control for admin roles.
     */
    match /roles_admin/{uid} {
       allow get: if isAdmin();
       allow list: if false;
       allow create: if isAdmin() && request.auth.uid == uid;
       allow update: if false;
       allow delete: if isAdmin();
    }
  }
}