/**
 * @file Firebase Security Rules for MUBAS Community Hub
 * @description This ruleset enforces a role-based access control system with ownership checks,
 *              restricting data access based on user authentication and predefined roles.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the user and admins.
 * - /questions/{questionId}: Community forum questions, readable by everyone, but
 *                             updatable/deletable only by the author or an admin.
 * - /questions/{questionId}/answers/{answerId}: Answers to questions, following the
 *                                              same access control as questions.
 * - /knowledge_base_articles/{articleId}: Knowledge base articles, readable by everyone,
 *                                         but writable only by admins. The `authorId`
 *                                         field must match the authenticated user's ID on creation.
 * - /tags/{tagId}: Tags for questions and articles, readable by everyone, writable only by admins.
 * - /users/{userId}/notifications/{notificationId}: User-specific notifications, accessible
 *                                                  only to the user and admins.
 * - /roles_admin/{uid}: Indicates admin status. Presence of a document grants admin privileges.
 *
 * Key Security Decisions:
 * - User listing is disabled to protect user privacy.
 * - Admin privileges are determined by the existence of a document in /roles_admin/{uid}.
 * - Public read access is granted to questions, answers, knowledge base articles, and tags.
 * - Write access is strictly controlled based on ownership or admin roles.
 *
 * Denormalization for Authorization:
 * - Questions and answers include the `authorId` field for easy ownership checks.
 *
 * Structural Segregation:
 * - User-specific data (notifications) is stored under the /users/{userId} path.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the document.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     * @returns {boolean} True if the user is the owner, false otherwise.
     * @example isOwner('someUserId') will return true if request.auth.uid == 'someUserId'.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the document and if the document exists.
     *              This is used for update and delete operations to prevent acting on non-existent documents.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     * @returns {boolean} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the authenticated user has admin privileges.
     *              Admin status is determined by the existence of a document in /roles_admin/{uid}.
     * @returns {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) - User with matching ID can create their own profile.
     * @allow (get, update, delete) - Owner and admins can read, update, and delete the user profile.
     * @deny (list) - User listing is not allowed.
     * @deny (create) - User cannot create another user's profile.
     * @principle Enforces document ownership for writes; restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for community forum questions.
     * @path /questions/{questionId}
     * @allow (get, list) - Anyone can read and list questions.
     * @allow (create) - Any signed-in user can create a question. `authorId` must match their UID.
     * @allow (update, delete) - Only the author or an admin can update or delete the question.
     * @deny (create) - If authorId does not match their UID.
     * @principle Enforces document ownership for writes; allows public read access.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && resource != null;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && resource != null;
    }

    /**
     * @description Rules for answers to questions.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) - Anyone can read and list answers to a question.
     * @allow (create) - Any signed-in user can create an answer. `authorId` must match their UID.
     * @allow (update, delete) - Only the author or an admin can update or delete the answer.
     * @deny (create) - If authorId does not match their UID.
     * @principle Enforces document ownership for writes; allows public read access.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && resource != null;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && resource != null;
    }

    /**
     * @description Rules for knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) - Anyone can read and list knowledge base articles.
     * @allow (create, update, delete) - Only admins can create, update, or delete articles.
     * @deny (create) - If the `authorId` field does not match the authenticated user's ID.
     * @principle Restricts write access to admins; allows public read access.
     */
    match /knowledge_base_articles/{articleId} {
      allow get, list: if true;
      allow create: if isAdmin() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for tags.
     * @path /tags/{tagId}
     * @allow (get, list) - Anyone can read and list tags.
     * @allow (create, update, delete) - Only admins can create, update, or delete tags.
     * @principle Restricts write access to admins; allows public read access.
     */
    match /tags/{tagId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for user-specific notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list) - Only the user and admins can access these notifications.
     * @allow (create) - Only the owner of the user id is allowed to create the notification
     * @allow (update, delete) - Only the user and admins can update or delete notifications.
     * @principle Enforces document ownership for reads and writes; restricts access to a user's own data.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

      /**
     * @description Rules for admin roles.
     * @path /roles_admin/{uid}
     * @allow (get) - Only the admin is allowed to get access to their role.
     * @allow (create) - N/A.
     * @allow (update, delete) - N/A.
     * @allow list: if false;
     * @principle  Marks a user as an admin. The existence of a document at this path grants admin privileges. Authorization based on document existence rather than content.
     */
    match /roles_admin/{uid} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}