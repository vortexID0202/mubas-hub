rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin.
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- User Profiles ---
    match /users/{userId} {
      // Users can read their own profile.
      allow get: if request.auth.uid == userId;
      // Users can create their own profile upon signup.
      allow create: if request.auth.uid == userId;
      // Users can update their own profile (e.g., name, avatar).
      allow update: if request.auth.uid == userId;
    }

    // --- Questions and Answers ---
    match /questions/{questionId} {
      // Any logged-in user can read questions.
      allow get, list: if request.auth != null;
      // A logged-in user can create a question if they are the author.
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      // The author of a question can update it. Admins can also update.
      allow update: if (resource.data.authorId == request.auth.uid) || isAdmin();
      // The author of a question can delete it. Admins can also delete.
      allow delete: if (resource.data.authorId == request.auth.uid) || isAdmin();

      // --- Answers Subcollection ---
      match /answers/{answerId} {
        // Any logged-in user can read answers.
        allow get, list: if request.auth != null;
        // A logged-in user can create an answer if they are the author.
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        // The author of an answer can update it. Admins can also update.
        allow update: if (resource.data.authorId == request.auth.uid) || isAdmin();
         // The author of an answer can delete it. Admins can also delete.
        allow delete: if (resource.data.authorId == request.auth.uid) || isAdmin();
      }
    }

    // --- Knowledge Base Rules ---
    match /knowledge_base_articles/{articleId} {
      // Only admins can write to the knowledge base.
      allow create, update, delete: if isAdmin() && request.resource.data.authorId == request.auth.uid;
      // Any user can read the knowledge base.
      allow get, list: if true;
    }
    
    // --- Live Updates Rules ---
    match /live_updates/{updateId} {
      // Only admins can write to live updates.
      allow create, update, delete: if isAdmin() && request.resource.data.authorId == request.auth.uid;
      // Anyone can read live updates.
      allow get, list: if true;
    }

    // --- Admin Roles ---
    // Admins can manage the admin roles. For simplicity, only admins can see who is an admin.
    match /roles_admin/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
