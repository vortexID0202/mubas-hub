rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Rules for user profiles
    match /users/{userId} {
      // Users can read their own profile, admins can read any profile
      allow read: if request.auth.uid == userId || isAdmin();
      // Users can create and update their own profile
      allow write: if request.auth.uid == userId;
    }

    // Rules for community questions
    match /questions/{questionId} {
      // Any authenticated user can read questions
      allow read: if request.auth != null;
      // Authenticated users can create questions if they are the author
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      // Only the author or an admin can update/delete
      allow update, delete: if resource.data.authorId == request.auth.uid || isAdmin();
    }
    
    // Rules for answers to questions
    match /questions/{questionId}/answers/{answerId} {
        // Any authenticated user can read answers
        allow read: if request.auth != null;
        // Authenticated users can create answers if they are the author
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        // Only the author or an admin can update/delete
        allow update, delete: if resource.data.authorId == request.auth.uid || isAdmin();
    }

    // Rules for knowledge base articles
    match /knowledge_base_articles/{articleId} {
      // Anyone can read knowledge base articles
      allow read: if true;
      // Only admins can create/update/delete
      allow create: if isAdmin() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Rules for live updates
    match /live_updates/{updateId} {
      // Anyone can read live updates
      allow read: if true;
      // Only admins can create updates, and they must be the author
      allow create: if isAdmin() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // Admin roles are managed here
    match /roles_admin/{userId} {
      // Only admins can see who other admins are
      allow read: if isAdmin();
      // Write access should be locked down, managed via Firebase Console
      allow write: if false; 
    }
  }
}