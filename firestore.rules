/**
 * @fileOverview Firestore Security Rules for MUBAS Community Hub.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure access control based on user roles and ownership,
 * with a focus on simplicity and maintainability.  It grants public read access to
 * Questions, Answers and KnowledgeBaseArticles.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only by the user and admins.
 * - /questions/{questionId}: Community forum questions, publicly readable, writable by any authenticated user.
 * - /questions/{questionId}/answers/{answerId}: Answers to questions, publicly readable, writable by any authenticated user.
 * - /knowledge_base_articles/{articleId}: Knowledge base articles, publicly readable, writable by admins only.
 * - /tags/{tagId}: Tags for questions and articles, publicly readable, writable by admins only.
 * - /users/{userId}/notifications/{notificationId}: User-specific notifications, accessible only by the user.
 * - /roles_admin/{uid}: Admin role assignments.  Presence of a document grants admin privileges.
 *
 * Key Security Decisions:
 * - User listing is disabled.
 * - Public read access to questions, answers and knowledge base articles.
 * - Admin privileges are determined by document existence in /roles_admin/{uid}.
 * - Data validation is relaxed for prototyping, focusing on authorization and relational integrity.
 *
 * Denormalization for Authorization:
 * - Questions and Answers include the authorId to easily check ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is an admin based on document existence in /roles_admin/{uid}.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the authenticated user is the owner of the existing document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Grants admin privileges to a user.
     * @path /roles_admin/{uid}
     * @allow (create) User with UID 'admin_uid' can create a document.
     * @deny (create) User with UID 'user_uid' cannot create a document.
     * @principle DBAC (Database-Based Access Control): Admin privileges based on document existence.
     */
    match /roles_admin/{uid} {
        allow get: if isAdmin();
        allow list: if false;
        allow create: if isAdmin();
        allow update: if false;
        allow delete: if isAdmin();
    }

    /**
     * @description Manages user profiles. User data is private and accessible only to the user and admins.
     * @path /users/{userId}
     * @allow (create) User with UID 'user_abc' can create their profile at /users/user_abc.
     * @deny (create) User with UID 'user_abc' cannot create a profile at /users/user_xyz.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false; // User listing is not permitted.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Stores community forum questions. Anyone can read questions, but only the author or an admin can update or delete them.
     * @path /questions/{questionId}
     * @allow (create) Any authenticated user can create a question.
     * @allow (read) Any user can read a question.
     * @deny (update) A non-author attempts to update a question.
     * @principle Public read access with owner-only writes.
     */
    match /questions/{questionId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Stores answers to specific questions, establishing a clear hierarchical relationship. Anyone can read answers to a question, but only the author or an admin can update or delete them.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (create) Any authenticated user can create an answer to a question.
     * @allow (read) Any user can read an answer to a question.
     * @deny (update) A non-author attempts to update an answer.
     * @principle Public read access with owner-only writes in a subcollection.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Stores knowledge base articles. Only admins can create, update, or delete articles. Everyone can read.
     * @path /knowledge_base_articles/{articleId}
     * @allow (read) Any user can read a knowledge base article.
     * @deny (create) A non-admin attempts to create a knowledge base article.
     * @principle Public read access with admin-only writes.
     */
    match /knowledge_base_articles/{articleId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Stores tags that can be associated with questions or knowledge base articles. Tags can be read by anyone, but only admins can create, update, or delete them.
     * @path /tags/{tagId}
     * @allow (read) Any user can read a tag.
     * @deny (create) A non-admin attempts to create a tag.
     * @principle Public read access with admin-only writes.
     */
    match /tags/{tagId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Stores notifications for a specific user. Only the user and admins can access these notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (create) User with UID 'user_abc' can create a notification at /users/user_abc/notifications/notification_123.
     * @deny (create) User with UID 'user_abc' cannot create a notification at /users/user_xyz/notifications/notification_123.
     * @principle Enforces document ownership for writes in a subcollection.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }
  }
}