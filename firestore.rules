/**
 * @fileOverview Firestore Security Rules for the MUBAS Community Hub.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data (e.g., user profiles, notifications) and a public-read, owner-write model for community content (e.g., questions, answers). Administrative privileges are required for managing knowledge base articles and tags.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the user and admins.
 * - /questions/{questionId}: Community forum questions, publicly readable, but only editable by the author or admins.
 * - /questions/{questionId}/answers/{answerId}: Answers to questions, publicly readable, but only editable by the author or admins.
 * - /knowledge_base_articles/{articleId}: Knowledge base articles, publicly readable, but only manageable by admins.
 * - /live_updates/{updateId}: Live updates and announcements, publicly readable, but only creatable by admins.
 * - /tags/{tagId}: Tags for questions and articles, publicly readable, but only manageable by admins.
 * - /users/{userId}/notifications/{notificationId}: User-specific notifications, accessible only to the user and admins.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect user privacy.
 * - Public read access is granted to questions, answers, knowledge base articles, live updates and tags to encourage community participation.
 * - The now deprecated `/roles_admin/{uid}` collection is kept for historical reference and is no longer the source of truth for admin status.
 * - The rule set focuses on authorization and does not validate the data shape.
 *
 * Denormalization for Authorization:
 * The `authorId` field is denormalized into the `Question` and `Answer` documents to enable efficient ownership checks without requiring additional `get()` operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (read, write) if the user is the owner of the profile (userId matches request.auth.uid).
     * @deny (read, write) if the user is not the owner of the profile.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      //function isSelf(userId) {
      //  return request.auth.uid == userId;
      //}

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Disallowing user listing for privacy.
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to community forum questions.
     * @path /questions/{questionId}
     * @allow (read) anyone can read questions.
     * @allow (create) any authenticated user can create a question. The authorId on the request must match the user id.
     * @allow (update, delete) only the author of the question can update or delete it.
     * @deny (update, delete) if the user is not the author of the question.
     * @principle Allows public read access to questions, but restricts write access to the author.
     */
    match /questions/{questionId} {
      function isOwner() {
        return resource.data.authorId == request.auth.uid;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }

    /**
     * @description Controls access to answers for specific questions.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (read) anyone can read answers.
     * @allow (create) any authenticated user can create an answer. The authorId on the request must match the user id.
     * @allow (update, delete) only the author of the answer can update or delete it.
     * @deny (update, delete) if the user is not the author of the answer.
     * @principle Allows public read access to answers, but restricts write access to the author.
     */
    match /questions/{questionId}/answers/{answerId} {
      function isOwner() {
        return resource.data.authorId == request.auth.uid;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }

    /**
     * @description Controls access to knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (read) anyone can read knowledge base articles.
     * @deny (create, update, delete) only admins can create, update, or delete knowledge base articles.
     * @principle Restricts write access to knowledge base articles to admins only.
     */
    match /knowledge_base_articles/{articleId} {
      function isAdmin() {
        return request.auth.token.admin == true;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Controls access to live updates.
     * @path /live_updates/{updateId}
     * @allow (read) anyone can read live updates.
     * @deny (create) only admins can create live updates.
     * @deny (update, delete) updates and deletes are disallowed.
     * @principle Restricts creation of live updates to admins only.
     */
    match /live_updates/{updateId} {
      function isAdmin() {
        return request.auth.token.admin == true;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to tags.
     * @path /tags/{tagId}
     * @allow (read) anyone can read tags.
     * @deny (create, update, delete) only admins can create, update, or delete tags.
     * @principle Restricts management of tags to admins only.
     */
    match /tags/{tagId} {
      function isAdmin() {
        return request.auth.token.admin == true;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Controls access to notifications for a specific user.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (read, write) if the user is the owner of the notifications (userId matches request.auth.uid).
     * @deny (read, write) if the user is not the owner of the notifications.
     * @principle Enforces document ownership for notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description DEPRECATED: Admin roles are now managed via custom claims. The existence of a document at this path previously granted admin privileges. This is kept for historical reference but is no longer the source of truth for admin status.
     * @path /roles_admin/{uid}
     * @principle This collection is deprecated and access is not managed.
     */
     match /roles_admin/{uid}{
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}