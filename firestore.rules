/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for personal data,
 *              public read access for community content, and role-based access control for administrative functions.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the user and admins.
 * - /questions/{questionId}: Community questions, publicly readable, writable only by the author.
 * - /questions/{questionId}/answers/{answerId}: Answers to questions, publicly readable, writable only by the author.
 * - /knowledge_base_articles/{articleId}: Knowledge base articles, publicly readable, writable only by admins.
 * - /tags/{tagId}: Tags for questions and articles, publicly readable, writable only by admins.
 * - /users/{userId}/notifications/{notificationId}: User-specific notifications, accessible only to the user.
 * - /roles_admin/{uid}: Admin role assignments. Existence of a document grants admin privileges.
 *
 * Key Security Decisions:
 * - Users can only access their own data under /users/{userId}.
 * - Questions and answers are publicly readable but writable only by the author.
 * - Knowledge base articles and tags are publicly readable but writable only by admins.
 * - Notifications are private to the user.
 * - Admin privileges are granted based on the existence of a document in the /roles_admin/{uid} collection.
 * - Listing the entire database is disallowed to prevent information leakage.
 *
 * Denormalization for Authorization:
 * - The 'questions' and 'answers' collections contain the 'authorId' field to avoid costly `get()` calls for authorization checks.
 * - Roles are managed via document existence in `/roles_admin/{uid}`.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided user ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is an admin by checking for a document in `/roles_admin/{uid}`.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the user is the owner of the existing resource.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rule for root access - Denies listing the entire database.
     * @path /databases/{database}/documents
     * @allow N/A - Listing the entire database is not permitted.
     * @deny (list) - Attempting to list the entire database.
     * @principle Prevents unauthorized discovery of data structure and content.
     */
    match /{document=**} {
        allow list: if false;
    }

    /**
     * @description Manages user profiles.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' creates their own profile.
     * @allow (get) - User with UID 'user123' reads their own profile.
     * @allow (update) - User with UID 'user123' updates their own profile.
     * @allow (delete) - User with UID 'user123' deletes their own profile.
     * @deny (create) - User with UID 'user456' attempts to create a profile for 'user123'.
     * @deny (update) - User with UID 'user456' attempts to update the profile of 'user123'.
     * @deny (delete) - User with UID 'user456' attempts to delete the profile of 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false; // User listing is not permitted.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Manages community forum questions.
     * @path /questions/{questionId}
     * @allow (get) - Any user reads question with ID 'question123'.
     * @allow (list) - Any user lists questions.
     * @allow (create) - User with UID 'user123' creates a question with authorId 'user123'.
     * @allow (update) - User with UID 'user123' updates a question they authored (authorId 'user123').
     * @allow (delete) - User with UID 'user123' deletes a question they authored (authorId 'user123').
     * @deny (create) - User with UID 'user456' attempts to create a question with authorId 'user123'.
     * @deny (update) - User with UID 'user456' attempts to update a question authored by 'user123'.
     * @deny (delete) - User with UID 'user456' attempts to delete a question authored by 'user123'.
     * @principle Enforces document ownership for writes, allows public read access.
     */
    match /questions/{questionId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
    }

    /**
     * @description Manages answers to specific questions.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get) - Any user reads answer with ID 'answer123' under question 'question123'.
     * @allow (list) - Any user lists answers under question 'question123'.
     * @allow (create) - User with UID 'user123' creates an answer with authorId 'user123' under question 'question123'.
     * @allow (update) - User with UID 'user123' updates an answer they authored (authorId 'user123') under question 'question123'.
     * @allow (delete) - User with UID 'user123' deletes an answer they authored (authorId 'user123') under question 'question123'.
     * @deny (create) - User with UID 'user456' attempts to create an answer with authorId 'user123' under question 'question123'.
     * @deny (update) - User with UID 'user456' attempts to update an answer authored by 'user123' under question 'question123'.
     * @deny (delete) - User with UID 'user456' attempts to delete an answer authored by 'user123' under question 'question123'.
     * @principle Enforces document ownership for writes, allows public read access, maintains hierarchical data integrity.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
    }

    /**
     * @description Manages knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get) - Any user reads article with ID 'article123'.
     * @allow (list) - Any user lists articles.
     * @allow (create) - Admin creates an article.
     * @allow (update) - Admin updates article.
     * @allow (delete) - Admin deletes article.
     * @deny (create) - Non-admin attempts to create an article.
     * @deny (update) - Non-admin attempts to update article.
     * @deny (delete) - Non-admin attempts to delete article.
     * @principle Restricts write access to admins, allows public read access.
     */
    match /knowledge_base_articles/{articleId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Manages tags.
     * @path /tags/{tagId}
     * @allow (get) - Any user reads tag with ID 'tag123'.
     * @allow (list) - Any user lists tags.
     * @allow (create) - Admin creates a tag.
     * @allow (update) - Admin updates tag.
     * @allow (delete) - Admin deletes tag.
     * @deny (create) - Non-admin attempts to create a tag.
     * @deny (update) - Non-admin attempts to update tag.
     * @deny (delete) - Non-admin attempts to delete tag.
     * @principle Restricts write access to admins, allows public read access.
     */
    match /tags/{tagId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Manages notifications for a specific user.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get) - User with UID 'user123' reads their notification with ID 'notification123'.
     * @allow (list) - User with UID 'user123' lists their notifications.
     * @allow (create) - User with UID 'user123' creates a notification for themselves.
     * @allow (update) - User with UID 'user123' updates their notification with ID 'notification123'.
     * @allow (delete) - User with UID 'user123' deletes their notification with ID 'notification123'.
     * @deny (create) - User with UID 'user456' attempts to create a notification for 'user123'.
     * @deny (update) - User with UID 'user456' attempts to update a notification for 'user123'.
     * @deny (delete) - User with UID 'user456' attempts to delete a notification for 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

     /**
      * @description Marks a user as an admin.
      * @path /roles_admin/{uid}
      * @allow (create) - Allowed only with specific backend logic, not directly through rules.
      * @allow (get) - Only admins can read the role assignments.
      * @allow (update) - Not allowed. Admin roles should be managed through creation/deletion of documents.
      * @allow (delete) - Only allowed with specific backend logic.
      * @deny (create) -  Non-admin attempts to create a role.
      * @deny (update) - Non-admin attempts to update a role.
      * @deny (delete) - Non-admin attempts to delete a role.
      * @principle DBAC (Database-Based Access Control): Admin privileges are granted based on the existence of a document in this collection.
      */
     match /roles_admin/{uid} {
        allow get: if isAdmin();
        allow list: if false;
        allow create: if isAdmin();
        allow update: if false;
        allow delete: if isAdmin();
     }
  }
}