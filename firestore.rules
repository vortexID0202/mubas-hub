/**
 * @file Firebase Security Rules for the MUBAS Community Hub.
 * @description This ruleset enforces a role-based access control model with ownership where appropriate.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the user and admins.
 * - /questions/{questionId}: Community forum questions, readable by all, writable by the author and admins.
 * - /questions/{questionId}/answers/{answerId}: Answers to questions, readable by all, writable by the author and admins.
 * - /knowledge_base_articles/{articleId}: Knowledge base articles, readable by all, writable only by admins.
 * - /tags/{tagId}: Tags for questions and articles, readable by all, writable only by admins.
 * - /users/{userId}/notifications/{notificationId}: Notifications for users, accessible only to the user and admins.
 * - /roles_admin/{uid}: Indicates admin status. Document existence grants admin privileges.
 *
 * Key Security Decisions:
 * - Admin privileges are determined by the presence of a document in the /roles_admin/{uid} collection.
 * - User listing is implicitly denied.
 * - Read access is generally open unless specifically restricted.
 *
 * Denormalization for Authorization:
 * - The `authorId` field is denormalized in the `Question` and `Answer` entities to simplify ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user's ID matches the provided user ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is an admin.
     * @details Admin status is determined by the existence of a document in the /roles_admin/{uid} collection.
     */
    function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the current user is the existing owner of a document.
     * @details Combines the ownership check with a document existence check for safer updates and deletes.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     *   request.auth.uid == 'user123'
     * @allow (get) User with ID 'user123' can read their profile.
     *   request.auth.uid == 'user123'
     * @deny (update) User with ID 'user456' cannot update user 'user123' profile.
     *   request.auth.uid != 'user123'
     * @principle Enforces document ownership for writes, restricts read access to owner or admin.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if false; // User deletion should be handled carefully, likely via admin function

    }

    /**
     * @description Rules for community forum questions.
     * @path /questions/{questionId}
     * @allow (create) User with ID 'user123' can create a question with authorId 'user123'.
     *   request.auth.uid == 'user123'
     * @allow (get) Anyone can read a question.
     * @allow (update) User with ID 'user123' can update a question if they are the author (authorId == 'user123').
     *   request.auth.uid == 'user123'
     * @deny (update) User with ID 'user456' cannot update a question authored by 'user123'.
     *   request.auth.uid != 'user123'
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /questions/{questionId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Rules for answers to questions.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (create) User with ID 'user123' can create an answer with authorId 'user123'.
     *   request.auth.uid == 'user123'
     * @allow (get) Anyone can read an answer.
     * @allow (update) User with ID 'user123' can update an answer if they are the author (authorId == 'user123').
     *   request.auth.uid == 'user123'
     * @deny (update) User with ID 'user456' cannot update an answer authored by 'user123'.
     *   request.auth.uid != 'user123'
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Rules for knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get) Anyone can read a knowledge base article.
     * @allow (create) Only admins can create knowledge base articles.
     * @deny (create) Non-admin user tries to create a knowledge base article.
     *   request.auth.uid == 'user123'
     * @principle Restricts write access to admins, allows public reads.
     */
    match /knowledge_base_articles/{articleId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin() && request.resource.data.authorId == request.auth.uid; // Enforce the authorId to be the admin creating the article
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for tags.
     * @path /tags/{tagId}
     * @allow (get) Anyone can read a tag.
     * @allow (create) Only admins can create tags.
     * @deny (create) Non-admin user tries to create a tag.
     *   request.auth.uid == 'user123'
     * @principle Restricts write access to admins, allows public reads.
     */
    match /tags/{tagId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for notifications for a specific user.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get) User with ID 'user123' can read their notification.
     *   request.auth.uid == 'user123'
     * @deny (update) User with ID 'user456' cannot update user 'user123' notification.
     *   request.auth.uid != 'user123'
     * @principle Enforces document ownership for writes, restricts read access to owner or admin.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) ;
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for admin roles.
     * @path /roles_admin/{uid}
     * @allow (create) Anyone can create a role, existence grants admin privilege.
     *   request.auth.uid == 'admin123'
     * @principle DBAC: Document existence confers admin privileges.
     */
    match /roles_admin/{uid} {
        //This path serves as a flag, its existence grants Admin rights
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}