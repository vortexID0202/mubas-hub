rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow reads on most collections by default
    match /{collection}/{docId} {
      allow read: if true;

      // Allow authenticated users to create questions or articles if they are the author.
      allow create: if (collection == 'questions' || collection == 'knowledge_base_articles')
                    && request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
    }

    // Rules for answers to questions
    match /questions/{questionId}/answers/{answerId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // Users can only see and edit their own profile
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
    }

    // Notifications are private
    match /users/{userId}/notifications/{notificationId} {
       allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
