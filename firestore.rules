/**
 * @file Firebase Security Rules for MUBAS Community Hub
 * @core_philosophy This ruleset enforces a strict, role-based access control model,
 *  combined with user-ownership where appropriate.  It leverages denormalization
 *  for authorization checks to minimize read operations and improve performance.
 * @data_structure
 *  - /users/{userId}: Stores user profiles, accessible only to the user and admins.
 *  - /questions/{questionId}: Stores questions, readable by all, but updatable only by the author or admins.
 *  - /questions/{questionId}/answers/{answerId}: Stores answers to questions, readable by all, updatable only by the author or admins.
 *  - /knowledge_base_articles/{articleId}: Stores knowledge base articles, readable by all, but manageable only by admins.
 *  - /tags/{tagId}: Stores tags, readable by all, but manageable only by admins.
 *  - /users/{userId}/notifications/{notificationId}: Stores user-specific notifications, accessible only to the user.
 *  - /roles_admin/{uid}: Used for role-based access control. Existence of a document grants admin privileges.
 * @key_security_decisions
 *  - User listing is not allowed to protect user privacy.
 *  - Public read access is granted to questions, answers, knowledge base articles, and tags, enabling community participation and content discovery.
 *  - Authorization relies on the existence of a document in `/roles_admin/{uid}` to grant admin privileges.
 * @denormalization_for_authorization
 *  - Questions and answers include the `authorId` field to allow for simple ownership checks without additional reads.
 * @structural_segregation
 *  - User-specific data (e.g., notifications) is stored in user subcollections to ensure privacy and simplify access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document.
     * @param {string} userId The user ID to compare against the request's auth UID.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the document, and the document exists.
     * @param {string} userId The user ID to compare against the resource's data.
     * @return {bool} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

        /**
     * @description Checks if the user is an admin by verifying the existence of a document in the roles_admin collection.
     * @return {bool} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
            return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Defines the read permissions for the entire database.
     * @return {bool} True if read is allowed, false otherwise.
     */
    function allowDatabaseRead() {
            return true;
    }

    /**
     * @description Defines the write permissions for the entire database.
     * @return {bool} True if write is allowed, false otherwise.
     */
    function denyDatabaseWrite() {
            return false;
    }

    /**
     * @description Rules for /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) - User with matching userId can create their own profile.
     * @allow (get, update, delete) - User with matching userId can access and modify their own profile. Admin users can get, update and delete any profile.
     * @deny (create) - User attempts to create a profile with a userId that doesn't match their own.
     * @deny (list) - Listing all users is not allowed.
     * @principle Enforces document ownership and prevents unauthorized access to user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId) && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for /questions/{questionId} collection.
     * @path /questions/{questionId}
     * @allow (get, list) - Any user can read questions.
     * @allow (create) - Any signed-in user can create a question with their userId as the authorId.
     * @allow (update, delete) - Only the author or an admin can update/delete a question.
     * @deny (create) - User attempts to create a question with an authorId that doesn't match their own.
     * @principle Public read access, owner-only writes, and admin override.
     */
    match /questions/{questionId} {
      allow get, list: if allowDatabaseRead();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
    }

    /**
     * @description Rules for /questions/{questionId}/answers/{answerId} subcollection.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) - Any user can read answers to a question.
     * @allow (create) - Any signed-in user can create an answer with their userId as the authorId and the questionId matching the parent question.
     * @allow (update, delete) - Only the author or an admin can update/delete an answer.
     * @deny (create) - User attempts to create an answer with an authorId that doesn't match their own or a questionId that doesn't match the parent.
     * @principle Public read access, owner-only writes with parent-child relationship validation, and admin override.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get, list: if allowDatabaseRead();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;// && request.resource.data.questionId == questionId;
      allow update: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
    }

    /**
     * @description Rules for /knowledge_base_articles/{articleId} collection.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) - Any user can read knowledge base articles.
     * @allow (create, update, delete) - Only admins can create, update, or delete articles.
     * @deny (create, update, delete) - Non-admin users cannot create, update, or delete articles.
     * @principle Admin-only writes, public reads.
     */
    match /knowledge_base_articles/{articleId} {
      allow get, list: if allowDatabaseRead();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for /tags/{tagId} collection.
     * @path /tags/{tagId}
     * @allow (get, list) - Any user can read tags.
     * @allow (create, update, delete) - Only admins can create, update, or delete tags.
     * @deny (create, update, delete) - Non-admin users cannot create, update, or delete tags.
     * @principle Admin-only writes, public reads.
     */
    match /tags/{tagId} {
      allow get, list: if allowDatabaseRead();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for /users/{userId}/notifications/{notificationId} subcollection.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list) - Only the user can access their own notifications.
     * @allow (create) - Only the user can create notifications for themselves.
     * @allow (update, delete) - Only the user can update/delete their own notifications.
     * @deny (create) - User attempts to create a notification with a userId that doesn't match their own.
     * @principle Enforces document ownership for notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
     /**
     * @description Rules for /roles_admin/{uid} collection.
     * @path /roles_admin/{uid}
     * @allow (get) - Public read access to determine admin status.
     * @allow (create) - Only the backend (or admin SDK) can create these documents.
     * @allow (update, delete) - Only the backend (or admin SDK) can update/delete these documents.
     * @deny (create, update, delete) - Clients should not be able to modify the admin roles.
     * @principle Database-Based Access Control (DBAC) for admin privileges.
     */
    match /roles_admin/{uid} {
          allow get: if true;
          allow list: if false; // No client listing allowed.
          allow create: if false;
          allow update: if false;
          allow delete: if false;
    }
  }
}