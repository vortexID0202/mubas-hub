rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Rules for questions
    // Allow public read for lists and individual documents.
    // Restrict creating, updating, deleting to authenticated users.
    match /questions/{questionId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Rules for answers within a question
      // Allow public read, but only authenticated users can write.
      match /answers/{answerId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Rules for users
    // A user can read and update their own profile.
    // No one can list all users.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Rules for knowledge base articles
    // Everyone can read, but only admins can write (future-proofing).
    match /knowledge_base_articles/{articleId} {
      allow read: if true;
      allow write: if false; // To be implemented with admin roles
    }

    // Rules for tags
    // Everyone can read.
    match /tags/{tagId} {
      allow read: if true;
      allow write: if false; // To be implemented with admin roles
    }
  }
}
