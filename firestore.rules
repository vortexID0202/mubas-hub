/**
 * @file Firebase Security Rules for MUBAS Community Hub
 *
 * @corePhilosophy This ruleset enforces a strict user-ownership model for personal data,
 * while allowing public read access to community content. Administrative privileges are
 * required for managing core data like knowledge base articles and tags. Authorization
 * decisions are made based on the authenticated user's UID and data denormalization.
 *
 * @dataStructure
 * - /users/{userId}: User profiles, accessible only to the user and admins.
 * - /questions/{questionId}: Community forum questions, publicly readable, writable by the author.
 * - /questions/{questionId}/answers/{answerId}: Answers to questions, publicly readable, writable by the author.
 * - /knowledge_base_articles/{articleId}: Knowledge base articles, publicly readable, writable by admins.
 * - /live_updates/{updateId}: Live updates, publicly readable, writable by admins.
 * - /tags/{tagId}: Tags for questions/articles, publicly readable, writable by admins.
 * - /users/{userId}/notifications/{notificationId}: User-specific notifications, accessible only to the user.
 *
 * @keySecurityDecisions
 * - User listing is disabled to protect privacy.
 * - Admin status is determined by the existence of an admin claim on the user's token.
 * - Public read access is granted to forum questions, answers, knowledge base articles,
 *   and live updates to foster community engagement.
 * - Data validation is limited to fields critical for authorization and relational integrity.
 *
 * @denormalizationForAuthorization
 * - The `authorId` field is present on Question and Answer documents to enable owner-based access control without additional `get()` calls.
 *
 * @structuralSegregation
 * - Publicly readable content (questions, answers, articles) is stored in top-level collections, while private user data (profiles, notifications) is stored under the `/users/{userId}` path.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @example isSignedIn() returns true if request.auth != null, false otherwise.
     * @principle Ensures only authenticated users can perform certain actions.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the resource, using a userId.
     * @param {string} userId The user ID to compare against the request's auth UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     * @example isOwner('user123') returns true if request.auth.uid == 'user123'.
     * @principle Enforces user-specific data access.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is an existing owner of the resource.
     * @param {string} userId The user ID to compare against the request's auth UID.
     * @return {boolean} True if the user is signed in, is the owner, and the resource exists.
     * @example isExistingOwner('user123') returns true if request.auth.uid == 'user123' and the resource exists.
     * @principle Enforces user-specific data access for existing documents.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the current user has the 'admin' custom claim.
     * @return {boolean} True if the user has the 'admin' claim, false otherwise.
     * @example isAdmin() returns true if request.auth.token.admin == true.
     * @principle Grants elevated privileges to administrators.
     */
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) User 'user123' can create their profile if request.auth.uid == 'user123'.
     * @allow (get, update, delete) User 'user123' can get, update, and delete their profile.
     * @deny (create) User 'user456' cannot create a profile with userId 'user123'.
     * @deny (get, update, delete) User 'user456' cannot get, update, and delete user 'user123's profile.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false; // User listing is disabled for privacy.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for community forum questions.
     * @path /questions/{questionId}
     * @allow (get, list) Anyone can read questions.
     * @allow (create) User 'user123' can create a question with authorId 'user123'.
     * @allow (update, delete) User 'user123' can update/delete their question if they are the author or an admin.
     * @deny (create) User 'user456' cannot create a question with authorId 'user123'.
     * @deny (update, delete) User 'user456' cannot update/delete user 'user123's question.
     * @principle Public read access with owner-only writes.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && resource != null;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && resource != null;
    }

    /**
     * @description Rules for answers to questions.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) Anyone can read answers to a question.
     * @allow (create) User 'user123' can create an answer with authorId 'user123'.
     * @allow (update, delete) User 'user123' can update/delete their answer if they are the author or an admin.
     * @deny (create) User 'user456' cannot create an answer with authorId 'user123'.
     * @deny (update, delete) User 'user456' cannot update/delete user 'user123's answer.
     * @principle Public read access with owner-only writes, within a hierarchical data structure.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && resource != null;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && resource != null;
    }

    /**
     * @description Rules for knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) Anyone can read knowledge base articles.
     * @allow (create, update, delete) Only admins can create, update, or delete articles.
     * @deny (create, update, delete) Non-admins cannot create, update, or delete articles.
     * @principle Public read access with admin-only writes.
     */
    match /knowledge_base_articles/{articleId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for live updates and announcements.
     * @path /live_updates/{updateId}
     * @allow (get, list) Anyone can read live updates.
     * @allow (create, update, delete) Only admins can create, update, or delete updates.
     * @deny (create, update, delete) Non-admins cannot create, update, or delete updates.
     * @principle Public read access with admin-only writes.
     */
    match /live_updates/{updateId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for tags.
     * @path /tags/{tagId}
     * @allow (get, list) Anyone can read tags.
     * @allow (create, update, delete) Only admins can create, update, or delete tags.
     * @deny (create, update, delete) Non-admins cannot create, update, or delete tags.
     * @principle Public read access with admin-only writes.
     */
    match /tags/{tagId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for user-specific notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list, create) User 'user123' can read, list and create their own notifications.
     * @allow (update, delete) User 'user123' can update and delete their own existing notifications.
     * @deny (get, list, create) User 'user456' cannot read, list or create notifications for user 'user123'.
     * @deny (update, delete) User 'user456' cannot update or delete notifications for user 'user123'.
     * @principle Restricts access to a user's own notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}