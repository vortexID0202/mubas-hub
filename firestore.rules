rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isUpdatingAllowedFields() {
      // Allows updates only to 'votes', 'views', and 'upvotedBy'
      let otherFields = request.resource.data.diff(resource.data).affectedKeys();
      return otherFields.hasOnly(['votes', 'views', 'upvotedBy']);
    }

    // --- Rules ---

    // Users: Only the user can read/write their own profile. Admins can read any profile.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // Questions: Anyone can read. Authenticated users can create. 
    // Owner or admin can update/delete.
    // Any authenticated user can update votes/views.
    match /questions/{questionId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if (isOwner(resource.data.authorId) || isAdmin()) || (isAuth() && isUpdatingAllowedFields());
      allow delete: if isOwner(resource.data.authorId) || isAdmin();

      // Answers: Anyone can read. Authenticated users can create. Owner or admin can update/delete.
      match /answers/{answerId} {
        allow read: if true;
        allow create: if isAuth();
        allow update, delete: if isOwner(resource.data.authorId) || isAdmin();
      }
    }

    // Knowledge Base: Admins have full control. Anyone can read.
    match /knowledge_base_articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Live Updates: Admins have full control. Anyone can read.
    match /live_updates/{updateId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Tags: Anyone can read. Only admins can create/update/delete.
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Notifications: Only the user can access their own notifications.
    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if isOwner(userId);
    }
    
    // Admin Roles: Only admins can read/write to the admin roles collection.
    match /roles_admin/{uid} {
      allow read, write: if isAdmin();
    }
  }
}
