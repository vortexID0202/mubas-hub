rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description: Controls access to user profile data. Only the user themselves can read/write their own data, and listing is disallowed.
     * @path: /users/{userId}
     * @allow: (get, create, update, delete) User with UID 'user123' can read/write document with ID 'user123'.
     * @deny: (get, create, update, delete) User with UID 'user456' attempts to read/write document with ID 'user123'.
     * @principle: Enforces user-ownership.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description: Controls access to questions in the community forum. Anyone can read, but only the author can update or delete.
     * @path: /questions/{questionId}
     * @allow: (get, list) Any user can read/list questions.
     * @allow: (create, update, delete) User with UID matching the question's authorId can modify.
     * @deny: (create, update, delete) User with UID not matching the question's authorId attempts to modify.
     * @principle: Public read, owner-only writes.
     */
    match /questions/{questionId} {
      function isOwner(questionId) {
        return request.auth != null && request.auth.uid == resource.data.authorId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && isOwner(questionId);
      allow delete: if isSignedIn() && isOwner(questionId);
    }

    /**
     * @description: Controls access to answers for a specific question. Anyone can read, but only the author can update or delete.
     * @path: /questions/{questionId}/answers/{answerId}
     * @allow: (get, list) Any user can read/list answers.
     * @allow: (create, update, delete) User with UID matching the answer's authorId can modify.
     * @deny: (create, update, delete) User with UID not matching the answer's authorId attempts to modify.
     * @principle: Public read, owner-only writes, nested data.
     */
    match /questions/{questionId}/answers/{answerId} {
      function isOwner(answerId) {
        return request.auth != null && request.auth.uid == resource.data.authorId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && isOwner(answerId);
      allow delete: if isSignedIn() && isOwner(answerId);
    }

    /**
     * @description: Controls access to knowledge base articles. Anyone can read, but only admins can create, update, or delete.
     * @path: /knowledge_base_articles/{articleId}
     * @allow: (get, list) Any user can read/list articles.
     * @allow: (create, update, delete) User with admin role can modify.
     * @deny: (create, update, delete) User without admin role attempts to modify.
     * @principle: Public read, admin-only writes.
     */
    match /knowledge_base_articles/{articleId} {
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description: Controls access to tags. Anyone can read, but only admins can create, update, or delete.
     * @path: /tags/{tagId}
     * @allow: (get, list) Any user can read/list tags.
     * @allow: (create, update, delete) User with admin role can modify.
     * @deny: (create, update, delete) User without admin role attempts to modify.
     * @principle: Public read, admin-only writes.
     */
    match /tags/{tagId} {
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description: Controls access to notifications for a specific user. Only the user or an admin can access these notifications.
     * @path: /users/{userId}/notifications/{notificationId}
     * @allow: (get, list) User with matching UID can read/list notifications. Admin can also read/list.
     * @allow: (create, update, delete) User with matching UID can modify. Admin can also modify.
     * @deny: (get, list, create, update, delete) User with non-matching UID attempts to access.
     * @principle: User-ownership with admin override.
     */
    match /users/{userId}/notifications/{notificationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isOwner(userId) || isAdmin()); // Listing notifications should be disabled for privacy
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

     /**
      * @description: Defines admin roles based on document existence. If a document exists for a user ID in this collection, that user is an admin.
      * @path: /roles_admin/{uid}
      * @allow: (get, list, create, update, delete) Only admins (determined by another document in roles_admin) can manage this collection.
      * @deny: Non-admins cannot manage this collection.
      * @principle: Database-Based Access Control (DBAC).
      */
    match /roles_admin/{uid} {
        function isAdmin() {
            return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
        }
      function isSignedIn() {
        return request.auth != null;
      }
        allow get: if isSignedIn() && isAdmin();
        allow list: if false; // Listing roles should be disabled
        allow create: if isSignedIn() && isAdmin();
        allow update: if isSignedIn() && isAdmin();
        allow delete: if isSignedIn() && isAdmin();
    }
  }
}