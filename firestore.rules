/**
 * @file Firebase Security Rules for MUBAS Community Hub
 *
 * @description This ruleset enforces a strict user-ownership model for user-generated content (questions, answers, notifications)
 *  and restricts write access to knowledge base articles to authenticated admins. Read access to knowledge base articles is public.
 *
 * @data_structure
 *  - /users/{userId}: Stores user profiles, with the 'role' field used for admin privileges.
 *  - /users/{userId}/questions/{questionId}: Stores questions created by a specific user.
 *  - /users/{userId}/answers/{answerId}: Stores answers created by a specific user.
 *  - /knowledge_base_articles/{articleId}: Stores knowledge base articles.
 *  - /users/{userId}/notifications/{notificationId}: Stores notifications for a specific user.
 *
 * @key_security_decisions
 *  - User-generated content is secured using path-based ownership. A user can only create, update, or delete content under their own user ID.
 *  - Knowledge base articles are publicly readable, but only admins can modify them.
 *  - User listing is implicitly denied, as there is no rule allowing listing of the /users collection.
 *  - The default security posture for any ambiguous relationships is strict: deny all access unless explicitly allowed.
 *
 * @denormalization_for_authorization
 *  - User roles are stored directly in the /users/{userId} document to avoid costly `get()` calls when checking for admin privileges.
 *
 * @structural_segregation
 *  - Knowledge base articles are stored in a separate top-level collection to allow for different read/write permissions compared to user-generated content.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rules for user profiles. Users can only read and write their own profile.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile: request.auth.uid == 'user123'
     * @allow (get) User with ID 'user123' can read their own profile.
     * @allow (update) User with ID 'user123' can update their own profile.
     * @deny (create) User with ID 'user456' cannot create a profile with ID 'user123': request.auth.uid != 'user123'
     * @deny (get) User with ID 'user456' cannot read profile with ID 'user123'
     * @deny (update) User with ID 'user456' cannot update the profile with ID 'user123'
     * @deny (delete) Only the user can delete own profile, not other users.
     * @principle Enforces document ownership and self-creation for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Rules for questions posted by a user.  Users can only read, create, update, and delete their own questions.
     * @path /users/{userId}/questions/{questionId}
     * @allow (create) User with ID 'user123' can create a question under their profile.
     * @allow (get) User with ID 'user123' can read a question under their profile.
     * @allow (update) User with ID 'user123' can update a question under their profile.
     * @allow (delete) User with ID 'user123' can delete a question under their profile.
     * @deny (create) User with ID 'user456' cannot create a question under user 'user123'.
     * @deny (get) User with ID 'user456' cannot read a question under user 'user123'.
     * @deny (update) User with ID 'user456' cannot update a question under user 'user123'.
     * @deny (delete) User with ID 'user456' cannot delete a question under user 'user123'.
     * @principle Enforces document ownership for user-generated content.
     */
    match /users/{userId}/questions/{questionId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for answers posted by a user. Users can only read, create, update, and delete their own answers.
     * @path /users/{userId}/answers/{answerId}
     * @allow (create) User with ID 'user123' can create an answer under their profile.
     * @allow (get) User with ID 'user123' can read an answer under their profile.
     * @allow (update) User with ID 'user123' can update an answer under their profile.
     * @allow (delete) User with ID 'user123' can delete an answer under their profile.
     * @deny (create) User with ID 'user456' cannot create an answer under user 'user123'.
     * @deny (get) User with ID 'user456' cannot read an answer under user 'user123'.
     * @deny (update) User with ID 'user456' cannot update an answer under user 'user123'.
     * @deny (delete) User with ID 'user456' cannot delete an answer under user 'user123'.
     * @principle Enforces document ownership for user-generated content.
     */
    match /users/{userId}/answers/{answerId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for knowledge base articles. Read access is public, but only admins can create, update, or delete articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get) Any user can read a knowledge base article.
     * @allow (list) Any user can list knowledge base articles.
     * @allow (create) User with 'admin' role can create a knowledge base article.
     * @allow (update) User with 'admin' role can update a knowledge base article.
     * @allow (delete) User with 'admin' role can delete a knowledge base article.
     * @deny (create) Non-admin user cannot create a knowledge base article.
     * @deny (update) Non-admin user cannot update a knowledge base article.
     * @deny (delete) Non-admin user cannot delete a knowledge base article.
     * @principle Public read access with restricted write access for admin-managed content.
     */
    match /knowledge_base_articles/{articleId} {
      function isAdmin() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for notifications for a user. Users can only read, create, update and delete their own notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (create) User with ID 'user123' can create a notification under their profile.
     * @allow (get) User with ID 'user123' can read a notification under their profile.
     * @allow (update) User with ID 'user123' can update a notification under their profile.
     * @allow (delete) User with ID 'user123' can delete a notification under their profile.
     * @deny (create) User with ID 'user456' cannot create a notification under user 'user123'.
     * @deny (get) User with ID 'user456' cannot read a notification under user 'user123'.
     * @deny (update) User with ID 'user456' cannot update a notification under user 'user123'.
     * @deny (delete) User with ID 'user456' cannot delete a notification under user 'user123'.
     * @principle Enforces document ownership for user-specific notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

     /**
      * @description This rule blocks listing of the 'questions' collection.
      * @path /questions
      * @deny (list) All users are denied listing the root-level 'questions' collection.
      * @principle Prevents unauthorized access to a potentially large collection of questions.
      */
    match /questions {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}