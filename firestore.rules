rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rules for the 'users' collection
    match /users/{userId} {
      // Users can only read, update, or delete their own profile
      allow read, update, delete: if request.auth.uid == userId;
      // Any authenticated user can create a user document (for their own profile)
      allow create: if request.auth.uid != null;
    }

    // Rules for the 'questions' collection as a whole
    match /questions {
      // Allow anyone to list (read) the entire collection of questions
      allow list: if true;
      // Allow any authenticated user to create a new question
      allow create: if request.auth != null;
    }

    // Rules for a single document within the 'questions' collection
    match /questions/{questionId} {
      // Allow anyone to get (read) a single question
      allow get: if true;
      // Allow authenticated users to update or delete questions
      allow update, delete: if request.auth != null; // Further rules could restrict this to authors/admins
    }

    // Rules for the 'answers' subcollection
    match /questions/{questionId}/answers/{answerId} {
      // Allow anyone to read answers
      allow read: if true;
      // Only allow authenticated users to write answers
      allow write: if request.auth != null;
    }
  }
}
