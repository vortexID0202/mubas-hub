rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner of the document.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && exists(resource);
    }

    /**
     * @description Checks if the user is an admin.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Defines a role for the user.
     * @param {string} role The role to check for.
     * @return {boolean} True if the user has the specified role, false otherwise.
     */
    function hasRole(role) {
        return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    /**
     * @description Rule for /users/{userId} documents.
     * @path /users/{userId}
     * @allow (create) If the user's ID matches the requested userId (self-creation).
     * @deny (create) If the user's ID does not match the requested userId.
     * @allow (get, update, delete) If the user is the owner or an admin.
     * @deny (get, update, delete) If the user is not the owner or an admin.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow create: if isSignedIn() && isOwner(userId) && request.auth.uid == userId;
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rule for /questions/{questionId} documents.
     * @path /questions/{questionId}
     * @allow (get, list) Public read access.
     * @allow (create) If the authorId matches the user's ID.
     * @allow (update, delete) If the user is the author or an admin and the document exists.
     * @deny (update, delete) If the user is not the author or an admin.
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.authorId || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.authorId || isAdmin());
    }

    /**
     * @description Rule for /questions/{questionId}/answers/{answerId} documents.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) Public read access.
     * @allow (create) If the authorId matches the user's ID.
     * @allow (update, delete) If the user is the author or an admin and the document exists.
     * @deny (update, delete) If the user is not the author or an admin.
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && request.auth.uid == resource.data.authorId || isAdmin();
      allow delete: if isSignedIn() && request.auth.uid == resource.data.authorId || isAdmin();
    }

    /**
     * @description Rule for /knowledge_base_articles/{articleId} documents.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) Public read access.
     * @allow (create, update, delete) If the user is an admin.
     * @deny (create, update, delete) If the user is not an admin.
     * @principle Restricts write access to admins.
     */
    match /knowledge_base_articles/{articleId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rule for /tags/{tagId} documents.
     * @path /tags/{tagId}
     * @allow (get, list) Public read access.
     * @allow (create, update, delete) If the user is an admin.
     * @deny (create, update, delete) If the user is not an admin.
     * @principle Restricts write access to admins.
     */
    match /tags/{tagId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rule for /users/{userId}/notifications/{notificationId} documents.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list, create) If the user is the owner or an admin.
     * @allow (update, delete) If the user is the owner or an admin and the document exists.
     * @deny (update, delete) If the user is not the owner or an admin.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rule for /roles_admin/{uid} documents.
     * @path /roles_admin/{uid}
     * @allow (get, create) If the user is an admin.
     * @allow (update, delete) If the user is an admin and the document exists.
     * @deny (update, delete) If the user is not an admin.
     * @principle Database-Based Access Control (DBAC) for admin roles.
     */
    match /roles_admin/{uid} {
      allow get, create: if isAdmin();
      allow list: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}