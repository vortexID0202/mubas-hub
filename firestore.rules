rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profiles. Allows users to create their own profile and prevents unauthorized modifications.
     * @path /users/{userId}
     * @allow (create) - Authenticated user creates their profile with matching userId.
     * @allow (get) - Authenticated user gets their own profile with matching userId.
     * @allow (update) - Authenticated user updates their profile with matching userId.
     * @allow (delete) - Authenticated user deletes their profile with matching userId.
     * @deny (create) - Unauthenticated user attempts to create a profile.
     * @deny (update) - Authenticated user attempts to update another user's profile.
     * @deny (delete) - Authenticated user attempts to delete another user's profile.
     * @principle Enforces document ownership and identity verification for user profiles.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Manages questions posted by users. Allows users to create, read, update, and delete their own questions.
     * @path /users/{userId}/questions/{questionId}
     * @allow (create) - Authenticated user creates a question under their userId.
     * @allow (get) - Authenticated user gets a question under their userId.
     * @allow (update) - Authenticated user updates a question under their userId.
     * @allow (delete) - Authenticated user deletes a question under their userId.
     * @deny (create) - Authenticated user attempts to create a question under another user's userId.
     * @deny (update) - Authenticated user attempts to update another user's question.
     * @deny (delete) - Authenticated user attempts to delete another user's question.
     * @principle Enforces document ownership and path-based authorization for user-generated questions.
     */
    match /users/{userId}/questions/{questionId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Manages answers posted by users to specific questions. Allows users to create, read, update, and delete their own answers.
     * @path /users/{userId}/answers/{answerId}
     * @allow (create) - Authenticated user creates an answer under their userId.
     * @allow (get) - Authenticated user gets an answer under their userId.
     * @allow (update) - Authenticated user updates an answer under their userId.
     * @allow (delete) - Authenticated user deletes an answer under their userId.
     * @deny (create) - Authenticated user attempts to create an answer under another user's userId.
     * @deny (update) - Authenticated user attempts to update another user's answer.
     * @deny (delete) - Authenticated user attempts to delete another user's answer.
     * @principle Enforces document ownership and path-based authorization for user-generated answers.
     */
    match /users/{userId}/answers/{answerId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Manages knowledge base articles. Allows public read access but restricts create, update, and delete operations to admins.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get) - Any user can read knowledge base articles.
     * @allow (list) - Any user can list knowledge base articles.
     * @allow (create) - Only admins can create knowledge base articles.
     * @allow (update) - Only admins can update knowledge base articles.
     * @allow (delete) - Only admins can delete knowledge base articles.
     * @deny (create) - Non-admin user attempts to create a knowledge base article.
     * @deny (update) - Non-admin user attempts to update a knowledge base article.
     * @deny (delete) - Non-admin user attempts to delete a knowledge base article.
     * @principle Restricts write access to knowledge base articles based on user role (admin).
     */
    match /knowledge_base_articles/{articleId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Manages notifications for users. Allows users to create, read, update, and delete their own notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (create) - Authenticated user creates a notification under their userId.
     * @allow (get) - Authenticated user gets a notification under their userId.
     * @allow (update) - Authenticated user updates a notification under their userId.
     * @allow (delete) - Authenticated user deletes a notification under their userId.
     * @deny (create) - Authenticated user attempts to create a notification under another user's userId.
     * @deny (update) - Authenticated user attempts to update another user's notification.
     * @deny (delete) - Authenticated user attempts to delete another user's notification.
     * @principle Enforces document ownership and path-based authorization for user notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isAdmin() {
    return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
  }
}