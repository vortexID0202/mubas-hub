/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for personal data,
 *              public read access for community content with owner-controlled writes,
 *              and role-based access control for administrative functions.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the user and admins.
 * - /questions/{questionId}: Community questions, publicly readable, but only the author can update/delete.
 * - /questions/{questionId}/answers/{answerId}: Answers to questions, publicly readable, author-controlled writes.
 * - /knowledge_base_articles/{articleId}: Knowledge base articles, publicly readable, admin-controlled writes.
 * - /tags/{tagId}: Tags for content, publicly readable, admin-controlled writes.
 * - /users/{userId}/notifications/{notificationId}: User notifications, accessible only to the user.
 * - /roles_admin/{uid}: Indicates admin status. Existence of a document grants admin role.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect privacy.
 * - Read-only collections are explicitly marked with `allow get, list: if true;`.
 * - Write operations are strictly controlled via ownership or role checks.
 *
 * Denormalization for Authorization:
 * - The 'Question' and 'Answer' entities include an 'authorId' field to avoid costly `get()` calls
 *   when checking ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for user profiles.
     * @path /users/{userId}
     * @allow (create) User 'user123' can create their own profile.
     * @allow (get, update, delete) User 'user123' can access their own profile.
     * @deny (get, update, delete) User 'user456' cannot access User 'user123' profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Controls access to community forum questions.
     * @path /questions/{questionId}
     * @allow (get, list) Anyone can read questions.
     * @allow (create) User 'user123' can create a question with their ID as authorId.
     * @allow (update, delete) User 'user123' can update/delete their own question.
     * @deny (update, delete) User 'user456' cannot update/delete User 'user123' question.
     * @principle Enforces owner-only writes for community content.
     */
    match /questions/{questionId} {
      function isOwner(authorId) {
        return request.auth.uid == authorId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      function isExistingOwner(authorId) {
        return isOwner(authorId) && resource != null;
      }

      allow get, list: if true;
      allow create: if request.auth.uid != null && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Controls access to answers for specific questions.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) Anyone can read answers to a question.
     * @allow (create) User 'user123' can create an answer with their ID as authorId.
     * @allow (update, delete) User 'user123' can update/delete their own answer.
     * @deny (update, delete) User 'user456' cannot update/delete User 'user123' answer.
     * @principle Enforces owner-only writes for answers within questions.
     */
    match /questions/{questionId}/answers/{answerId} {
      function isOwner(authorId) {
        return request.auth.uid == authorId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      function isExistingOwner(authorId) {
        return isOwner(authorId) && resource != null;
      }

      allow get, list: if true;
      allow create: if request.auth.uid != null && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Controls access to knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) Anyone can read knowledge base articles.
     * @allow (create, update, delete) Only admins can create, update or delete knowledge base articles.
     * @principle Restricts write access to admins for knowledge base articles.
     */
    match /knowledge_base_articles/{articleId} {
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to tags.
     * @path /tags/{tagId}
     * @allow (get, list) Anyone can read tags.
     * @allow (create, update, delete) Only admins can create, update or delete tags.
     * @principle Restricts write access to admins for managing tags.
     */
    match /tags/{tagId} {
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Enforces user-ownership for notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list, create, update, delete) User 'user123' can access their own notifications.
     * @deny (get, list, create, update, delete) User 'user456' cannot access User 'user123' notifications.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/notifications/{notificationId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

     /**
      * @description Grants admin privileges based on document existence.
      * @path /roles_admin/{uid}
      * @allow (create) An admin can grant another user admin privileges.
      * @allow (get) Anyone can read the admin role document.
      * @deny (update, delete) Only admins can modify the admin role.
      * @principle DBAC (Database-Based Access Control) for admin roles.
      */
    match /roles_admin/{uid} {
       function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}