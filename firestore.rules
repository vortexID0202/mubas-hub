/**
 * @file Firebase Security Rules for MUBAS Community Hub
 * @version 2
 *
 * @description This ruleset enforces a multi-layered security model, combining user-based access control with role-based permissions.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the user and admins.
 * - /questions/{questionId}: Community forum questions, publicly readable, but updatable only by the author or an admin.
 * - /questions/{questionId}/answers/{answerId}: Answers to questions, publicly readable, but updatable only by the author or an admin.
 * - /knowledge_base_articles/{articleId}: Knowledge base articles, publicly readable, but writable only by admins.
 * - /tags/{tagId}: Tags for questions and articles, publicly readable, but writable only by admins.
 * - /users/{userId}/notifications/{notificationId}: User-specific notifications, accessible only to the user and admins.
 * - /roles_admin/{uid}: Database-based Access Control collection. Document existence determines if user is admin.
 *
 * Key Security Decisions:
 * - Strict user-ownership model for user profiles and notifications.
 * - Public read access for questions, answers, knowledge base articles, and tags.
 * - Admin-only write access for knowledge base articles and tags.
 * - Usage of a dedicated /roles_admin/{uid} collection for managing admin roles, enhancing security and separation of concerns.
 *
 * Denormalization for Authorization:
 * - The 'authorId' field is denormalized in the 'questions' and 'answers' collections to enable simple ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows access to user profiles.
     * @path /users/{userId}
     * @allow (get, list) User with matching userId can read their profile. Admin can also read.
     * @allow (create, update, delete) User with matching userId can create, update, and delete their profile. Admin can also perform these actions.
     * @deny (get, list) Any other user trying to access another user's profile.
     * @deny (create, update, delete) Any other user trying to modify another user's profile.
     * @principle Enforces document ownership and admin overrides for user profiles.
     */
    match /users/{userId} {
      // Helper function to check if the requesting user is the owner
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the requesting user is an admin
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      // Helper function to check if the document exists and the user is the owner.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Allows access to community forum questions.
     * @path /questions/{questionId}
     * @allow (get, list) Anyone can read questions.
     * @allow (create) Any authenticated user can create a question.
     * @allow (update, delete) Only the author or an admin can update or delete a question.
     * @deny (update, delete) Any other user trying to modify or delete a question they don't own.
     * @principle Public read, owner-only writes, and admin overrides for questions.
     */
    match /questions/{questionId} {
        // Helper function to check if the requesting user is the author of the question.
        function isAuthor(authorId) {
          return request.auth.uid == authorId;
        }

        // Helper function to check if the requesting user is an admin
        function isAdmin() {
          return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
        }

        // Helper function to check if the document exists and the user is the owner.
        function isExistingAuthor(authorId) {
          return isAuthor(authorId) && resource != null;
        }

        allow get, list: if true;
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update: if isExistingAuthor(resource.data.authorId) || isAdmin();
        allow delete: if isExistingAuthor(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Allows access to answers for a specific question.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) Anyone can read answers to a question.
     * @allow (create) Any authenticated user can create an answer to a question.
     * @allow (update, delete) Only the author or an admin can update or delete an answer.
     * @deny (update, delete) Any other user trying to modify or delete an answer they don't own.
     * @principle Public read, owner-only writes, and admin overrides for answers.
     */
    match /questions/{questionId}/answers/{answerId} {
      // Helper function to check if the requesting user is the author of the answer.
      function isAuthor(authorId) {
        return request.auth.uid == authorId;
      }

      // Helper function to check if the requesting user is an admin
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

        // Helper function to check if the document exists and the user is the owner.
        function isExistingAuthor(authorId) {
          return isAuthor(authorId) && resource != null;
        }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingAuthor(resource.data.authorId) || isAdmin();
      allow delete: if isExistingAuthor(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Allows access to knowledge base articles.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) Anyone can read knowledge base articles.
     * @allow (create, update, delete) Only admins can create, update, or delete knowledge base articles.
     * @deny (create, update, delete) Non-admins cannot modify knowledge base articles.
     * @principle Public read, admin-only writes for knowledge base articles.
     */
    match /knowledge_base_articles/{articleId} {
      // Helper function to check if the requesting user is an admin
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Allows access to tags.
     * @path /tags/{tagId}
     * @allow (get, list) Anyone can read tags.
     * @allow (create, update, delete) Only admins can create, update, or delete tags.
     * @deny (create, update, delete) Non-admins cannot modify tags.
     * @principle Public read, admin-only writes for tags.
     */
    match /tags/{tagId} {
      // Helper function to check if the requesting user is an admin
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Allows access to user-specific notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list) User with matching userId can read their notifications. Admin can also read.
     * @allow (create, update, delete) User with matching userId can create, update, and delete their notifications. Admin can also perform these actions.
     * @deny (get, list) Any other user trying to access another user's notifications.
     * @deny (create, update, delete) Any other user trying to modify another user's notifications.
     * @principle Enforces document ownership and admin overrides for notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      // Helper function to check if the requesting user is the owner
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the requesting user is an admin
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      // Helper function to check if the document exists and the user is the owner.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Allows access to admin role documents.  The existence of a document here grants admin privileges.
     * @path /roles_admin/{uid}
     * @allow (get) Anyone can get to check if user is admin
     * @allow (list) Not allowed
     * @allow (create, update, delete) Only admins can create, update, or delete admin roles.
     * @deny (create, update, delete) Non-admins cannot modify admin roles.
     * @principle Database-Based Access Control (DBAC)
     */
    match /roles_admin/{uid} {
      // Helper function to check if the requesting user is an admin
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if true;
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    // isSignedIn function
    function isSignedIn() {
      return request.auth != null;
    }
  }
}