/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control system with owner-only access for user data.
 * All data is stored in top-level collections, with some collections having user-owned subcollections.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the user themselves.
 * - /questions/{questionId}: Community forum questions, publicly readable, but updates/deletes restricted to the author.
 * - /questions/{questionId}/answers/{answerId}: Answers to questions, publicly readable, updates/deletes restricted to the author.
 * - /knowledge_base_articles/{articleId}: Knowledge base articles, publicly readable, writes restricted to admins.
 * - /tags/{tagId}: Tags for questions and articles, publicly readable, writes restricted to admins.
 * - /users/{userId}/notifications/{notificationId}: User-specific notifications, only accessible by the user.
 * - /roles_admin/{uid}: Documents indicating admin status. Admin status is granted by the existence of a document with a user's UID as the document ID in this collection.
 *
 * Key Security Decisions:
 * - User listing is disabled for security.
 * - Roles are managed via document existence in the `/roles_admin` collection. This avoids complex custom claims.
 * - Public read access is granted to questions, answers, knowledge base articles, and tags to encourage community participation and knowledge sharing.
 * - To simplify security rules and improve performance, authorId is denormalized onto questions and answers.
 *
 * Denormalization for Authorization:
 * - The `authorId` field is present on `questions` and `answers` to avoid costly `get()` calls to the `users` collection for authorization.
 *
 * Structural Segregation:
 * - Private user data (notifications) is stored in a user-specific subcollection (/users/{userId}/notifications/{notificationId}) to ensure only the user can access it.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document.
     * @param {string} userId - The user ID to compare with the request's auth UID.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

        /**
     * @description Checks if the user is an existing owner of the document.
     * @param {string} userId - The user ID to compare with the request's auth UID.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is an admin based on the existence of a document in the /roles_admin/{uid} collection.
     * @return {bool} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
        return exists(/databases/(default)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Defines how the user can create their own profile document.
     * @path /users/{userId}
     * @allow (create) - User with ID 'test_user' creates their own profile. request.auth.uid == 'test_user'
     * @deny (create) - User with ID 'test_user' tries to create a profile for 'other_user'. request.auth.uid == 'test_user', userId == 'other_user'
     * @principle Enforces user-ownership for profile creation.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // User listing is disabled.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages community forum questions. Anyone can read questions; only the author can update or delete.
     * @path /questions/{questionId}
     * @allow (get, list) - Any user can read questions.
     * @allow (create) - User creates a question with their authorId. request.auth.uid == request.resource.data.authorId
     * @allow (update, delete) - User updates/deletes their own question. request.auth.uid == resource.data.authorId
     * @deny (update, delete) - User tries to update/delete someone else's question. request.auth.uid != resource.data.authorId
     * @principle Enforces owner-only write access for questions.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Manages answers to questions. Anyone can read answers; only the author can update or delete.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) - Any user can read answers to a question.
     * @allow (create) - User creates an answer with their authorId. request.auth.uid == request.resource.data.authorId
     * @allow (update, delete) - User updates/deletes their own answer. request.auth.uid == resource.data.authorId
     * @deny (update, delete) - User tries to update/delete someone else's answer. request.auth.uid != resource.data.authorId
     * @principle Enforces owner-only write access for answers.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Manages knowledge base articles. Everyone can read; only admins can create, update, or delete.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) - Any user can read knowledge base articles.
     * @allow (create, update, delete) - Only admins can create, update, or delete articles.
     * @deny (create, update, delete) - Non-admin user tries to create, update, or delete articles.
     * @principle Enforces admin-only write access for knowledge base articles.
     */
    match /knowledge_base_articles/{articleId} {
      allow get, list: if true;
      allow create: if isAdmin() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Manages tags. Everyone can read; only admins can create, update, or delete.
     * @path /tags/{tagId}
     * @allow (get, list) - Any user can read tags.
     * @allow (create, update, delete) - Only admins can create, update, or delete tags.
     * @deny (create, update, delete) - Non-admin user tries to create, update, or delete tags.
     * @principle Enforces admin-only write access for tags.
     */
    match /tags/{tagId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Manages user-specific notifications. Only the user can access their own notifications.
     * @path /users/{userId}/notifications/{notificationId}
     *  @allow (get, list) - User with ID 'test_user' reads their own notifications. request.auth.uid == 'test_user', userId == 'test_user'
     *  @deny (get, list) - User with ID 'test_user' tries to read notifications for 'other_user'. request.auth.uid == 'test_user', userId == 'other_user'
     * @allow (create) - User creates their own notification
     * @deny (create) - User tries to create notification for someone else
     * @principle Enforces user-ownership for notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
       /**
     * @description Grants admin privileges to a user based on the existence of a document with their UID as the document ID in this collection.
     * @path /roles_admin/{uid}
     * @allow (get, list, create, update, delete) - Only admins can create, update, or delete admin roles.
     * @deny (get, list, create, update, delete) - Non-admin user tries to create, update, or delete admin roles.
     * @principle Implements Database-Based Access Control (DBAC) for admin roles.
     */
    match /roles_admin/{uid} {
      allow get: if isAdmin();
      allow list: if false; // Do not allow listing of admin roles
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}