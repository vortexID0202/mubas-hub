/**
 * @file Firebase Security Rules for MUBAS Community Hub
 * @version Prototyping
 *
 * @Core Philosophy
 * This ruleset prioritizes robust authorization and rapid prototyping. It uses a combination of
 * ownership-based access control for user-specific data and public read access with owner-controlled
 * writes for community content. Data shape validation is minimized to allow for flexible data structures
 * during the prototyping phase.
 *
 * @Data Structure
 * - /users/{userId}: User profiles, accessible only to the user and admins.
 * - /questions/{questionId}: Community forum questions; publicly readable, but updates/deletes are restricted to authors or admins.
 * - /questions/{questionId}/answers/{answerId}: Answers to questions; publicly readable, but updates/deletes are restricted to authors or admins.
 * - /knowledge_base_articles/{articleId}: Knowledge base articles; publicly readable, but creation/updates/deletes are restricted to admins.
 * - /live_updates/{updateId}: Live updates and announcements; publicly readable, but creation/updates/deletes are restricted to admins.
 * - /tags/{tagId}: Tags for categorizing content; publicly readable, but creation/updates/deletes are restricted to admins.
 * - /users/{userId}/notifications/{notificationId}: Notifications for specific users, accessible only to the user and admins.
 * - /roles_admin/{uid}: DEPRECATED: Admin roles are now managed via custom claims.
 *
 * @Key Security Decisions
 * - User listing is disabled.
 * - Admin privileges are determined by custom claims.
 * - Public read access is granted for questions, answers, knowledge base articles, live updates, and tags to support community engagement.
 * - Strict ownership is enforced for user profiles and notifications.
 *
 * @Denormalization for Authorization
 * - The `Question` and `Answer` entities include the `authorId` field, which is used to determine ownership for update and delete operations, preventing costly `get()` calls.
 *
 * @Structural Segregation
 * - User-specific notifications are stored in a private subcollection under the user's profile (`/users/{userId}/notifications/{notificationId}`), ensuring that only the user can access their notifications.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles, accessible only to the user and admins.
     * @path /users/{userId}
     * @allow (create) if request.auth.uid == userId
     * @allow (get, update, delete) if request.auth.uid == userId
     * @deny (create) if request.auth.uid != userId
     * @deny (list) Listing all users is not permitted.
     * @deny (get, update, delete) if request.auth.uid != userId
     * @principle Enforces user-ownership for private data.
     */
    match /users/{userId} {
      // Only the user can create their profile, with a matching user ID
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      // Only the user can read, update, or delete their profile
      allow get, update, delete: if isSignedIn() && isExistingOwner(userId) && resource.data.id == userId;
      allow list: if false;
    }

    /**
     * @description Secure community forum questions. Anyone can read questions, but only the author or an admin can update or delete them.
     * @path /questions/{questionId}
     * @allow (get, list) Everyone can read questions.
     * @allow (create) if isSignedIn() && request.resource.data.authorId == request.auth.uid
     * @allow (update, delete) if isSignedIn() && isOwner(resource.data.authorId)
     * @deny (create) if !isSignedIn() || request.resource.data.authorId != request.auth.uid
     * @deny (update, delete) if !isSignedIn() || !isOwner(resource.data.authorId)
     * @principle Implements public read access with owner-controlled writes.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && isExistingOwner(resource.data.authorId);
    }

    /**
     * @description Secure answers to specific questions, establishing a clear hierarchical relationship. Anyone can read answers to a question, but only the author can update or delete them.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) Everyone can read answers to a question.
     * @allow (create) if isSignedIn() && request.resource.data.authorId == request.auth.uid;
     * @allow (update, delete) if isSignedIn() && isExistingOwner(resource.data.authorId);
     * @deny (create) if !isSignedIn() || request.resource.data.authorId != request.auth.uid
     * @deny (update, delete) if !isSignedIn() || !isOwner(resource.data.authorId)
     * @principle Implements public read access with owner-controlled writes in a subcollection.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && isExistingOwner(resource.data.authorId);
    }

    /**
     * @description Secure knowledge base articles. Only admins can create, update, or delete articles. Everyone can read.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) Everyone can read knowledge base articles.
     * @allow (create, update, delete) if isAdmin();
     * @deny (create, update, delete) if !isAdmin();
     * @principle Restricts write access to admins while allowing public reads.
     */
    match /knowledge_base_articles/{articleId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Secure live updates and announcements. Only admins can create updates. Everyone can read.
     * @path /live_updates/{updateId}
     * @allow (get, list) Everyone can read live updates.
     * @allow (create, update, delete) if isAdmin();
     * @deny (create, update, delete) if !isAdmin();
     * @principle Restricts write access to admins while allowing public reads.
     */
    match /live_updates/{updateId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Secure tags that can be associated with questions or knowledge base articles. Tags can be read by anyone, but only admins can create, update, or delete them.
     * @path /tags/{tagId}
     * @allow (get, list) Everyone can read tags.
     * @allow (create, update, delete) if isAdmin();
     * @deny (create, update, delete) if !isAdmin();
     * @principle Restricts write access to admins while allowing public reads.
     */
    match /tags/{tagId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Secure notifications for a specific user. Only the user and admins can access these notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (create) if isSignedIn() && request.auth.uid == userId
     * @allow (get, update, delete) if isSignedIn() && request.auth.uid == userId
     * @deny (create) if request.auth.uid != userId
     * @deny (get, update, delete) if request.auth.uid != userId
     * @principle Enforces user-ownership for private data.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow get, update, delete, list: if isSignedIn() && isExistingOwner(userId) && resource.data.userId == userId;
    }

    /**
     * @description DEPRECATED: Admin roles are now managed via custom claims. The existence of a document at this path previously granted admin privileges. This is kept for historical reference but is no longer the source of truth for admin status.
     * @path /roles_admin/{uid}
     * @allow get: if false;
     * @allow list: if false;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle This collection is deprecated, so all access is denied.
     */
    match /roles_admin/{uid} {
        allow get, list, create, update, delete: if false;
    }

    // ---- Helper Functions ----

    /**
     * @description Checks if the user is signed in.
     * @return True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource, based on the provided user ID.
     * @param userId The user ID to compare against the request's authentication UID.
     * @return True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the existing resource.
     * @param userId The user ID to compare against the request's authentication UID.
     * @return True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user has the 'admin' custom claim.
     * @return True if the user has the 'admin' claim set to true, false otherwise.
     */
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
  }
}