
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Users: Can read/write their own profile. Admins can read all profiles.
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId;
    }

    // Questions: Logged-in users can create. Authors can update/delete. Public can read.
    match /questions/{questionId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if resource.data.authorId == request.auth.uid || isAdmin();
    }
    
    // Answers: Logged-in users can create. Authors can update/delete. Public can read.
    match /questions/{questionId}/answers/{answerId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if resource.data.authorId == request.auth.uid || isAdmin();
    }

    // Knowledge Base: Admins can write. Public can read.
    match /knowledge_base_articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Live Updates: Admins can write. Public can read.
    match /live_updates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tags: Public can read. Admins can write.
    match /tags/{tagId} {
        allow read: if true;
        allow write: if isAdmin();
    }
    
    // Admin Roles: Only readable by admins themselves to verify status.
    match /roles_admin/{uid} {
      allow read, write: if isAdmin();
    }
  }
}
