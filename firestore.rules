rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // =================================
    // User Profiles
    // =================================
    // Path: /users/{userId}
    // Entity: User
    match /users/{userId} {
      // READ: Any authenticated user can read any user's profile.
      allow get: if request.auth != null;

      // READ LIST: Authenticated users can list all profiles.
      allow list: if request.auth != null;
      
      // CREATE: A user can create their own profile document.
      allow create: if isOwner(userId)
                    && 'fullName' in request.resource.data
                    && 'email' in request.resource.data
                    && request.resource.data.email == request.auth.token.email;

      // UPDATE: A user can only update their own profile.
      allow update: if isOwner(userId);
    }
    
    // =================================
    // Questions
    // =================================
    // Path: /users/{userId}/questions/{questionId}
    // Entity: Question
    match /users/{userId}/questions/{questionId} {
      // READ: Any authenticated user can read questions.
      allow get, list: if request.auth != null;

      // CREATE: An authenticated user can create a question under their own userId.
      allow create: if isOwner(userId)
                    && request.resource.data.authorId == userId
                    && 'title' in request.resource.data
                    && 'body' in request.resource.data
                    && 'createdAt' in request.resource.data
                    && request.resource.data.createdAt == request.time;
      
      // UPDATE, DELETE: Only the user who created the question can update or delete it.
      allow update, delete: if isOwner(userId);
    }

    // =================================
    // Answers
    // =================================
    // Path: /questions/{questionId}/answers/{answerId}
    // This assumes a top-level 'questions' collection for answers, which might differ from the app structure.
    // For now, let's keep it simple and secure public access.
    match /questions/{questionId}/answers/{answerId} {
        // Anyone can read answers
        allow read: if true;
        // Only authenticated users can write answers
        allow write: if request.auth != null;
    }

    // Default deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
