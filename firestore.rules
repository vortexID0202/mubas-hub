rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Function to check if a user is an administrator
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Users can only read/write their own profile
    match /users/{userId} {
      allow read, update, delete: if request.auth.uid == userId;
      allow create: if request.auth.uid != null;
    }

    // Questions can be read by anyone.
    // They can be created by any authenticated user.
    // They can only be updated/deleted by the author or an admin.
    // Authenticated users can upvote/view questions.
    match /questions/{questionId} {
      allow read: if true;
      allow create: if request.auth.uid != null;
      allow update: if request.auth.uid == resource.data.authorId || isAdmin() || 
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'upvotedBy', 'views']) && 
                        request.resource.data.votes > resource.data.votes &&
                        !request.auth.uid in resource.data.upvotedBy);
      allow delete: if request.auth.uid == resource.data.authorId || isAdmin();

      // Answers can be read by anyone.
      // They can be created by any authenticated user.
      // They can only be updated/deleted by the author or an admin.
      // Authenticated users can upvote answers.
      match /answers/{answerId} {
        allow read: if true;
        allow create: if request.auth.uid != null;
        allow update: if request.auth.uid == resource.data.authorId || isAdmin() ||
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'upvotedBy']) && 
                          request.resource.data.votes > resource.data.votes &&
                          !request.auth.uid in resource.data.upvotedBy);
        allow delete: if request.auth.uid == resource.data.authorId || isAdmin();
      }
    }
    
    // Knowledge base articles can be read by anyone.
    // Only admins can create, update, or delete them.
    match /knowledge_base_articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Live updates can be read by anyone.
    // Only admins can create, update, or delete them.
    match /live_updates/{updateId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Tags can be read by anyone, but only created/managed by admins.
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Only admins can read/write to the admin roles collection.
    match /roles_admin/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
