/**
 * @fileOverview Firestore Security Rules for the MUBAS Community Hub.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data, combined with role-based access control for administrative functions. Public read access is granted for certain collections like 'questions', but writes are always restricted based on authorization.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the user themselves.
 * - /questions/{questionId}: Community forum questions, readable by all, but writable only by the author or an admin. Includes the authorId field.
 * - /questions/{questionId}/answers/{answerId}: Answers to questions, readable by all, writable only by the author or an admin.
 * - /knowledge_base_articles/{articleId}: Knowledge base articles, readable by all, writable only by admins.
 * - /tags/{tagId}: Tags for questions and articles, readable by all, writable only by admins.
 * - /users/{userId}/notifications/{notificationId}: Notifications for users, accessible only to the user themselves.
 * - /roles_admin/{uid}: Marks a user as an admin. The existence of a document at this path grants admin privileges. Authorization based on document existence rather than content.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - All write operations require authentication.
 * - The 'roles_admin' collection uses Database-Based Access Control (DBAC): Admin privileges are granted based on the *existence* of a document with the user's UID as the document ID.
 * - Public read access is granted to 'questions', 'answers', 'knowledge_base_articles', and 'tags'.
 *
 * Denormalization for Authorization:
 * - The 'Question' and 'Answer' entities both denormalize the 'authorId' field to allow for simpler, more performant ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Defines the global function isSignedIn to check if a user is authenticated.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle N/A
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Defines the global function isAdmin to check if a user is an admin.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle N/A
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Defines the global function isOwner to check if the request is made by the owner.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle N/A
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Defines the global function isExistingOwner to check if the request is made by the owner for an existing document.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle N/A
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Manages access to user profiles. Only the user themselves can read and write their own profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete) - User with ID 'user123' can read, create, update, and delete their own profile at /users/user123 when authenticated.
     * @deny (get, create, update, delete) - User with ID 'user456' cannot read, create, update, or delete the profile of user 'user123' at /users/user123.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to community forum questions. Anyone can read questions, but only the author or an admin can create, update, or delete them.
     * @path /questions/{questionId}
     * @allow (get, list) - Any user can read any question.
     * @allow (create) - User with ID 'user123' can create a question at /questions/question456 if request.auth.uid == request.resource.data.authorId.
     * @allow (update, delete) - User with ID 'user123' or an admin can update/delete a question at /questions/question456 if request.auth.uid == resource.data.authorId.
     * @deny (create) - User with ID 'user123' cannot create a question at /questions/question456 if request.auth.uid != request.resource.data.authorId.
     * @deny (update, delete) - User with ID 'user456' cannot update/delete a question at /questions/question456 if request.auth.uid != resource.data.authorId and is not an admin.
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    /**
     * @description Manages access to answers for a specific question. Anyone can read answers, but only the author or an admin can create, update, or delete them.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) - Any user can read any answer to any question.
     * @allow (create) - User with ID 'user123' can create an answer at /questions/question456/answers/answer789 if authenticated and the answer's authorId matches their UID.
     * @allow (update, delete) - User with ID 'user123' or an admin can update/delete an answer at /questions/question456/answers/answer789 if request.auth.uid == resource.data.authorId.
     * @deny (create) - User with ID 'user123' cannot create an answer if they are not authenticated, or if the answer's authorId does not match their UID.
     * @deny (update, delete) - User with ID 'user456' cannot update/delete an answer at /questions/question456/answers/answer789 if request.auth.uid != resource.data.authorId.
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    /**
     * @description Manages access to knowledge base articles. Only admins can create, update, or delete articles. Everyone can read.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) - Any user can read any knowledge base article.
     * @allow (create, update, delete) - Only admins can create, update, or delete knowledge base articles.
     * @deny (create, update, delete) - Non-admin users cannot create, update, or delete knowledge base articles.
     * @principle Enforces admin-only access for writes, allows public reads.
     */
    match /knowledge_base_articles/{articleId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Manages access to tags. Tags can be read by anyone, but only admins can create, update, or delete them.
     * @path /tags/{tagId}
     * @allow (get, list) - Any user can read any tag.
     * @allow (create, update, delete) - Only admins can create, update, or delete tags.
     * @deny (create, update, delete) - Non-admin users cannot create, update, or delete tags.
     * @principle Enforces admin-only access for writes, allows public reads.
     */
    match /tags/{tagId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Manages access to notifications for a specific user. Only the user and admins can access these notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list) - User with ID 'user123' can read and list their own notifications at /users/user123/notifications.  Admins can also read/list.
     * @allow (create) - User with ID 'user123' can create a notification at /users/user123/notifications/notification456 if the userId matches.
     * @allow (update, delete) - User with ID 'user123' or an admin can update/delete a notification at /users/user123/notifications/notification456 if the userId matches.
     * @deny (get, list, create, update, delete) - User with ID 'user456' cannot read, list, create, update, or delete notifications for user 'user123'.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

        /**
         * @description Marks a user as an admin. The existence of a document at this path grants admin privileges. Authorization based on document existence rather than content.
         * @path /roles_admin/{uid}
         * @allow create: An admin can create a role admin document
         * @allow delete: An admin can delete a role admin document
         * @deny create: if the user isn't an admin they can't create a role admin document.
         * @deny delete: if the user isn't an admin they can't delete a role admin document.
         * @principle Enforces admin-only access for writes.
         */
    match /roles_admin/{uid} {
          allow get: if isAdmin();
          allow list: if false;
          allow create: if isAdmin();
          allow update: if false;
          allow delete: if isAdmin();
    }
  }
}