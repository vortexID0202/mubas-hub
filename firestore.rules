/**
 * @fileoverview Firestore Security Rules for MUBAS Community Hub
 *
 * Core Philosophy:
 * This ruleset implements a hybrid security model, balancing open access for content consumption with strict ownership and admin controls for data modification.
 *
 * Data Structure:
 * - User profiles are stored under `/users/{userId}` and are private to the user and admins.
 * - Questions and answers are stored under `/questions/{questionId}` and `/questions/{questionId}/answers/{answerId}` respectively. They are publicly readable but writable only by the author and admins.
 * - Knowledge base articles and live updates are stored under `/knowledge_base_articles/{articleId}` and `/live_updates/{updateId}` respectively. They are publicly readable, but only admins can manage them.
 * - Notifications are stored under `/users/{userId}/notifications/{notificationId}` and are private to the user and admins.
 * - Logs and API keys are stored under `/logs/{logId}` and `/api_keys/{apiKeyId}` respectively, and are only accessible to admins.
 * - Tags are stored under `/tags/{tagId}` and are publicly readable, but only admins can manage them.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect user privacy.
 * - Data required for authorization (e.g., authorId) is denormalized directly onto documents to avoid costly `get()` calls in rules.
 * - Read access is generally open for content collections (questions, answers, knowledge base articles, live updates, and tags) to encourage community engagement.
 * - Write access is restricted to owners or admins for most collections.
 * - Timestamps and non-critical data types are not validated for rapid prototyping.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profiles, allowing only the owner and admins to read and write.
     * @path /users/{userId}
     * @allow (create) - User with ID 'user123' can create their own profile.
     *    Request: { "auth": { "uid": "user123" }, "resource.data.id": "user123" }
     * @allow (get, update, delete) - Admin can read, update, and delete any user profile.
     *    Request: { "auth": { "uid": "admin123", "token": { "admin": true } } }
     * @deny (create) - User with ID 'user456' cannot create a profile with ID 'user123'.
     *    Request: { "auth": { "uid": "user456" }, "resource.data.id": "user123" }
     * @deny (get, update, delete) - User with ID 'user456' cannot read, update, or delete the profile of user with ID 'user123'.
     *    Request: { "auth": { "uid": "user456" }, "resource.data.id": "user123" }
     * @principle Enforces document ownership and admin override for user data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) || isAdmin() && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Manages community forum questions, allowing anyone to read, but only the author or admins to create, update, or delete.
     * @path /questions/{questionId}
     * @allow (get, list) - Any user can read and list questions.
     *    Request: { "auth": { "uid": "user123" } }
     * @allow (create) - User with ID 'user123' can create a question with 'authorId' set to 'user123'.
     *    Request: { "auth": { "uid": "user123" }, "resource.data.authorId": "user123" }
     * @allow (update, delete) - Admin can update and delete any question.
     *    Request: { "auth": { "uid": "admin123", "token": { "admin": true } } }
     * @deny (create) - User with ID 'user123' cannot create a question with 'authorId' set to 'user456'.
     *    Request: { "auth": { "uid": "user123" }, "resource.data.authorId": "user456" }
     * @deny (update, delete) - User with ID 'user456' cannot update or delete the question created by user with ID 'user123'.
     *    Request: { "auth": { "uid": "user456" }, "resource.data.authorId": "user123" }
     * @principle Allows public read access with owner-only writes, enforced via the 'authorId' field.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Manages answers to questions, allowing anyone to read, but only the author or admins to create, update, or delete.
     * @path /questions/{questionId}/answers/{answerId}
     * @allow (get, list) - Any user can read and list answers to a question.
     *    Request: { "auth": { "uid": "user123" } }
     * @allow (create) - User with ID 'user123' can create an answer with 'authorId' set to 'user123'.
     *    Request: { "auth": { "uid": "user123" }, "resource.data.authorId": "user123", "resource.data.questionId": "{questionId}" }
     * @allow (update, delete) - Admin can update and delete any answer.
     *    Request: { "auth": { "uid": "admin123", "token": { "admin": true } } }
     * @deny (create) - User with ID 'user123' cannot create an answer with 'authorId' set to 'user456'.
     *    Request: { "auth": { "uid": "user123" }, "resource.data.authorId": "user456" }
     * @deny (update, delete) - User with ID 'user456' cannot update or delete the answer created by user with ID 'user123'.
     *    Request: { "auth": { "uid": "user456" }, "resource.data.authorId": "user123" }
     * @principle Allows public read access with owner-only writes, enforced via the 'authorId' field.
     */
    match /questions/{questionId}/answers/{answerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.questionId == questionId;
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();
    }

    /**
     * @description Manages knowledge base articles, allowing anyone to read, but only admins to create, update, or delete.
     * @path /knowledge_base_articles/{articleId}
     * @allow (get, list) - Any user can read and list knowledge base articles.
     *    Request: { "auth": { "uid": "user123" } }
     * @allow (create, update, delete) - Admin can create, update, and delete any knowledge base article.
     *    Request: { "auth": { "uid": "admin123", "token": { "admin": true } } }
     * @deny (create, update, delete) - User with ID 'user123' cannot create, update, or delete knowledge base articles.
     *    Request: { "auth": { "uid": "user123" } }
     * @principle Restricts write access to admins for knowledge base management.
     */
    match /knowledge_base_articles/{articleId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Manages live updates, allowing anyone to read, but only admins to create, update, or delete.
     * @path /live_updates/{updateId}
     * @allow (get, list) - Any user can read and list live updates.
     *    Request: { "auth": { "uid": "user123" } }
     * @allow (create, update, delete) - Admin can create, update, and delete any live update.
     *    Request: { "auth": { "uid": "admin123", "token": { "admin": true } } }
     * @deny (create, update, delete) - User with ID 'user123' cannot create, update, or delete live updates.
     *    Request: { "auth": { "uid": "user123" } }
     * @principle Restricts write access to admins for managing live updates.
     */
    match /live_updates/{updateId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Manages tags, allowing anyone to read, but only admins to create, update, or delete.
     * @path /tags/{tagId}
     * @allow (get, list) - Any user can read and list tags.
     *    Request: { "auth": { "uid": "user123" } }
     * @allow (create, update, delete) - Admin can create, update, and delete any tag.
     *    Request: { "auth": { "uid": "admin123", "token": { "admin": true } } }
     * @deny (create, update, delete) - User with ID 'user123' cannot create, update, or delete tags.
     *    Request: { "auth": { "uid": "user123" } }
     * @principle Restricts write access to admins for tag management.
     */
    match /tags/{tagId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Protects user notifications, allowing only the owner and admins to read and write.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (create) - User with ID 'user123' can create a notification for themselves.
     *    Request: { "auth": { "uid": "user123" }, "resource.data.userId": "user123" }
     * @allow (get, list, update, delete) - Admin can read, list, update, and delete any user's notifications.
     *    Request: { "auth": { "uid": "admin123", "token": { "admin": true } } }
     * @deny (create) - User with ID 'user456' cannot create a notification for user with ID 'user123'.
     *    Request: { "auth": { "uid": "user456" }, "resource.data.userId": "user123" }
     * @deny (get, list, update, delete) - User with ID 'user456' cannot read, list, update, or delete the notifications of user with ID 'user123'.
     *    Request: { "auth": { "uid": "user456" }, "resource.data.userId": "user123" }
     * @principle Enforces document ownership and admin override for notification data.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Protects system logs, allowing only admins to read.
     * @path /logs/{logId}
     * @allow (get, list) - Admin can read and list system logs.
     *    Request: { "auth": { "uid": "admin123", "token": { "admin": true } } }
     * @deny (get, list, create, update, delete) - User with ID 'user123' cannot read, list, create, update, or delete system logs.
     *    Request: { "auth": { "uid": "user123" } }
     * @principle Restricts read and write access to admins for system log management.
     */
    match /logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Protects API keys, allowing only admins to manage them.
     * @path /api_keys/{apiKeyId}
     * @allow (create, get, list, update, delete) - Admin can create, read, list, update, and delete API keys.
     *    Request: { "auth": { "uid": "admin123", "token": { "admin": true } } }
     * @deny (create, get, list, update, delete) - User with ID 'user123' cannot create, read, list, update, or delete API keys.
     *    Request: { "auth": { "uid": "user123" } }
     * @principle Restricts all access to admins for API key management.
     */
    match /api_keys/{apiKeyId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isSignedIn() && isOwner(userId) && resource != null;
  }

  function isAdmin() {
    return isSignedIn() && request.auth.token.admin == true;
  }
}